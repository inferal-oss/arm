  "original_native_close_counterexample": {
    "disposition": "Defect reproduced by an expected-failure diagnostic harness; not acceptance.",
    "failed_root": "TestScreenResourceUnknownNativeCloseRetainsCharge",
    "log_sha256": "c3be725c1d61eb370195bec0a4989a291eb2ca0166073463233fa8ef577c87c5",
    "native_evidence": "The real source browser handler carried echoed application bytes through pinned TLS with an active .05CPU/8MiB allocation; returned Close error left its exact original accepted TCP descriptor open after workers joined, while original code settled its lease.",
    "public_ci": "https://github.com/inferal-oss/arm/actions/runs/40435632758",
    "source": "0c6de5f2d40ebc37ab98fb092e495e414bba4faf",
    "source_manifest_sha256": "7516650a3495925ca3c8a6b707032ae84ef0f94ef1000a224eb6b1ba333ef576",
    "verified_source_files": 1859
  },
  "public_successor": "https://github.com/inferal-oss/arm/actions/runs/40447122428",
  "resource_scope": "Cooperative .05 CPU / 8388608-byte memory allocation per ARM endpoint transport, backed by normal native admission and exact original join. These quantities are reservation policy, not measured usage or kernel enforcement. The separate relay protocol component tests use their existing controlled observer fixtures; actual screen transport tests use normal native observations.",
  "review_findings_and_corrections": [
    {
      "correction": "Original native sockets are recorded before TLS/upgrade ownership, serialized through close-once recording, and any unconfirmed first close is marked through the accepted exact-owner cleanup API before publishing joined.",
      "evidence": "An expected-failure real TCP/pinned TLS application-byte fixture reproduced the original premature settlement.",
      "finding": "A returned native socket Close error could be discarded by protocol adapters, allowing settlement after worker join while the original TCP descriptor remained open."
    },
    {
      "correction": "Abort the original NetConn exactly once; join TLS reads/writes without a second TLS Close.",
      "finding": "TLS viewer abort could repeat underlying native Close after the original close returned."
    },
    {
      "correction": "A fresh healthy sentinel and Manager mutex barrier witness the complete original owner snapshot; the original join stays open and exact single retained charge is asserted after joining the sentinel. Production Manager source is unchanged.",
      "finding": "The cleanup API regression did not causally synchronize Close snapshot completion before publishing original join."
    },
    {
      "correction": "Start normal Manager lifecycle once for each screen-owned fresh positive fixture; retain existing Close joins, bounded read-only readiness and the exact original native operation. No global mesh-fixture change, observation override, probe admission or operation retry.",
      "finding": "Positive screen test fixtures Opened Managers without starting the normal sampling lifecycle; polling Status reused initial cuts and could not recover CPU headroom or refresh memory."
    }
  ],
  "reviewed_source": {
    "accepted_base": "7430c867face6371b38c853807bfc36519de80b8",
    "author_binding": {

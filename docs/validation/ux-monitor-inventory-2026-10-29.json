  "prioritized_findings": [
    {
      "priority": 2,
      "area": "Disk/network device picker labels",
      "evidence": "Long public-contract-valid names overlap adjacent checkbox cells and clip at390px and doubled-token768px. Both pickers retain usable All/None controls, but complete labels do not fit their clipping ancestors.",
      "cause": "initMonitor uses a four-column128px-minimum native selector grid without Monitor-specific label wrapping/compact layout.",
      "proposed_allocation": [
        "main.mjs initMonitor(): mark only the noninteractive device-selector grids with a Monitor-specific class",
        "app.ttl: additive Monitor selector label/row containment and compact column layout; preserve native Checkbox types/labels/callbacks/IDs and focus"
      ]
    },
    {
      "priority": 2,
      "area": "Monitor technical-help reading width",
      "evidence": "At390px, memory technical values have38.734375px and filesystem values33.859375px; at actual doubled tokens in768px, they have16.78125px and8.234375px. Actual modal panels stay within the viewport and native Close/Escape remain reachable.",
      "cause": "The non-resource help branch uses the stock480px dialog and max-content description labels, which squeeze values.",
      "proposed_allocation": [
        "main.mjs help(): only the explicit Monitor kinds cpu/memory/filesystem/disk_io/network/gpu get noninteractive MonitorHelpBody/MonitorHelpFacts hooks",
        "app.ttl: distinct Monitor help body/facts reading-width and label/value styles; preserve metricHelp/get-current-context/copy/accounting and native controls/disposal"
      ]
    },
    {
      "priority": 2,
      "area": "Monitor help tooltips cross viewport edges",
      "evidence": "All six centered help tooltips cross the390px right edge under both keyboard focus and centered hover; Network reaches421.21875px. Right-column desktop and doubled-token tooltips also cross their viewport. Native border and painted text are measured, not document width alone.",
      "cause": "The stock centered max-content tooltip is placed on an inline-end Monitor action.",
      "proposed_allocation": [
        "main.mjs initMonitor(): mark only the existing noninteractive monitorCards root with a Monitor-specific surface hook",
        "app.ttl: additive Monitor-surface native help IconButton tooltip alignment/viewport rules; no global tooltip, Resource class promotion or interactive marker"
      ]
    }
  ],

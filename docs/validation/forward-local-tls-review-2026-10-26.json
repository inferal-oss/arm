  "review_findings_and_fixes": [
    {
      "finding": "Helper-only TLS clients were incompatible with the raw source listener.",
      "fix": "Added a minimal source TLS snapshot and compatible-serve hook before lease acquisition, preserving original lifetime and failure classification."
    },
    {
      "finding": "Early-cancelled standalone admission must close its owned transport.",
      "fix": "Retained explicit early/final cancellation closes from the candidate. The existing outer dial failure defer already protected the production caller before this helper-boundary change; no prior production leak is claimed."
    },

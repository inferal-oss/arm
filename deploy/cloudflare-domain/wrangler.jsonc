{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "arm-site-alias",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "getarm.cloud", "custom_domain": true }
  ],
  "observability": { "enabled": false }
}

@prefix ext: <https://semblance.dev/ns/foreign#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix arm: <https://arm.local/ui#> .
@prefix sem: <https://semblance.dev/ns/core#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix pos: <https://semblance.dev/ns/position#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix beh: <https://semblance.dev/ns/behaviour#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# All visible components are stock Semblance instances. ARM's only interaction
# mixin records an effect request; the host performs the authorized backend IO.
arm:prefixes sh:declare [ sh:prefix "arm" ; sh:namespace "https://arm.local/ui#"^^xsd:anyURI ] .
# The runtime snapshots the class hierarchy before any host effects run.
# Private widgets therefore declare their stock foreign adapter up front.
arm:Island a owl:Class ; rdfs:subClassOf ext:Island ;
  sem:slug "arm-island" ; ext:adapter ext:Widget .
arm:Effect a owl:Class .
arm:Activate a beh:Reaction ; beh:when beh:Click ; beh:sourceClass arm:Effect ;
  beh:inserts """CONSTRUCT { $this arm:requested $event } WHERE {}""" .
arm:Focus a beh:Reaction ; beh:when beh:Focus ; beh:sourceClass arm:Effect ;
  beh:inserts """CONSTRUCT { $this arm:focused $event } WHERE {}""" .

arm:shell a c:Stack ; sty:theme sty:Semblance ; sty:colorScheme sty:Dark ;
  pos:direction pos:Column ; pos:gap tok:space-4 ; pos:inset tok:space-4 ;
  c:children ( arm:header arm:statusline arm:heading arm:notice arm:content arm:desktop arm:footer ) .
arm:header a c:AppBar ; c:label "ARM" ; c:byline arm:host ; c:logo arm:logo ;
  c:actions ( arm:navigation ) ; c:moreActions ( arm:theme arm:scheme ) ; c:moreLabel "Actions and display" .
arm:logo a c:Emblem ; c:label "ARM Carve" ; c:decorative true ; c:viewBox "8 8 80 80" ;
 c:pathData "M28 16H46V50H80V68Q80 80 68 80H28Q16 80 16 68V28Q16 16 28 16Z M63 16H75Q80 16 80 21V33Q80 38 75 38H63Q58 38 58 33V21Q58 16 63 16Z" .
arm:statusline a c:Toolbar ; c:label "Backend status" ; c:children ( arm:connection ) .
arm:scheme a c:ThemeSwitcher ; c:label "Color scheme" ; c:controls arm:shell ; c:property sty:colorScheme .
arm:brand a c:Heading ; c:level 1 ; c:label "ARM / Agent Resource Manager" .
arm:connection a c:Badge ; c:label "Connecting" .
arm:host a c:Text ; c:label "Local operator session" .
arm:theme a c:Choice ; c:label "Theme" ; c:controls arm:shell ; c:property sty:theme .
arm:shell arm:view arm:monitor .
arm:navigation a c:Segmented ; c:label "Views" ; c:controls arm:shell ; c:property arm:view ; c:compactAs c:Picker ;
 c:options ( arm:monitor arm:resources arm:leases arm:messages arm:activityView arm:hostView arm:mesh arm:screen arm:runs ) .
arm:heading a c:Heading ; c:level 2 ; c:label "Host monitor" .
arm:notice a c:Alert ; c:label "Waiting for backend" ; c:hidden true .
arm:content a c:Switch ; c:controls arm:shell ; c:property arm:view ;
 c:cases ( arm:monitorCase arm:resourcesCase arm:leasesCase arm:messagesCase arm:activityCase arm:hostCase arm:meshCase arm:screenCase arm:runsCase ) .
arm:activity a c:AccordionItem ; c:label "Live activity" ; c:expanded false ; c:content arm:liveActivityContent .
arm:liveActivityContent a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-2 .
arm:desktop a c:Stack ; pos:direction pos:Column .

@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
arm:monitor rdfs:label "Monitor" .
arm:monitorCase c:when arm:monitor ; c:content arm:monitorContent .
arm:monitorContent a c:Stack ; sty:density sty:Compact ; pos:direction pos:Column ; pos:gap tok:space-2 .
arm:resources rdfs:label "Resources" .
arm:resourcesCase c:when arm:resources ; c:content arm:resourcesContent .
arm:resourcesContent a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 .
arm:leases rdfs:label "Leases" .
arm:leasesCase c:when arm:leases ; c:content arm:leasesContent .
arm:leasesContent a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 .
arm:messages rdfs:label "Messages" .
arm:messagesCase c:when arm:messages ; c:content arm:messagesContent .
arm:messagesContent a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 .
arm:activityView rdfs:label "Activity" .
arm:activityCase c:when arm:activityView ; c:content arm:activityContent .
arm:activityContent a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 .
arm:hostView rdfs:label "Host" .
arm:hostCase c:when arm:hostView ; c:content arm:hostContent .
arm:hostContent a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 .
arm:mesh rdfs:label "Mesh" .
arm:meshCase c:when arm:mesh ; c:content arm:meshContent .
arm:meshContent a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 .
arm:screen rdfs:label "Screen" .
arm:screenCase c:when arm:screen ; c:content arm:screenContent .
arm:screenContent a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 .

# Application announcements decorate stock output; no local component renderer.
arm:Announcer a sem:Rendering ; sem:targets sem:Component ; sem:stratum 10 ;
 sem:requires arm:role ; sem:watches arm:role .
arm:Announcer-sparql a sem:Rule ; sem:implements arm:Announcer ; sem:construct """
CONSTRUCT {
 ?root rdfhtml:attribute ?role .
 ?role a rdfhtml:Attribute ; rdfhtml:attributeName "role" ; rdfhtml:attributeValue ?name .
}
WHERE {
 $this arm:role ?name .
 BIND(IRI(CONCAT(STR($this), "/~root")) AS ?root)
 BIND(IRI(CONCAT(STR($this), "/~arm-role")) AS ?role)
}""" .

# Programmatic destinations (e.g. a text-only message selected in the palette)
# can receive keyboard focus without adding another stop to normal Tab order.
arm:FocusTarget a sem:Rendering ; sem:targets sem:Component ; sem:stratum 10 ;
 sem:requires arm:focusable ; sem:watches arm:focusable .
arm:FocusTarget-sparql a sem:Rule ; sem:implements arm:FocusTarget ;
 sem:construct """CONSTRUCT { ?root rdfhtml:tabIndex "-1" }
WHERE { $this arm:focusable true . BIND(IRI(CONCAT(STR($this), "/~root")) AS ?root) }""" .

# Stock StatusBar supplies the full-viewport shell layout and sticky footer.
arm:footer a c:StatusBar ; c:label "ARM" ; c:children ( arm:sessionScope ) .
arm:sessionScope a c:Text ; c:label "Local operator session" .
# Host-page reset only; components and theme styling are entirely stock.
[] a sty:StyleRule ; sty:part "body" ; sty:declares [ sty:property "margin" ; sty:raw "0" ] .

arm:runs rdfs:label "Runs" .
arm:runsCase c:when arm:runs ; c:content arm:runsContent .
arm:runsContent a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 .

# The run transcript uses stock Code rendering in a bounded scrolling surface.
arm:RunOutput a owl:Class ; rdfs:subClassOf c:Code ; sem:slug "arm-run-output" .
[] a sty:StyleRule ; sty:appliesTo arm:RunOutput ;
 sty:declares [ sty:property "max-height" ; sty:raw "55vh" ] ,
              [ sty:property "overflow-y" ; sty:raw "auto" ] .

# The stock Fullscreen layer owns presentation and Escape; ARM supplies only
# its transcript component and viewport-relative height for stock Code.
arm:RunTranscript a owl:Class ; rdfs:subClassOf c:Stack ; sem:slug "arm-run-transcript" .
arm:RunOutputFull a owl:Class ; rdfs:subClassOf arm:RunOutput ; sem:slug "arm-run-output-full" .
[] a sty:StyleRule ; sty:appliesTo arm:RunOutputFull ;
 sty:declares [ sty:property "max-height" ; sty:raw "calc(100dvh - 14rem)" ] .

# Runs use a quiet reading column and aligned stock components rather than
# full-width cards. The compact breakpoint stacks metadata beneath the command.
arm:RunSurface a owl:Class ; rdfs:subClassOf c:Stack ; sem:slug "arm-run-surface" .
arm:RunListRow a owl:Class ; rdfs:subClassOf c:Stack ; sem:slug "arm-run-list-row" .
arm:RunPrimary a owl:Class ; rdfs:subClassOf c:Stack ; sem:slug "arm-run-primary" .
arm:RunRowMeta a owl:Class ; rdfs:subClassOf c:Stack ; sem:slug "arm-run-row-meta" .
arm:RunListCommand a owl:Class ; rdfs:subClassOf c:Code ; sem:slug "arm-run-list-command" .
arm:RunDetailCommand a owl:Class ; rdfs:subClassOf c:Code ; sem:slug "arm-run-detail-command" .
arm:RunSecondary a owl:Class ; rdfs:subClassOf c:Text ; sem:slug "arm-run-secondary" .
[] a sty:StyleRule ; sty:appliesTo arm:RunSurface ;
 sty:declares [ sty:property "width" ; sty:raw "100%" ] ,
              [ sty:property "max-width" ; sty:raw "72rem" ] ,
              [ sty:property "min-width" ; sty:raw "0" ] ,
              [ sty:property "margin-inline" ; sty:raw "auto" ] ,
              [ sty:property "box-sizing" ; sty:raw "border-box" ] .
[] a sty:StyleRule ; sty:appliesTo arm:RunListRow ;
 sty:declares [ sty:property "display" ; sty:raw "grid" ] ,
              [ sty:property "grid-template-columns" ; sty:raw "minmax(0, 1fr) minmax(10rem, 16rem)" ] ,
              [ sty:property "align-items" ; sty:raw "center" ] ,
              [ sty:property "gap" ; sty:raw "1.25rem" ] ,
              [ sty:property "padding-block" ; sty:raw "0.75rem" ] ,
              [ sty:property "border-bottom" ; sty:raw "1px solid var(--sem-border)" ] ,
              [ sty:property "min-width" ; sty:raw "0" ] .
[] a sty:StyleRule ; sty:appliesTo arm:RunPrimary ;
 sty:declares [ sty:property "min-width" ; sty:raw "0" ] ,
              [ sty:property "gap" ; sty:raw "0.25rem" ] .
[] a sty:StyleRule ; sty:appliesTo arm:RunRowMeta ;
 sty:declares [ sty:property "display" ; sty:raw "flex" ] ,
              [ sty:property "flex-wrap" ; sty:raw "wrap" ] ,
              [ sty:property "justify-content" ; sty:raw "flex-end" ] ,
              [ sty:property "align-items" ; sty:raw "center" ] ,
              [ sty:property "gap" ; sty:raw "0.35rem 0.6rem" ] ,
              [ sty:property "min-width" ; sty:raw "0" ] .
[] a sty:StyleRule ; sty:appliesTo arm:RunPrimary ; sty:part "> button" ;
 sty:declares [ sty:property "justify-content" ; sty:raw "flex-start" ] ,
              [ sty:property "text-align" ; sty:raw "left" ] ,
              [ sty:property "font-weight" ; sty:raw "650" ] ,
              [ sty:property "padding" ; sty:raw "0" ] ,
              [ sty:property "min-height" ; sty:raw "1.75rem" ] ,
              [ sty:property "max-width" ; sty:raw "100%" ] ,
              [ sty:property "white-space" ; sty:raw "normal" ] ,
              [ sty:property "overflow-wrap" ; sty:raw "anywhere" ] .
[] a sty:StyleRule ; sty:appliesTo arm:RunListCommand ;
 sty:declares [ sty:property "display" ; sty:raw "block" ] ,
              [ sty:property "background" ; sty:raw "none" ] ,
              [ sty:property "border" ; sty:raw "0" ] ,
              [ sty:property "padding" ; sty:raw "0" ] ,
              [ sty:property "font-size" ; sty:raw "0.875rem" ] ,
              [ sty:property "color" ; sty:token tok:muted ] ,
              [ sty:property "white-space" ; sty:raw "nowrap" ] ,
              [ sty:property "text-overflow" ; sty:raw "ellipsis" ] ,
              [ sty:property "overflow" ; sty:raw "hidden" ] ,
              [ sty:property "max-width" ; sty:raw "100%" ] ,
              [ sty:property "min-width" ; sty:raw "0" ] .
[] a sty:StyleRule ; sty:appliesTo arm:RunDetailCommand ;
 sty:declares [ sty:property "white-space" ; sty:raw "normal" ] ,
              [ sty:property "overflow-wrap" ; sty:raw "anywhere" ] .
[] a sty:StyleRule ; sty:appliesTo arm:RunSecondary ;
 sty:declares [ sty:property "font-size" ; sty:raw "0.875rem" ] ,
              [ sty:property "color" ; sty:token tok:muted ] ,
              [ sty:property "overflow-wrap" ; sty:raw "anywhere" ] .
[] a sty:StyleRule ; sty:appliesTo arm:RunListRow ; sty:atWidth sty:CompactWidth ;
 sty:declares [ sty:property "grid-template-columns" ; sty:raw "minmax(0, 1fr)" ] ,
              [ sty:property "gap" ; sty:raw "0.4rem" ] .
[] a sty:StyleRule ; sty:appliesTo arm:RunRowMeta ; sty:atWidth sty:CompactWidth ;
 sty:declares [ sty:property "justify-content" ; sty:raw "flex-start" ] .
arm:RunTechnical a owl:Class ; rdfs:subClassOf c:Text ; sem:slug "arm-run-technical" .
[] a sty:StyleRule ; sty:appliesTo arm:RunTechnical ;
 sty:declares [ sty:property "overflow-wrap" ; sty:raw "anywhere" ] .

[] a sty:StyleRule ; sty:appliesTo arm:RunSurface ; sty:part "[role=list] > h3" ;
 sty:declares [ sty:property "font-size" ; sty:raw "0.875rem" ] ,
              [ sty:property "line-height" ; sty:raw "1.4" ] ,
              [ sty:property "font-weight" ; sty:raw "650" ] ,
              [ sty:property "text-transform" ; sty:raw "uppercase" ] ,
              [ sty:property "letter-spacing" ; sty:raw "0.04em" ] ,
              [ sty:property "color" ; sty:token tok:muted ] ,
              [ sty:property "margin-block" ; sty:raw "0.6rem 0.2rem" ] .


# A detached log keeps controls fixed and gives its saved-output disclosure the
# remaining frame height. Only the transcript scrolls, so following shows its tail.
arm:RunTranscriptWindow a owl:Class ; rdfs:subClassOf arm:RunTranscript ; sem:slug "arm-run-transcript-window" .
[] a sty:StyleRule ; sty:appliesTo arm:RunTranscriptWindow ; sty:state ":not([data-sem-fullscreen])" ;
 sty:declares [ sty:property "height" ; sty:raw "100%" ] , [ sty:property "min-height" ; sty:raw "0" ] , [ sty:property "overflow" ; sty:raw "hidden" ] .
[] a sty:StyleRule ; sty:appliesTo arm:RunTranscript ; sty:state ":is([data-sem-fullscreen],[data-sem-c=\"arm-run-transcript-window\"])" ; sty:part "> :not([data-sem-c=\"accordion-item\"])" ;
 sty:declares [ sty:property "flex-shrink" ; sty:raw "0" ] .
[] a sty:StyleRule ; sty:appliesTo arm:RunTranscript ; sty:state ":is([data-sem-fullscreen],[data-sem-c=\"arm-run-transcript-window\"])" ; sty:part "> [data-sem-c=\"accordion-item\"][data-expanded=\"true\"]" ;
 sty:declares [ sty:property "display" ; sty:raw "flex" ] , [ sty:property "flex-direction" ; sty:raw "column" ] , [ sty:property "flex" ; sty:raw "1" ] , [ sty:property "min-height" ; sty:raw "0" ] , [ sty:property "overflow" ; sty:raw "hidden" ] .
[] a sty:StyleRule ; sty:appliesTo arm:RunTranscript ; sty:state ":is([data-sem-fullscreen],[data-sem-c=\"arm-run-transcript-window\"])" ; sty:part "> [data-sem-c=\"accordion-item\"][data-expanded=\"true\"] > .sem-panel" ;
 sty:declares [ sty:property "display" ; sty:raw "flex" ] , [ sty:property "flex" ; sty:raw "1" ] , [ sty:property "min-height" ; sty:raw "0" ] .
[] a sty:StyleRule ; sty:appliesTo arm:RunTranscript ; sty:state ":is([data-sem-fullscreen],[data-sem-c=\"arm-run-transcript-window\"])" ; sty:part "> [data-sem-c=\"accordion-item\"] .sem-panel-clip" ;
 sty:declares [ sty:property "display" ; sty:raw "flex" ] , [ sty:property "flex" ; sty:raw "1" ] , [ sty:property "min-height" ; sty:raw "0" ] .
[] a sty:StyleRule ; sty:appliesTo arm:RunTranscript ; sty:state ":is([data-sem-fullscreen],[data-sem-c=\"arm-run-transcript-window\"])" ; sty:part "> [data-sem-c=\"accordion-item\"] .sem-panel-body" ;
 sty:declares [ sty:property "display" ; sty:raw "flex" ] , [ sty:property "flex" ; sty:raw "1" ] , [ sty:property "min-height" ; sty:raw "0" ] .
[] a sty:StyleRule ; sty:appliesTo arm:RunTranscript ; sty:state ":is([data-sem-fullscreen],[data-sem-c=\"arm-run-transcript-window\"])" ; sty:part "> [data-sem-c=\"accordion-item\"] .sem-panel-body > [data-sem-c=\"stack\"]" ;
 sty:declares [ sty:property "flex" ; sty:raw "1" ] , [ sty:property "min-height" ; sty:raw "0" ] , [ sty:property "overflow" ; sty:raw "hidden" ] .
[] a sty:StyleRule ; sty:appliesTo arm:RunTranscript ; sty:state ":is([data-sem-fullscreen],[data-sem-c=\"arm-run-transcript-window\"])" ; sty:part "> [data-sem-c=\"accordion-item\"] .sem-panel-body > [data-sem-c=\"stack\"] > :not(pre)" ;
 sty:declares [ sty:property "flex-shrink" ; sty:raw "0" ] .
[] a sty:StyleRule ; sty:appliesTo arm:RunTranscript ; sty:state ":is([data-sem-fullscreen],[data-sem-c=\"arm-run-transcript-window\"])" ; sty:part "> [data-sem-c=\"accordion-item\"] pre" ;
 sty:declares [ sty:property "flex" ; sty:raw "1" ] , [ sty:property "min-height" ; sty:raw "0" ] , [ sty:property "max-height" ; sty:raw "none" ] .


arm:RunContext a owl:Class ; rdfs:subClassOf c:Stack ; sem:slug "arm-run-context" .
[] a sty:StyleRule ; sty:appliesTo arm:RunContext ;
 sty:declares [ sty:property "min-width" ; sty:raw "0" ] ,
              [ sty:property "font-size" ; sty:raw "0.875rem" ] .
[] a sty:StyleRule ; sty:appliesTo arm:RunContext ; sty:part "dd,pre" ;
 sty:declares [ sty:property "min-width" ; sty:raw "0" ] ,
              [ sty:property "white-space" ; sty:raw "pre-wrap" ] ,
              [ sty:property "overflow-wrap" ; sty:raw "anywhere" ] .
[] a sty:StyleRule ; sty:appliesTo arm:RunContext ; sty:part "h3,h4" ;
 sty:declares [ sty:property "font-size" ; sty:raw "0.875rem" ] ,
              [ sty:property "margin-block" ; sty:raw "0.25rem" ] .

[] a sty:StyleRule ; sty:appliesTo arm:RunTranscript ; sty:state ":is([data-sem-fullscreen],[data-sem-c=\"arm-run-transcript-window\"])" ; sty:part "[data-sem-c=\"arm-run-context\"]" ;
 sty:declares [ sty:property "max-height" ; sty:raw "min(28vh, 12rem)" ] ,
              [ sty:property "overflow" ; sty:raw "auto" ] .


arm:LeaseSummary a owl:Class ; rdfs:subClassOf c:Stack ; sem:slug "arm-lease-summary" .
arm:LeaseSection a owl:Class ; rdfs:subClassOf c:Stack ; sem:slug "arm-lease-section" .
[] a sty:StyleRule ; sty:appliesTo arm:LeaseSummary ;
 sty:declares [ sty:property "min-width" ; sty:raw "0" ] ,
              [ sty:property "gap" ; sty:raw "0.75rem" ] .
[] a sty:StyleRule ; sty:appliesTo arm:LeaseSummary ; sty:part "h3" ;
 sty:declares [ sty:property "font-size" ; sty:raw "1.125rem" ] ,
              [ sty:property "line-height" ; sty:raw "1.4" ] ,
              [ sty:property "overflow-wrap" ; sty:raw "anywhere" ] .
[] a sty:StyleRule ; sty:appliesTo arm:LeaseSection ;
 sty:declares [ sty:property "min-width" ; sty:raw "0" ] ,
              [ sty:property "gap" ; sty:raw "0.5rem" ] ,
              [ sty:property "padding-top" ; sty:raw "0.75rem" ] ,
              [ sty:property "border-top" ; sty:raw "1px solid var(--sem-border)" ] .
[] a sty:StyleRule ; sty:appliesTo arm:LeaseSection ; sty:part "h3,h4" ;
 sty:declares [ sty:property "font-size" ; sty:raw "1rem" ] ,
              [ sty:property "margin-block" ; sty:raw "0.25rem" ] .
[] a sty:StyleRule ; sty:appliesTo arm:LeaseSection ; sty:part "[role=toolbar]" ;
 sty:declares [ sty:property "flex-wrap" ; sty:raw "wrap" ] ,
              [ sty:property "gap" ; sty:raw "0.5rem" ] .
[] a sty:StyleRule ; sty:appliesTo arm:LeaseSummary ; sty:part "dd" ;
 sty:declares [ sty:property "min-width" ; sty:raw "0" ] ,
              [ sty:property "overflow-wrap" ; sty:raw "anywhere" ] .

[] a sty:StyleRule ; sty:appliesTo arm:RunTranscript ; sty:state ":is([data-sem-fullscreen],[data-sem-c=\"arm-run-transcript-window\"])" ;
 sty:declares [ sty:property "gap" ; sty:raw "0.25rem" ] .
[] a sty:StyleRule ; sty:appliesTo arm:RunTranscript ; sty:state ":is([data-sem-fullscreen],[data-sem-c=\"arm-run-transcript-window\"])" ; sty:part "> [data-sem-c=\"arm-run-context\"]:not([hidden])" ;
 sty:declares [ sty:property "flex" ; sty:raw "0 1 auto" ] ,
              [ sty:property "min-height" ; sty:raw "2.5rem" ] .
[] a sty:StyleRule ; sty:appliesTo arm:RunTranscript ; sty:state ":is([data-sem-fullscreen],[data-sem-c=\"arm-run-transcript-window\"])" ; sty:part "> [data-sem-c=\"accordion-item\"][data-expanded=\"true\"]:not([hidden])" ;
 sty:declares [ sty:property "min-height" ; sty:raw "10rem" ] .
[] a sty:StyleRule ; sty:appliesTo arm:RunTranscript ; sty:state ":is([data-sem-fullscreen],[data-sem-c=\"arm-run-transcript-window\"])" ; sty:part "> [data-sem-c=\"accordion-item\"] .sem-panel-body" ;
 sty:declares [ sty:property "padding" ; sty:raw "0.5rem" ] .
[] a sty:StyleRule ; sty:appliesTo arm:RunTranscript ; sty:state ":is([data-sem-fullscreen],[data-sem-c=\"arm-run-transcript-window\"])" ; sty:part "> [data-sem-c=\"accordion-item\"] .sem-panel-body > [data-sem-c=\"stack\"]" ;
 sty:declares [ sty:property "gap" ; sty:raw "0.25rem" ] .
[] a sty:StyleRule ; sty:appliesTo arm:RunTranscript ; sty:state ":is([data-sem-fullscreen],[data-sem-c=\"arm-run-transcript-window\"])" ; sty:part "> [data-sem-c=\"accordion-item\"] pre" ;
 sty:declares [ sty:property "padding" ; sty:raw "0.5rem" ] .

arm:RunSummary a owl:Class ; rdfs:subClassOf c:Stack ; sem:slug "arm-run-summary" .
[] a sty:StyleRule ; sty:appliesTo arm:RunSummary ;
 sty:declares [ sty:property "flex-wrap" ; sty:raw "wrap" ] ,
              [ sty:property "align-items" ; sty:raw "center" ] ,
              [ sty:property "gap" ; sty:raw "0.5rem 0.75rem" ] ,
              [ sty:property "min-width" ; sty:raw "0" ] .
[] a sty:StyleRule ; sty:appliesTo arm:RunSummary ; sty:part "h3" ;
 sty:declares [ sty:property "font-size" ; sty:raw "1.25rem" ] ,
              [ sty:property "min-width" ; sty:raw "0" ] ,
              [ sty:property "overflow-wrap" ; sty:raw "anywhere" ] .


[] a sty:StyleRule ; sty:appliesTo arm:RunTranscript ; sty:part "[role=toolbar]" ;
 sty:declares [ sty:property "flex-wrap" ; sty:raw "wrap" ] ,
              [ sty:property "gap" ; sty:raw "0.375rem" ] .
[] a sty:StyleRule ; sty:appliesTo arm:RunTranscript ; sty:part "> h3" ;
 sty:declares [ sty:property "font-size" ; sty:raw "1.125rem" ] ,
              [ sty:property "line-height" ; sty:raw "1.4" ] ,
              [ sty:property "margin-block" ; sty:raw "0.25rem" ] .
[] a sty:StyleRule ; sty:appliesTo c:Window ; sty:state ":not([data-sem-tiled]):has([data-sem-c=\"arm-run-transcript-window\"]):not([hidden])" ;
 sty:declares [ sty:property "min-height" ; sty:raw "min(32rem, calc(100dvh - 3rem))" ] .

# Message prose preserves paragraphs through review, recovery and conversation.
# These application classes leave the stock dialog, shell and other views alone.
arm:MessageSurface a owl:Class ; rdfs:subClassOf c:Stack ; sem:slug "arm-message-surface" .
arm:MessageBody a owl:Class ; rdfs:subClassOf c:Text ; sem:slug "arm-message-body" .
arm:MessageFacts a owl:Class ; rdfs:subClassOf c:DescriptionList ; sem:slug "arm-message-facts" .
[] a sty:StyleRule ; sty:appliesTo arm:MessageSurface ;
 sty:declares [ sty:property "min-width" ; sty:raw "0" ] ,
              [ sty:property "overflow-wrap" ; sty:raw "anywhere" ] .
[] a sty:StyleRule ; sty:appliesTo arm:MessageBody ;
 sty:declares [ sty:property "display" ; sty:raw "block" ] ,
              [ sty:property "white-space" ; sty:raw "pre-wrap" ] ,
              [ sty:property "overflow-wrap" ; sty:raw "anywhere" ] ,
              [ sty:property "min-width" ; sty:raw "0" ] .
[] a sty:StyleRule ; sty:appliesTo arm:MessageFacts ; sty:atWidth sty:CompactWidth ;
 sty:declares [ sty:property "grid-template-columns" ; sty:raw "minmax(0, 1fr)" ] .
[] a sty:StyleRule ; sty:appliesTo arm:MessageFacts ; sty:atWidth sty:CompactWidth ; sty:part "> .sem-pair" ;
 sty:declares [ sty:property "row-gap" ; sty:token tok:space-1 ] .

arm:MessageLabel a owl:Class ; rdfs:subClassOf c:Text ; sem:slug "arm-message-label" .
[] a sty:StyleRule ; sty:appliesTo arm:MessageLabel ;
 sty:declares [ sty:property "font-weight" ; sty:raw "650" ] ,
              [ sty:property "font-size" ; sty:token tok:text-sm ] ,
              [ sty:property "color" ; sty:token tok:muted ] .

# Pool-specific body markers keep native Dialog types, close/focus behavior and
# other application dialogs intact. Footer actions remain outside body scrolling.
arm:PoolDialogBody a owl:Class ; rdfs:subClassOf c:Stack ; sem:slug "arm-pool-dialog-body" .
arm:PoolManagerBody a owl:Class ; rdfs:subClassOf arm:PoolDialogBody ; sem:slug "arm-pool-manager-body" .
arm:PoolEditorBody a owl:Class ; rdfs:subClassOf arm:PoolDialogBody ; sem:slug "arm-pool-editor-body" .
arm:PoolActions a owl:Class ; rdfs:subClassOf c:Stack ; sem:slug "arm-pool-actions" .
[] a sty:StyleRule ; sty:appliesTo arm:PoolDialogBody ;
 sty:declares [ sty:property "min-width" ; sty:raw "0" ] ,
              [ sty:property "max-width" ; sty:raw "100%" ] ,
              [ sty:property "overflow-wrap" ; sty:raw "anywhere" ] .
[] a sty:StyleRule ; sty:appliesTo arm:PoolDialogBody ; sty:part "[data-sem-c=\"stack\"]" ;
 sty:declares [ sty:property "min-width" ; sty:raw "0" ] .
[] a sty:StyleRule ; sty:appliesTo arm:PoolActions ;
 sty:declares [ sty:property "width" ; sty:raw "100%" ] ,
              [ sty:property "min-width" ; sty:raw "0" ] ,
              [ sty:property "flex-wrap" ; sty:raw "wrap" ] .
[] a sty:StyleRule ; sty:appliesTo arm:PoolActions ; sty:part "> button" ;
 sty:declares [ sty:property "max-width" ; sty:raw "100%" ] ,
              [ sty:property "white-space" ; sty:raw "normal" ] ,
              [ sty:property "overflow-wrap" ; sty:raw "anywhere" ] .
[] a sty:StyleRule ; sty:part "[data-sem-c=\"dialog\"]:has(> .sem-panel > .sem-body > :is([data-sem-c=\"arm-pool-manager-body\"],[data-sem-c=\"arm-pool-editor-body\"])) > .sem-panel" ;
 sty:declares [ sty:property "display" ; sty:raw "flex" ] ,
              [ sty:property "flex-direction" ; sty:raw "column" ] ,
              [ sty:property "min-width" ; sty:raw "0" ] ,
              [ sty:property "max-height" ; sty:raw "calc(100dvh - 3rem)" ] ,
              [ sty:property "overflow" ; sty:raw "hidden" ] ,
              [ sty:property "box-sizing" ; sty:raw "border-box" ]  .
[] a sty:StyleRule ; sty:part "[data-sem-c=\"dialog\"]:has(> .sem-panel > .sem-body > :is([data-sem-c=\"arm-pool-manager-body\"],[data-sem-c=\"arm-pool-editor-body\"])) > .sem-panel > .sem-body" ;
 sty:declares [ sty:property "min-width" ; sty:raw "0" ] ,
              [ sty:property "min-height" ; sty:raw "0" ] ,
              [ sty:property "overflow" ; sty:raw "auto" ] ,
              [ sty:property "flex" ; sty:raw "1 1 auto" ]  .
[] a sty:StyleRule ; sty:part "[data-sem-c=\"dialog\"]:has(> .sem-panel > .sem-body > :is([data-sem-c=\"arm-pool-manager-body\"],[data-sem-c=\"arm-pool-editor-body\"])) > .sem-panel > :is(.sem-head,.sem-actions)" ;
 sty:declares [ sty:property "flex" ; sty:raw "0 0 auto" ] ,
              [ sty:property "min-width" ; sty:raw "0" ]  .
[] a sty:StyleRule ; sty:part "[data-sem-c=\"dialog\"]:has(> .sem-panel > .sem-body > [data-sem-c=\"arm-pool-manager-body\"]) > .sem-panel" ;
 sty:declares [ sty:property "width" ; sty:raw "min(64rem, 100%)" ]  .
[] a sty:StyleRule ; sty:part "[data-sem-c=\"dialog\"]:has(> .sem-panel > .sem-body > [data-sem-c=\"arm-pool-editor-body\"]) > .sem-panel" ;
 sty:declares [ sty:property "width" ; sty:raw "min(52rem, 100%)" ]  .

# Exact counts get their full reading width; comparison fields remain paired.
arm:PoolComparison a owl:Class ; rdfs:subClassOf c:Grid ; sem:slug "arm-pool-comparison" .
arm:PoolFacts a owl:Class ; rdfs:subClassOf c:DescriptionList ; sem:slug "arm-pool-facts" .
arm:PoolBudget a owl:Class ; rdfs:subClassOf c:DescriptionList ; sem:slug "arm-pool-budget" .
[] a sty:StyleRule ; sty:appliesTo arm:PoolFacts ;
 sty:declares [ sty:property "grid-template-columns" ; sty:raw "minmax(0, 1fr)" ] .
[] a sty:StyleRule ; sty:appliesTo arm:PoolBudget ; sty:atWidth sty:CompactWidth ;
 sty:declares [ sty:property "grid-template-columns" ; sty:raw "minmax(0, 1fr)" ] .

[] a sty:StyleRule ; sty:appliesTo arm:PoolActions ; sty:part "> [role=\"alert\"]" ;
 sty:declares [ sty:property "flex-basis" ; sty:raw "100%" ] ,
              [ sty:property "min-width" ; sty:raw "0" ] .

# A short viewport cannot keep both a long warning/action footer and readable
# content fixed in place. Scroll the full native panel, retaining every control.
arm:PoolShortWindow a sty:WidthClass ; sty:media "(max-height: 40rem)" .
[] a sty:StyleRule ; sty:atWidth arm:PoolShortWindow ; sty:part "[data-sem-c=\"dialog\"]:has(> .sem-panel > .sem-body > :is([data-sem-c=\"arm-pool-manager-body\"],[data-sem-c=\"arm-pool-editor-body\"])) > .sem-panel" ;
 sty:declares [ sty:property "display" ; sty:raw "block" ],
              [ sty:property "overflow" ; sty:raw "auto" ] .
[] a sty:StyleRule ; sty:atWidth arm:PoolShortWindow ; sty:part "[data-sem-c=\"dialog\"]:has(> .sem-panel > .sem-body > :is([data-sem-c=\"arm-pool-manager-body\"],[data-sem-c=\"arm-pool-editor-body\"])) > .sem-panel > .sem-body" ;
 sty:declares [ sty:property "overflow" ; sty:raw "visible" ],
              [ sty:property "flex" ; sty:raw "none" ] .

# Resource details remain inside their own cards, including long consumer names.
arm:ResourceSurface a owl:Class ; rdfs:subClassOf c:Grid ; sem:slug "arm-resource-surface" .
arm:ResourceConsumer a owl:Class ; rdfs:subClassOf c:Stack ; sem:slug "arm-resource-consumer" .
arm:ResourceFacts a owl:Class ; rdfs:subClassOf c:DescriptionList ; sem:slug "arm-resource-facts" .
arm:ResourceIdentity a owl:Class ; rdfs:subClassOf c:Text ; sem:slug "arm-resource-identity" .
arm:ResourceReason a owl:Class ; rdfs:subClassOf c:Text ; sem:slug "arm-resource-reason" .
[] a sty:StyleRule ; sty:appliesTo arm:ResourceSurface ;
 sty:declares [ sty:property "min-width" ; sty:raw "0" ] ,
              [ sty:property "align-items" ; sty:raw "start" ] .
[] a sty:StyleRule ; sty:appliesTo arm:ResourceSurface ; sty:part "[data-sem-c=\"stack\"]" ;
 sty:declares [ sty:property "min-width" ; sty:raw "0" ] ,
              [ sty:property "max-width" ; sty:raw "100%" ] .
[] a sty:StyleRule ; sty:appliesTo arm:ResourceConsumer ;
 sty:declares [ sty:property "min-width" ; sty:raw "0" ] ,
              [ sty:property "max-width" ; sty:raw "100%" ] ,
              [ sty:property "padding-block" ; sty:token tok:space-3 ] ,
              [ sty:property "border-top" ; sty:raw "1px solid var(--sem-border)" ] .
[] a sty:StyleRule ; sty:appliesTo arm:ResourceConsumer ; sty:part "> button" ;
 sty:declares [ sty:property "min-width" ; sty:raw "0" ] ,
              [ sty:property "max-width" ; sty:raw "100%" ] ,
              [ sty:property "white-space" ; sty:raw "pre-wrap" ] ,
              [ sty:property "overflow-wrap" ; sty:raw "anywhere" ] ,
              [ sty:property "text-align" ; sty:raw "start" ] ,
              [ sty:property "justify-content" ; sty:raw "flex-start" ] .
[] a sty:StyleRule ; sty:appliesTo arm:ResourceFacts ;
 sty:declares [ sty:property "min-width" ; sty:raw "0" ] ,
              [ sty:property "grid-template-columns" ; sty:raw "minmax(0, 1fr)" ] .
[] a sty:StyleRule ; sty:appliesTo arm:ResourceIdentity ;
 sty:declares [ sty:property "overflow-wrap" ; sty:raw "anywhere" ] ,
              [ sty:property "font-size" ; sty:token tok:text-sm ] ,
              [ sty:property "color" ; sty:token tok:muted ] .
[] a sty:StyleRule ; sty:appliesTo arm:ResourceReason ;
 sty:declares [ sty:property "white-space" ; sty:raw "pre-wrap" ] ,
              [ sty:property "overflow-wrap" ; sty:raw "anywhere" ] .

# Keep the stock stat's flex basis from adding padding beyond a narrow card.
[] a sty:StyleRule ; sty:appliesTo arm:ResourceSurface ; sty:part "[data-sem-c=\"stat\"]" ;
 sty:declares [ sty:property "box-sizing" ; sty:raw "border-box" ] ,
              [ sty:property "min-width" ; sty:raw "0" ] ,
              [ sty:property "max-width" ; sty:raw "100%" ] .

arm:ResourceDesktopReading a sty:WidthClass ; sty:media "(min-width: 1100px)" .
# Only the direct accounting disclosure expands a resource card. Retained open
# consumer subdisclosures must not keep a collapsed summary spanning the grid.
[] a sty:StyleRule ; sty:appliesTo arm:ResourceSurface ; sty:part "> [data-sem-c=\"card\"]:has(> .sem-card-body > [data-sem-c=\"stack\"] > [data-sem-c=\"accordion-item\"][data-expanded=\"true\"])" ;
 sty:declares [ sty:property "grid-column" ; sty:raw "1 / -1" ] .
[] a sty:StyleRule ; sty:appliesTo arm:ResourceSurface ; sty:part "> [data-sem-c=\"card\"]:has(> .sem-card-body > [data-sem-c=\"stack\"] > [data-sem-c=\"accordion-item\"][data-expanded=\"true\"]) > .sem-card-body > [data-sem-c=\"stack\"]" ;
 sty:declares [ sty:property "width" ; sty:raw "100%" ],
              [ sty:property "max-width" ; sty:raw "64rem" ],
              [ sty:property "margin-inline" ; sty:raw "auto" ],
              [ sty:property "box-sizing" ; sty:raw "border-box" ] .
[] a sty:StyleRule ; sty:appliesTo arm:ResourceSurface ; sty:atWidth sty:RegularWidth ; sty:part "> [data-sem-c=\"card\"]:has(> .sem-card-body > [data-sem-c=\"stack\"] > [data-sem-c=\"accordion-item\"][data-expanded=\"true\"]) [data-sem-c=\"arm-resource-facts\"]" ;
 sty:declares [ sty:property "grid-template-columns" ; sty:raw "minmax(7rem, max-content) minmax(0, 1fr)" ] .
[] a sty:StyleRule ; sty:appliesTo arm:ResourceSurface ; sty:atWidth arm:ResourceDesktopReading ; sty:part "> [data-sem-c=\"card\"]:has(> .sem-card-body > [data-sem-c=\"stack\"] > [data-sem-c=\"accordion-item\"][data-expanded=\"true\"]) [data-sem-c=\"arm-resource-consumer\"]" ;
 sty:declares [ sty:property "display" ; sty:raw "grid" ],
              [ sty:property "grid-template-columns" ; sty:raw "minmax(0, 1fr) minmax(0, 1fr)" ],
              [ sty:property "column-gap" ; sty:raw "1.5rem" ] .
[] a sty:StyleRule ; sty:appliesTo arm:ResourceSurface ; sty:atWidth arm:ResourceDesktopReading ; sty:part "> [data-sem-c=\"card\"]:has(> .sem-card-body > [data-sem-c=\"stack\"] > [data-sem-c=\"accordion-item\"][data-expanded=\"true\"]) [data-sem-c=\"arm-resource-consumer\"] > :is(:first-child,[data-sem-c=\"arm-resource-identity\"],[data-sem-c=\"arm-resource-reason\"])" ;
 sty:declares [ sty:property "grid-column" ; sty:raw "1" ] .
[] a sty:StyleRule ; sty:appliesTo arm:ResourceSurface ; sty:atWidth arm:ResourceDesktopReading ; sty:part "> [data-sem-c=\"card\"]:has(> .sem-card-body > [data-sem-c=\"stack\"] > [data-sem-c=\"accordion-item\"][data-expanded=\"true\"]) [data-sem-c=\"arm-resource-consumer\"] > [data-sem-c=\"arm-resource-facts\"]" ;
 sty:declares [ sty:property "grid-column" ; sty:raw "2" ],
              [ sty:property "grid-row" ; sty:raw "1 / span 3" ],
              [ sty:property "align-self" ; sty:raw "start" ] .
[] a sty:StyleRule ; sty:appliesTo arm:ResourceSurface ; sty:atWidth arm:ResourceDesktopReading ; sty:part "> [data-sem-c=\"card\"]:has(> .sem-card-body > [data-sem-c=\"stack\"] > [data-sem-c=\"accordion-item\"][data-expanded=\"true\"]) [data-sem-c=\"arm-resource-consumer\"] > [data-sem-c=\"accordion-item\"]" ;
 sty:declares [ sty:property "grid-column" ; sty:raw "1 / -1" ] .

# Resource help keeps complete technical labels and values in a useful measure.
# Body/facts hooks are noninteractive; native dialogs and controls stay stock.
arm:ResourceHelpBody a owl:Class ; rdfs:subClassOf c:Stack ; sem:slug "arm-resource-help-body" .
arm:ResourceHelpFacts a owl:Class ; rdfs:subClassOf c:DescriptionList ; sem:slug "arm-resource-help-facts" .
[] a sty:StyleRule ; sty:appliesTo arm:ResourceHelpBody ;
 sty:declares [ sty:property "min-width" ; sty:raw "0" ],
              [ sty:property "max-width" ; sty:raw "100%" ] .
[] a sty:StyleRule ; sty:appliesTo arm:ResourceHelpFacts ;
 sty:declares [ sty:property "min-width" ; sty:raw "0" ],
              [ sty:property "grid-template-columns" ; sty:raw "minmax(0, 1fr)" ] .
[] a sty:StyleRule ; sty:appliesTo arm:ResourceHelpFacts ; sty:part "dt, dd" ;
 sty:declares [ sty:property "min-width" ; sty:raw "0" ],
              [ sty:property "overflow-wrap" ; sty:raw "anywhere" ],
              [ sty:property "white-space" ; sty:raw "pre-wrap" ] .
[] a sty:StyleRule ; sty:part "[data-sem-c=\"dialog\"]:has(> .sem-panel > .sem-body > [data-sem-c=\"arm-resource-help-body\"]) > .sem-panel" ;
 sty:declares [ sty:property "width" ; sty:raw "min(52rem, 100%)" ] .

# Resource help actions sit at the card's inline end. Keep their full tooltip
# inside the viewport when native hover/focus returns after a dialog closes.
[] a sty:StyleRule ; sty:appliesTo arm:ResourceSurface ; sty:part "[data-sem-c=\"icon-button\"][data-sem-tooltip]::after" ;
 sty:declares [ sty:property "left" ; sty:raw "auto" ],
              [ sty:property "right" ; sty:raw "0" ],
              [ sty:property "transform" ; sty:raw "none" ],
              [ sty:property "box-sizing" ; sty:raw "border-box" ],
              [ sty:property "max-width" ; sty:raw "min(320px, calc(100vw - 3rem))" ],
              [ sty:property "overflow-wrap" ; sty:raw "anywhere" ] .

# Existing native opener restoration leaves readable space for the tooltip.
[] a sty:StyleRule ; sty:appliesTo arm:ResourceSurface ; sty:part "[data-sem-c=\"icon-button\"][data-sem-tooltip]" ;
 sty:declares [ sty:property "scroll-margin-block" ; sty:raw "4rem" ] .

@prefix sem: <https://semblance.dev/ns/core#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix pos: <https://semblance.dev/ns/position#> .
@prefix beh: <https://semblance.dev/ns/behaviour#> .
@prefix mod: <https://semblance.dev/ns/modality#> .
@prefix mot: <https://semblance.dev/ns/motion#> .
@prefix val: <https://semblance.dev/ns/validation#> .
@prefix key: <https://semblance.dev/ns/keyboard#> .
@prefix dnd: <https://semblance.dev/ns/dragdrop#> .
@prefix l10n: <https://semblance.dev/ns/l10n#> .
@prefix ann: <https://semblance.dev/ns/announce#> .
@prefix st: <https://semblance.dev/ns/status#> .
@prefix per: <https://semblance.dev/ns/persistence#> .
@prefix nav: <https://semblance.dev/ns/navigation#> .
@prefix a11y: <https://semblance.dev/ns/a11y#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <https://schema.org/> .
@prefix as: <https://www.w3.org/ns/activitystreams#> .
@prefix file: <https://semblance.dev/ns/file#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# Alignments of Semblance's vocabularies with established ones, so data written
# with ours means something to tools that know only theirs (and the reverse,
# for a reasoner). The strength of each link is deliberate:
#   owl:equivalentClass / owl:equivalentProperty - the same meaning;
#   rdfs:subClassOf / rdfs:subPropertyOf          - ours is narrower (safe to infer theirs);
#   skos:closeMatch / skos:relatedMatch           - similar, but don't infer.
# Our terms never redefine theirs: every link points from ours to theirs.

# --- the ontologies themselves (VANN, DCMI) ---------------------------------------------------

<https://semblance.dev/ns/core> a owl:Ontology ; dcterms:title "Semblance core"@en ;
    dcterms:description "Components, rules, renderings, strata, layers and slots."@en ;
    vann:preferredNamespacePrefix "sem" ; vann:preferredNamespaceUri "https://semblance.dev/ns/core#" .
<https://semblance.dev/ns/component> dcterms:title "Semblance components"@en ;
    vann:preferredNamespacePrefix "c" ; vann:preferredNamespaceUri "https://semblance.dev/ns/component#" .
<https://semblance.dev/ns/style> dcterms:title "Semblance style layer"@en ;
    vann:preferredNamespacePrefix "sty" ; vann:preferredNamespaceUri "https://semblance.dev/ns/style#" .
<https://semblance.dev/ns/behaviour> a owl:Ontology ; dcterms:title "Semblance behaviour"@en ;
    vann:preferredNamespacePrefix "beh" ; vann:preferredNamespaceUri "https://semblance.dev/ns/behaviour#" .
<https://semblance.dev/ns/l10n> dcterms:title "Semblance localization"@en ;
    vann:preferredNamespacePrefix "l10n" ; vann:preferredNamespaceUri "https://semblance.dev/ns/l10n#" .
<https://semblance.dev/ns/persistence> dcterms:title "Semblance persistence"@en ;
    vann:preferredNamespacePrefix "per" ; vann:preferredNamespaceUri "https://semblance.dev/ns/persistence#" .
<https://semblance.dev/ns/navigation> dcterms:title "Semblance navigation"@en ;
    vann:preferredNamespacePrefix "nav" ; vann:preferredNamespaceUri "https://semblance.dev/ns/navigation#" .
<https://semblance.dev/ns/validation> dcterms:title "Semblance validation"@en ;
    vann:preferredNamespacePrefix "val" ; vann:preferredNamespaceUri "https://semblance.dev/ns/validation#" .
<https://semblance.dev/ns/keyboard> dcterms:title "Semblance keyboard layer"@en ;
    vann:preferredNamespacePrefix "key" ; vann:preferredNamespaceUri "https://semblance.dev/ns/keyboard#" .
<https://semblance.dev/ns/dragdrop> dcterms:title "Semblance drag and drop layer"@en ;
    vann:preferredNamespacePrefix "dnd" ; vann:preferredNamespaceUri "https://semblance.dev/ns/dragdrop#" .
<https://semblance.dev/ns/clipboard> dcterms:title "Semblance clipboard"@en ;
    vann:preferredNamespacePrefix "clip" ; vann:preferredNamespaceUri "https://semblance.dev/ns/clipboard#" .

# --- labels and descriptions (RDFS, SKOS, DCMI) --------------------------------------------------

c:label rdfs:subPropertyOf rdfs:label ; skos:closeMatch skos:prefLabel .
c:help rdfs:subPropertyOf dcterms:description ; skos:closeMatch skos:scopeNote .
c:title rdfs:subPropertyOf dcterms:title .
c:subtitle rdfs:subPropertyOf dcterms:alternative .
c:note rdfs:subPropertyOf skos:note .
c:placeholder skos:relatedMatch schema:valueName .
sem:tooltip rdfs:subPropertyOf rdfs:comment .
sem:order skos:closeMatch schema:position .
sem:symbol skos:relatedMatch schema:identifier .
c:content rdfs:subPropertyOf dcterms:hasPart .

# --- what components are (schema.org's web page elements) --------------------------------------

sem:Component rdfs:subClassOf schema:WebPageElement .
c:AppBar rdfs:subClassOf schema:WPHeader .
c:StatusBar rdfs:subClassOf schema:WPFooter .
c:NavList rdfs:subClassOf schema:SiteNavigationElement .
c:Breadcrumbs rdfs:subClassOf schema:SiteNavigationElement ; skos:closeMatch schema:BreadcrumbList .
c:Table rdfs:subClassOf schema:Table .
c:Window rdfs:subClassOf schema:WPSideBar ; skos:relatedMatch schema:WPAdBlock .
c:Link skos:closeMatch schema:LinkRole .
# Files (ontology/layers/files.ttl): a file's metadata, as schema.org and Dublin Core say it.
file:File skos:closeMatch schema:MediaObject .
file:name rdfs:subPropertyOf schema:name .
file:mediaType skos:closeMatch schema:encodingFormat , dcterms:format .
file:size skos:closeMatch schema:contentSize .
file:modified skos:closeMatch schema:dateModified , dcterms:modified .
file:location skos:closeMatch schema:contentUrl .
c:FileDrop skos:relatedMatch schema:UploadAction .
c:href rdfs:subPropertyOf schema:url .
c:image rdfs:subPropertyOf schema:image , foaf:depiction .
c:Avatar skos:relatedMatch foaf:Image .
c:Stat skos:relatedMatch sosa:Observation .
c:Toast skos:relatedMatch schema:Message .
c:Alert skos:relatedMatch schema:Message .

# --- rules and queries (PROV-O) -------------------------------------------------------------------

sem:Rule rdfs:subClassOf prov:Plan .
sem:Query skos:closeMatch <http://spinrdf.org/sp#Query> .

# --- interaction: events are activities (ActivityStreams, PROV-O) --------------------------------

beh:Event rdfs:subClassOf as:Activity , prov:InstantaneousEvent .
beh:Click rdfs:subClassOf beh:Event .
beh:target rdfs:subPropertyOf as:object .
beh:at rdfs:subPropertyOf as:published , prov:atTime .
beh:handledBy skos:relatedMatch prov:wasAssociatedWith .
beh:Reaction skos:closeMatch prov:Plan .
beh:ChangeLog skos:relatedMatch as:OrderedCollection .
ann:announces rdfs:subPropertyOf as:summary .
key:Command skos:relatedMatch schema:Action .

# A drop is a move of something from one place to another (ActivityStreams' as:Move: its object,
# origin and target); what is carried, from where and into what are those roles. The effects are
# the kinds of action it may be.
dnd:Drop skos:closeMatch as:Move , schema:MoveAction .
dnd:Refusal skos:relatedMatch as:Reject .
dnd:carrying rdfs:subPropertyOf as:object .
dnd:from rdfs:subPropertyOf as:origin ; skos:closeMatch schema:fromLocation .
dnd:into rdfs:subPropertyOf as:target ; skos:closeMatch schema:toLocation .
dnd:Move skos:closeMatch as:Move , schema:MoveAction .
dnd:Copy skos:relatedMatch schema:CreateAction .
dnd:Link skos:relatedMatch schema:LinkRole .
dnd:rank skos:closeMatch schema:position .
dnd:accepts skos:relatedMatch sh:node .

# --- design tokens and variant values are concepts (SKOS) ----------------------------------------

sty:Token rdfs:subClassOf skos:Concept .
sty:Scale rdfs:subClassOf skos:ConceptScheme .
sty:scale rdfs:subPropertyOf skos:inScheme .
sty:Tone rdfs:subClassOf skos:Concept .
sty:Emphasis rdfs:subClassOf skos:Concept .
sty:ControlSize rdfs:subClassOf skos:Concept .
sty:Intent rdfs:subClassOf skos:Concept .
sty:ColorScheme rdfs:subClassOf skos:Concept .
sty:Contrast rdfs:subClassOf skos:Concept .
sty:Density rdfs:subClassOf skos:Concept .
sty:Elevation rdfs:subClassOf skos:Concept .
mot:Preference rdfs:subClassOf skos:Concept .
pos:Direction rdfs:subClassOf skos:Concept .
pos:Layout rdfs:subClassOf skos:Concept .
pos:Alignment rdfs:subClassOf skos:Concept .
pos:Justification rdfs:subClassOf skos:Concept .
pos:TextAlignment rdfs:subClassOf skos:Concept .
sty:Light skos:closeMatch schema:LightMode .
sty:Dark skos:closeMatch schema:DarkMode .

# --- languages (DCMI) -----------------------------------------------------------------------------

l10n:Language owl:equivalentClass dcterms:LinguisticSystem .
l10n:language rdfs:subPropertyOf dcterms:language .
l10n:code skos:closeMatch dcterms:identifier .

# --- modality (DCMI media types) -------------------------------------------------------------------

mod:Modality skos:closeMatch dcterms:MediaType .

# --- persistence and validation ---------------------------------------------------------------------

per:Policy skos:relatedMatch odrl:Policy .
per:Write rdfs:subClassOf prov:Activity .
per:Restore rdfs:subClassOf prov:Activity .
per:Forget rdfs:subClassOf prov:Activity .
per:lastWritten rdfs:subPropertyOf dcterms:modified .
st:busy skos:closeMatch schema:actionStatus .

# --- navigation (schema.org, ActivityStreams; the WHATWG URL and HTML concepts it realizes) --------

nav:Location skos:relatedMatch schema:WebPage .
nav:Dimension skos:relatedMatch schema:PropertyValue .
nav:Fragment skos:closeMatch <https://url.spec.whatwg.org/#concept-url-fragment> .
nav:Query skos:closeMatch <https://url.spec.whatwg.org/#concept-url-query> .
nav:target skos:closeMatch <https://html.spec.whatwg.org/multipage/browsing-the-web.html#the-indicated-part-of-the-document> .
nav:anchor skos:relatedMatch schema:identifier .
nav:MakesHistory skos:relatedMatch <https://html.spec.whatwg.org/multipage/nav-history-apis.html#dom-history-pushstate> .
nav:NoHistory skos:relatedMatch <https://html.spec.whatwg.org/multipage/nav-history-apis.html#dom-history-replacestate> .
nav:Navigate rdfs:subClassOf beh:Event ; skos:closeMatch as:Travel .
nav:href rdfs:subPropertyOf schema:url .
nav:address skos:relatedMatch schema:url .
c:to skos:relatedMatch schema:target .

# --- accessibility (schema.org accessibility properties) -------------------------------------------

key:shortcut skos:relatedMatch schema:accessibilityControl .
a11y:Layer skos:relatedMatch schema:accessibilityFeature .

# --- how strong a link is ---------------------------------------------------------------------------
# The strengths above, as data: each relation used for alignment says how strong a link through it
# is, so a view (c:TermAlignment, the Reference) can show it.

sem:AlignmentStrength a owl:Class ;
    rdfs:comment "How strongly a link from one of our terms to another vocabulary's says they agree (sem:order: strongest first)."@en .
sem:alignmentStrength a owl:ObjectProperty ; rdfs:domain rdf:Property ; rdfs:range sem:AlignmentStrength ;
    rdfs:comment "On a relation used for alignment: how strong a link through it is."@en .
sem:Equivalent a sem:AlignmentStrength ; sem:order 1 ; sem:slug "equivalent" ;
    rdfs:label "equivalent"@en , "еквівалент"@uk , "äquivalent"@de , "مكافئ"@ar ;
    rdfs:comment "The same meaning: either may stand for the other."@en .
sem:Narrower a sem:AlignmentStrength ; sem:order 2 ; sem:slug "narrower" ;
    rdfs:label "narrower"@en , "вужчий"@uk , "enger"@de , "أضيق"@ar ;
    rdfs:comment "Ours is narrower: whatever is ours is also theirs (safe to infer theirs)."@en .
sem:Broader a sem:AlignmentStrength ; sem:order 3 ; sem:slug "broader" ;
    rdfs:label "broader"@en , "ширший"@uk , "weiter"@de , "أوسع"@ar ;
    rdfs:comment "Ours is broader: whatever is theirs is also ours."@en .
sem:Close a sem:AlignmentStrength ; sem:order 4 ; sem:slug "close" ;
    rdfs:label "close"@en , "близький"@uk , "nah"@de , "قريب"@ar ;
    rdfs:comment "Close enough to use one for the other in some applications; don't infer."@en .
sem:Related a sem:AlignmentStrength ; sem:order 5 ; sem:slug "related" ;
    rdfs:label "related"@en , "повʼязаний"@uk , "verwandt"@de , "مرتبط"@ar ;
    rdfs:comment "Associated, not interchangeable."@en .

owl:equivalentClass sem:alignmentStrength sem:Equivalent .
owl:equivalentProperty sem:alignmentStrength sem:Equivalent .
skos:exactMatch sem:alignmentStrength sem:Equivalent .
rdfs:subClassOf sem:alignmentStrength sem:Narrower .
rdfs:subPropertyOf sem:alignmentStrength sem:Narrower .
skos:broadMatch sem:alignmentStrength sem:Narrower .
skos:narrowMatch sem:alignmentStrength sem:Broader .
skos:closeMatch sem:alignmentStrength sem:Close .
skos:relatedMatch sem:alignmentStrength sem:Related .

# --- prefixes ---------------------------------------------------------------------------------------
# The prefixes of our vocabularies and of those we use and align with (SHACL prefix declarations),
# so views can show any term as a prefixed name from the graph alone, in SPARQL as in functions.

<https://semblance.dev/ns/core> sh:declare
    [ sh:prefix "rdf" ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ],
    [ sh:prefix "rdfs" ; sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ],
    [ sh:prefix "xsd" ; sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ],
    [ sh:prefix "owl" ; sh:namespace "http://www.w3.org/2002/07/owl#"^^xsd:anyURI ],
    [ sh:prefix "sh" ; sh:namespace "http://www.w3.org/ns/shacl#"^^xsd:anyURI ],
    [ sh:prefix "prov" ; sh:namespace "http://www.w3.org/ns/prov#"^^xsd:anyURI ],
    [ sh:prefix "dcterms" ; sh:namespace "http://purl.org/dc/terms/"^^xsd:anyURI ],
    [ sh:prefix "skos" ; sh:namespace "http://www.w3.org/2004/02/skos/core#"^^xsd:anyURI ],
    [ sh:prefix "schema" ; sh:namespace "https://schema.org/"^^xsd:anyURI ],
    [ sh:prefix "as" ; sh:namespace "https://www.w3.org/ns/activitystreams#"^^xsd:anyURI ],
    [ sh:prefix "foaf" ; sh:namespace "http://xmlns.com/foaf/0.1/"^^xsd:anyURI ],
    [ sh:prefix "vann" ; sh:namespace "http://purl.org/vocab/vann/"^^xsd:anyURI ],
    [ sh:prefix "odrl" ; sh:namespace "http://www.w3.org/ns/odrl/2/"^^xsd:anyURI ],
    [ sh:prefix "sosa" ; sh:namespace "http://www.w3.org/ns/sosa/"^^xsd:anyURI ],
    [ sh:prefix "sp" ; sh:namespace "http://spinrdf.org/sp#"^^xsd:anyURI ],
    [ sh:prefix "http" ; sh:namespace "http://www.w3.org/2011/http#"^^xsd:anyURI ],
    [ sh:prefix "ldes" ; sh:namespace "https://w3id.org/ldes#"^^xsd:anyURI ],
    [ sh:prefix "tree" ; sh:namespace "https://w3id.org/tree#"^^xsd:anyURI ],
    [ sh:prefix "rdfhtml" ; sh:namespace "https://ia2.dev/spec/rdf-html#"^^xsd:anyURI ],
    [ sh:prefix "ord" ; sh:namespace "https://ontology.inferal.com/modules/ordering/"^^xsd:anyURI ],
    [ sh:prefix "sem" ; sh:namespace "https://semblance.dev/ns/core#"^^xsd:anyURI ],
    [ sh:prefix "c" ; sh:namespace "https://semblance.dev/ns/component#"^^xsd:anyURI ],
    [ sh:prefix "mod" ; sh:namespace "https://semblance.dev/ns/modality#"^^xsd:anyURI ],
    [ sh:prefix "sty" ; sh:namespace "https://semblance.dev/ns/style#"^^xsd:anyURI ],
    [ sh:prefix "tok" ; sh:namespace "https://semblance.dev/ns/token#"^^xsd:anyURI ],
    [ sh:prefix "pos" ; sh:namespace "https://semblance.dev/ns/position#"^^xsd:anyURI ],
    [ sh:prefix "beh" ; sh:namespace "https://semblance.dev/ns/behaviour#"^^xsd:anyURI ],
    [ sh:prefix "a11y" ; sh:namespace "https://semblance.dev/ns/a11y#"^^xsd:anyURI ],
    [ sh:prefix "svg" ; sh:namespace "https://semblance.dev/ns/svg#"^^xsd:anyURI ],
    [ sh:prefix "mot" ; sh:namespace "https://semblance.dev/ns/motion#"^^xsd:anyURI ],
    [ sh:prefix "val" ; sh:namespace "https://semblance.dev/ns/validation#"^^xsd:anyURI ],
    [ sh:prefix "key" ; sh:namespace "https://semblance.dev/ns/keyboard#"^^xsd:anyURI ],
    [ sh:prefix "dnd" ; sh:namespace "https://semblance.dev/ns/dragdrop#"^^xsd:anyURI ],
    [ sh:prefix "l10n" ; sh:namespace "https://semblance.dev/ns/l10n#"^^xsd:anyURI ],
    [ sh:prefix "ann" ; sh:namespace "https://semblance.dev/ns/announce#"^^xsd:anyURI ],
    [ sh:prefix "st" ; sh:namespace "https://semblance.dev/ns/status#"^^xsd:anyURI ],
    [ sh:prefix "per" ; sh:namespace "https://semblance.dev/ns/persistence#"^^xsd:anyURI ],
    [ sh:prefix "prv" ; sh:namespace "https://semblance.dev/ns/privacy#"^^xsd:anyURI ],
    [ sh:prefix "net" ; sh:namespace "https://semblance.dev/ns/network#"^^xsd:anyURI ],
    [ sh:prefix "dep" ; sh:namespace "https://semblance.dev/ns/dependency#"^^xsd:anyURI ],
    [ sh:prefix "nav" ; sh:namespace "https://semblance.dev/ns/navigation#"^^xsd:anyURI ],
    [ sh:prefix "iv" ; sh:namespace "https://semblance.dev/ns/view#"^^xsd:anyURI ],
    [ sh:prefix "clip" ; sh:namespace "https://semblance.dev/ns/clipboard#"^^xsd:anyURI ],
    [ sh:prefix "file" ; sh:namespace "https://semblance.dev/ns/file#"^^xsd:anyURI ],
    [ sh:prefix "fs" ; sh:namespace "https://semblance.dev/ns/fullscreen#"^^xsd:anyURI ],
    [ sh:prefix "perf" ; sh:namespace "https://semblance.dev/ns/perf#"^^xsd:anyURI ] .

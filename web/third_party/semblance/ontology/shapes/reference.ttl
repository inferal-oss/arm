@prefix sem: <https://semblance.dev/ns/core#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# What well-formed reference pieces look like (ontology/components/reference.ttl), validated by the
# component shapes layer like ontology/shapes/components.ttl.

c:TermTreeShape a sh:NodeShape ; sh:targetClass c:TermTree ;
    sh:property [ sh:path c:sections ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "A term tree lists its sections in c:sections (one list of c:TermSection)." ] ,
                [ sh:path c:controls ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ,
                [ sh:path c:property ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:message "A term tree selects into one property (c:property) of one node (c:controls)." ] .
c:TermSectionShape a sh:NodeShape ; sh:targetClass c:TermSection ;
    sh:property [ sh:path c:branchClass ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:message "A section lists the instances of one class (c:branchClass)." ] ,
                [ sh:path c:membersVia ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ,
                [ sh:path c:exceptProperty ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .
c:TermBranchShape a sh:NodeShape ; sh:targetClass c:TermBranch ;
    sh:property [ sh:path c:of ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ,
                [ sh:path c:section ; sh:minCount 1 ; sh:maxCount 1 ; sh:class c:TermSection ] ,
                [ sh:path c:expanded ; sh:maxCount 1 ; sh:datatype xsd:boolean ] .
c:TermOverviewShape a sh:NodeShape ; sh:targetClass c:TermOverview ;
    sh:property [ sh:path c:bindFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:message "An overview shows the term c:bindProperty of c:bindFrom holds." ] ,
                [ sh:path c:bindProperty ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ,
                [ sh:path c:controls ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ,
                [ sh:path c:property ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .
c:TermAlignmentShape a sh:NodeShape ; sh:targetClass c:TermAlignment ;
    sh:property [ sh:path c:bindFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:message "An alignment view shows the term c:bindProperty of c:bindFrom holds." ] ,
                [ sh:path c:bindProperty ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .
c:InverseFacetShape a sh:NodeShape ; sh:targetClass c:InverseFacet ;
    sh:property [ sh:path c:facetProperty ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:message "A facet follows one property (c:facetProperty) back to the term." ] ,
                [ sh:path c:through ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ,
                [ sh:path c:noteProperty ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ,
                [ sh:path sem:order ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] .
c:TermKindShape a sh:NodeShape ; sh:targetClass c:TermKind ;
    sh:property [ sh:path sem:order ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
                [ sh:path sem:slug ; sh:minCount 1 ; sh:maxCount 1 ] ,
                [ sh:path sem:symbol ; sh:minCount 1 ; sh:maxCount 1 ] .
c:TermMembersShape a sh:NodeShape ; sh:targetClass c:TermMembers ;
    sh:property [ sh:path c:membersOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class c:TermTree ; sh:message "A members view lists the branches of one term tree (c:membersOf)." ] ,
                [ sh:path c:bindFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ,
                [ sh:path c:bindProperty ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .
c:TermCardShape a sh:NodeShape ; sh:targetClass c:TermCard ;
    sh:property [ sh:path c:of ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ,
                [ sh:path c:role ; sh:maxCount 1 ; sh:class c:TermRole ] .
c:TermRoleShape a sh:NodeShape ; sh:targetClass c:TermRole ;
    sh:property [ sh:path sem:order ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
                [ sh:path sem:slug ; sh:minCount 1 ; sh:maxCount 1 ] .

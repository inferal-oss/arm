@prefix sem: <https://semblance.dev/ns/core#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix beh: <https://semblance.dev/ns/behaviour#> .
@prefix mod: <https://semblance.dev/ns/modality#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix key: <https://semblance.dev/ns/keyboard#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

# Well-formed data grids and time axes (validated by the component shapes layer).

c:DataGridShape a sh:NodeShape ; sh:targetClass c:DataGrid ;
    sh:property [ sh:path c:collection ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
                  sh:message "A data grid shows the members of a collection (c:collection)." ] ,
                [ sh:path c:gridColumns ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:message "A data grid needs its columns (c:gridColumns, a list of c:GridColumn)." ] ,
                [ sh:path c:memberProperty ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ,
                [ sh:path c:sequenceProperty ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ,
                [ sh:path c:shows ; sh:class c:GridColumn ] ,
                [ sh:path c:sortColumn ; sh:maxCount 1 ; sh:class c:GridColumn ] ,
                [ sh:path c:sortDescending ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ,
                [ sh:path c:selectedRow ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ,
                [ sh:path c:followTail ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ,
                [ sh:path c:windowEnd ; sh:maxCount 1 ] ,
                [ sh:path c:pageSize ; sh:maxCount 1 ; sh:minInclusive 1 ; sh:message "A page shows at least one row (c:pageSize ≥ 1)." ] ,
                [ sh:path c:filteredBy ; sh:class c:Filter ] .

c:TimeAxisShape a sh:NodeShape ; sh:targetClass c:TimeAxis ;
    sh:property [ sh:path c:start ; sh:maxCount 1 ] ,
                [ sh:path c:end ; sh:maxCount 1 ; sh:message "A time axis has one end (c:end)." ] ,
                [ sh:path c:scale ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

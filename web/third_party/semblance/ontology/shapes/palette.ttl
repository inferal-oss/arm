@prefix sem: <https://semblance.dev/ns/core#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# What a well-formed command palette looks like (ontology/components/palette.ttl), checked by the
# component shapes layer: what it lists, its state, and the recent runs it keeps.

c:CommandPaletteShape a sh:NodeShape ; sh:targetClass c:CommandPalette ;
    sh:property [ sh:path c:lists ; sh:class c:PaletteSource ;
                  sh:message "A palette lists c:PaletteCommands, c:PaletteShortcuts or c:PalettePlaces (c:lists)." ] ,
                [ sh:path c:entries ; sh:maxCount 1 ;
                  sh:message "A palette's entries are one list (c:entries)." ] ,
                [ sh:path c:recentLimit ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ;
                  sh:message "How many recent runs a palette keeps is a number, 0 or more (c:recentLimit)." ] ,
                [ sh:path c:open ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ,
                [ sh:path c:value ; sh:maxCount 1 ] ,
                [ sh:path c:activeOption ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
                  sh:message "The highlighted option is one of the palette's options." ] ,
                [ sh:path c:caret ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
    # It edits no property: what a typeahead that does says is not said of it.
    sh:property [ sh:path c:controls ; sh:maxCount 0 ; sh:message "A command palette edits no property (c:controls belongs to a combobox or a tag input)." ] .

c:RecentRunShape a sh:NodeShape ; sh:targetClass c:RecentRun ;
    sh:property [ sh:path c:recentOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class c:CommandPalette ;
                  sh:message "A recent run belongs to one palette (c:recentOf)." ] ,
                [ sh:path c:entryFor ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
                  sh:message "A recent run is of one item (c:entryFor)." ] ,
                [ sh:path c:recentRank ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ;
                  sh:message "A recent run has its place among them (c:recentRank 0, 1, …)." ] .

c:PaletteSectionShape a sh:NodeShape ; sh:targetClass c:PaletteSection ;
    sh:property [ sh:path sem:order ; sh:maxCount 1 ;
                  sh:message "A section has one place among the others (sem:order)." ] .

# Optional metadata on component entries, including buttons and places. Other
# RDF entries may use this same property shape with their own SHACL target.
c:PaletteKeywordsShape a sh:NodeShape ; sh:targetClass sem:Component ;
    sh:property [ sh:path c:keywords ; sh:maxCount 1 ; sh:nodeKind sh:Literal ; sh:maxLength 32768 ;
                  sh:message "Palette search keywords are one literal of at most 32768 characters (c:keywords)." ] .

@prefix sem: <https://semblance.dev/ns/core#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix clip: <https://semblance.dev/ns/clipboard#> .
@prefix fs: <https://semblance.dev/ns/fullscreen#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix pos: <https://semblance.dev/ns/position#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# What well-formed component instances look like (validated by the component
# shapes layer, ontology/layers/shapes.ttl). A shape on a class applies to the
# instances of its subclasses too, so the shape of sem:Component covers every
# component's shared properties: the variant axes, positioning, flags.

sem:ComponentShape a sh:NodeShape ; sh:targetClass sem:Component ;
    sh:property [ sh:path sty:tone ; sh:maxCount 1 ; sh:class sty:Tone ] ,
                [ sh:path sty:emphasis ; sh:maxCount 1 ; sh:class sty:Emphasis ] ,
                [ sh:path sty:size ; sh:maxCount 1 ; sh:class sty:ControlSize ] ,
                [ sh:path sty:textStyle ; sh:maxCount 1 ; sh:class sty:TextStyle ] ,
                [ sh:path sty:theme ; sh:maxCount 1 ; sh:class sty:Theme ] ,
                [ sh:path sty:intent ; sh:maxCount 1 ; sh:class sty:Intent ] ,
                [ sh:path pos:direction ; sh:maxCount 1 ; sh:class pos:Direction ] ,
                [ sh:path pos:layout ; sh:maxCount 1 ; sh:class pos:Layout ] ,
                [ sh:path pos:align ; sh:maxCount 1 ; sh:class pos:Alignment ] ,
                [ sh:path c:label ; sh:nodeKind sh:Literal ] ,
                [ sh:path c:help ; sh:nodeKind sh:Literal ] ,
                [ sh:path c:disabled ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ,
                [ sh:path fs:fullscreen ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ,
                [ sh:path fs:fullViewport ; sh:maxCount 1 ; sh:datatype xsd:boolean ] .

# An accessible name, for a control a c:Field can wrap (one with a c:labelPart): its own c:label, or
# the label of the c:Field whose c:content it is (that label points at the control's labelPart). Only
# a Field counts: tabs, windows and switch cases have c:content too, and do not label it.
c:OwnLabelShape a sh:PropertyShape ;
    rdfs:comment "Has its own label."@en ;
    sh:path c:label ; sh:minCount 1 .
c:FieldContentShape a sh:PropertyShape ;
    rdfs:comment "Is the content of a c:Field, which labels it."@en ;
    sh:path [ sh:inversePath c:content ] ;
    sh:qualifiedValueShape [ sh:class c:Field ] ; sh:qualifiedMinCount 1 .

c:ButtonShape a sh:NodeShape ; sh:targetClass c:Button ;
    sh:property [ sh:path c:label ; sh:minCount 1 ; sh:message "A button needs a label (c:label) to say what it does." ] .
c:HeadingShape a sh:NodeShape ; sh:targetClass c:Heading ;
    sh:property [ sh:path c:label ; sh:minCount 1 ] ,
                [ sh:path c:level ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 6 ] .
c:TextFieldShape a sh:NodeShape ; sh:targetClass c:TextField ;
    sh:or ( c:OwnLabelShape c:FieldContentShape ) ;
    sh:message "A text field needs a label (c:label), or a c:Field around it: placeholders are not labels." ;
    sh:property [ sh:path c:value ; sh:maxCount 1 ] ,
                [ sh:path c:inputType ; sh:maxCount 1 ; sh:in ( "text" "password" "email" "number" "search" "tel" "url" "date" ) ] .
c:CodeInputShape a sh:NodeShape ; sh:targetClass c:CodeInput ;
    sh:or ( c:OwnLabelShape c:FieldContentShape ) ;
    sh:message "A code input needs a label (c:label), or a c:Field around it: say what the code is for." ;
    sh:property [ sh:path c:value ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
                [ sh:path c:length ; sh:maxCount 1 ; sh:minInclusive 1 ; sh:maxInclusive 32 ; sh:message "A code has 1 to 32 characters (c:length)." ] ,
                [ sh:path c:groupSize ; sh:maxCount 1 ; sh:minInclusive 1 ] ,
                [ sh:path c:charset ; sh:maxCount 1 ; sh:class c:Charset ] ,
                [ sh:path c:case ; sh:maxCount 1 ; sh:class c:Case ] ,
                [ sh:path c:cellStyle ; sh:maxCount 1 ; sh:class c:CellStyle ] .
c:CharsetShape a sh:NodeShape ; sh:targetClass c:Charset ;
    sh:property [ sh:path c:characters ; sh:minCount 1 ; sh:maxCount 1 ] ,
                [ sh:path c:inputMode ; sh:maxCount 1 ; sh:in ( "none" "text" "decimal" "numeric" "tel" "search" "email" "url" ) ] .
c:BadgeShape a sh:NodeShape ; sh:targetClass c:Badge ;
    sh:property [ sh:path c:label ; sh:minCount 1 ; sh:maxLength 32 ] .
c:EmblemShape a sh:NodeShape ; sh:targetClass c:Emblem ;
    sh:property [ sh:path c:viewBox ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^-?[0-9.]+( -?[0-9.]+){3}$" ;
                  sh:message "An emblem's c:viewBox is four numbers: min-x min-y width height." ] ,
                [ sh:path c:pathData ; sh:minCount 1 ; sh:maxCount 1 ] ,
                [ sh:path c:fillRule ; sh:maxCount 1 ; sh:in ( "nonzero" "evenodd" ) ] .
c:LinkShape a sh:NodeShape ; sh:targetClass c:Link ;
    sh:property [ sh:path c:href ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^(https?:|mailto:|/|#|\\./|\\.\\./)" ;
                  sh:message "A link's c:href is a web, mail, or relative address (no javascript: or data: URLs)." ] ,
                [ sh:path c:content ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
                  sh:message "A link's body (c:content) is one component." ] ,
                [ sh:path c:currentPage ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ,
                [ sh:path c:count ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ;
                  sh:message "A link's c:count is one whole number, zero or more." ] .
c:HostSlotShape a sh:NodeShape ; sh:targetClass c:HostSlot ;
    sh:property [ sh:path c:slot ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:message "A host slot has one name (c:slot), a plain string." ] .
# A linked card is a c:Link (its shape applies) around a component.
c:LinkedCardShape a sh:NodeShape ; sh:targetClass c:LinkedCard ;
    sh:property [ sh:path c:content ; sh:minCount 1 ;
                  sh:message "A linked card wraps one component (c:content)." ] .
c:ProgressShape a sh:NodeShape ; sh:targetClass c:Progress ;
    sh:property [ sh:path c:value ; sh:minInclusive 0 ; sh:lessThanOrEquals c:max ;
                  sh:message "Progress can't exceed its c:max or go below zero." ] .
c:SliderShape a sh:NodeShape ; sh:targetClass c:Slider ;
    sh:or ( c:OwnLabelShape c:FieldContentShape ) ;
    sh:message "A slider needs a label (c:label), or a c:Field around it." ;
    sh:property [ sh:path c:value ; sh:maxCount 1 ; sh:lessThanOrEquals c:max ] ,
                [ sh:path c:min ; sh:maxCount 1 ; sh:lessThanOrEquals c:max ] .
c:PaginationShape a sh:NodeShape ; sh:targetClass c:Pagination ;
    sh:property [ sh:path c:page ; sh:minCount 1 ; sh:minInclusive 1 ; sh:lessThanOrEquals c:pages ] ,
                [ sh:path c:pages ; sh:minCount 1 ; sh:minInclusive 1 ] .
c:AvatarShape a sh:NodeShape ; sh:targetClass c:Avatar ;
    sh:property [ sh:path c:label ; sh:minCount 1 ; sh:message "An avatar needs a name (c:label) for its initials and its accessible name." ] .
c:OwnIconShape a sh:PropertyShape ;
    rdfs:comment "Has its own glyph."@en ;
    sh:path c:icon ; sh:minCount 1 .
c:CopierIconShape a sh:PropertyShape ;
    rdfs:comment "Copies something (a clip:Copier): its glyph is derived from its outcome and clip:icon."@en ;
    sh:path clip:copies ; sh:minCount 1 .
c:IconButtonShape a sh:NodeShape ; sh:targetClass c:IconButton ;
    sh:or ( c:OwnIconShape c:CopierIconShape ) ;
    sh:message "An icon button needs a glyph (c:icon), unless it is a clip:Copier, whose glyph is derived." ;
    sh:property [ sh:path c:label ; sh:minCount 1 ; sh:message "An icon-only button needs a c:label: it is its accessible name." ] .
c:DialogShape a sh:NodeShape ; sh:targetClass c:Dialog ;
    sh:property [ sh:path c:label ; sh:minCount 1 ; sh:message "A dialog needs a title (c:label): it labels the dialog." ] ,
                [ sh:path c:open ; sh:maxCount 1 ; sh:datatype xsd:boolean ] .
c:ChoiceShape a sh:NodeShape ; sh:targetClass c:Choice ;
    sh:property [ sh:path c:controls ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ,
                [ sh:path c:property ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .
c:SegmentedShape a sh:NodeShape ; sh:targetClass c:Segmented ;
    sh:property [ sh:path c:controls ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ,
                [ sh:path c:property ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ,
                [ sh:path c:compactAs ; sh:maxCount 1 ; sh:class c:CompactPresentation ] .
c:AppBarShape a sh:NodeShape ; sh:targetClass c:AppBar ;
    sh:property [ sh:path c:actions ; sh:maxCount 1 ] ,
                [ sh:path c:moreActions ; sh:maxCount 1 ] ,
                [ sh:path c:moreLabel ; sh:nodeKind sh:Literal ] ,
                [ sh:path c:expanded ; sh:maxCount 1 ; sh:datatype xsd:boolean ] .
c:TabsShape a sh:NodeShape ; sh:targetClass c:Tabs ;
    sh:property [ sh:path c:tabs ; sh:minCount 1 ; sh:maxCount 1 ] ,
                [ sh:path c:selected ; sh:maxCount 1 ; sh:class c:Tab ] .
c:TabShape a sh:NodeShape ; sh:targetClass c:Tab ;
    sh:property [ sh:path c:label ; sh:minCount 1 ] , [ sh:path c:content ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .
c:WindowShape a sh:NodeShape ; sh:targetClass c:Window ;
    sh:property [ sh:path c:width ; sh:maxCount 1 ; sh:minInclusive 160 ] , [ sh:path c:height ; sh:maxCount 1 ; sh:minInclusive 100 ] .
c:TableShape a sh:NodeShape ; sh:targetClass c:Table ;
    sh:property [ sh:path c:query ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "A table shows the rows of a query (c:query)." ] .
c:FlippableShape a sh:NodeShape ; sh:targetClass c:Flippable ;
    sh:property [ sh:path c:front ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .
c:SpecimenShape a sh:NodeShape ; sh:targetClass c:Specimen ;
    sh:property [ sh:path c:label ; sh:minCount 1 ] ,
                [ sh:path c:demonstrates ; sh:nodeKind sh:IRI ; sh:message "A specimen demonstrates classes (c:demonstrates): IRIs." ] .

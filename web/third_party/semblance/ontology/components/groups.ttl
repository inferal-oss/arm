@prefix sem: <https://semblance.dev/ns/core#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix clip: <https://semblance.dev/ns/clipboard#> .
@prefix fs: <https://semblance.dev/ns/fullscreen#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ext: <https://semblance.dev/ns/foreign#> .

# The component groups (DESIGN.md §3), and which group each component class is in,
# with its mixins and parts (sem:group). The reference (c:TermTree) lists components
# this way. Kept in one place, so the whole index reads at a glance; a test requires
# every component class to be in a group.

c:LayoutGroup a sem:ComponentGroup ; sem:order 1 ;
    rdfs:label "Layout"@en , "Компонування"@uk , "Layout"@de , "التخطيط"@ar ;
    rdfs:comment "Arranging other components: stacks, grids, surfaces, cards, split views."@en .
c:TypeGroup a sem:ComponentGroup ; sem:order 2 ;
    rdfs:label "Type"@en , "Текст"@uk , "Typografie"@de , "الطباعة"@ar ;
    rdfs:comment "Text in its roles: headings, paragraphs, links, keys, code, source text, walkthroughs and live examples."@en .
c:ActionsGroup a sem:ComponentGroup ; sem:order 3 ;
    rdfs:label "Actions"@en , "Дії"@uk , "Aktionen"@de , "الإجراءات"@ar ;
    rdfs:comment "What can be pressed: buttons, menus, toolbars, and the mixins that make anything pressable."@en .
c:InputsGroup a sem:ComponentGroup ; sem:order 4 ;
    rdfs:label "Inputs"@en , "Введення"@uk , "Eingaben"@de , "المدخلات"@ar ;
    rdfs:comment "Controls whose value is graph state: fields, choices, switches, sliders, codes, code editors."@en .
c:FeedbackGroup a sem:ComponentGroup ; sem:order 5 ;
    rdfs:label "Feedback"@en , "Відгук"@uk , "Rückmeldung"@de , "الملاحظات"@ar ;
    rdfs:comment "Status and messages: alerts, badges, progress, toasts, empty states."@en .
c:DataGroup a sem:ComponentGroup ; sem:order 6 ;
    rdfs:label "Data"@en , "Дані"@uk , "Daten"@de , "البيانات"@ar ;
    rdfs:comment "Views of data: lists, tables, grids, trees, timelines, charts, payloads."@en .
c:NavigationGroup a sem:ComponentGroup ; sem:order 7 ;
    rdfs:label "Navigation"@en , "Навігація"@uk , "Navigation"@de , "التنقل"@ar ;
    rdfs:comment "Moving between views: tabs, navigation lists, breadcrumbs, steppers, the app bar."@en .
c:OverlaysGroup a sem:ComponentGroup ; sem:order 8 ;
    rdfs:label "Overlays"@en , "Накладки"@uk , "Overlays"@de , "الطبقات المنبثقة"@ar ;
    rdfs:comment "Content above the page: dialogs, drawers, popovers, the command palette."@en .
c:DisclosureGroup a sem:ComponentGroup ; sem:order 9 ;
    rdfs:label "Disclosure"@en , "Розкриття"@uk , "Aufklappen"@de , "الإفصاح"@ar ;
    rdfs:comment "Showing and hiding: accordions, and cards that turn over to their source."@en .
c:WindowsGroup a sem:ComponentGroup ; sem:order 10 ;
    rdfs:label "Windows"@en , "Вікна"@uk , "Fenster"@de , "النوافذ"@ar ;
    rdfs:comment "Floating frames on a desktop, and the capability mixins an instance opts into."@en .
c:InspectionGroup a sem:ComponentGroup ; sem:order 11 ;
    rdfs:label "Inspection"@en , "Інспекція"@uk , "Inspektion"@de , "الفحص"@ar ;
    rdfs:comment "Looking at the graph itself: the SPARQL workbench and its results, query, triples and stream views, the element markup inspector, the reference."@en .

# --- Layout ---
c:Stack sem:group c:LayoutGroup . c:HostSlot sem:group c:LayoutGroup . c:Surface sem:group c:LayoutGroup . c:Divider sem:group c:LayoutGroup .
c:Grid sem:group c:LayoutGroup . c:Spacer sem:group c:LayoutGroup . c:Card sem:group c:LayoutGroup . c:LinkedCard sem:group c:LayoutGroup .
c:Specimen sem:group c:LayoutGroup . c:Swatches sem:group c:LayoutGroup . c:StatusBar sem:group c:LayoutGroup .
c:Switch sem:group c:LayoutGroup . c:SplitView sem:group c:LayoutGroup . c:DockPanel sem:group c:LayoutGroup . c:TiledWorkspace sem:group c:LayoutGroup . c:TabHandle sem:group c:LayoutGroup . c:CloseTile sem:group c:LayoutGroup .
c:Canvas sem:group c:LayoutGroup . c:CanvasItem sem:group c:LayoutGroup . c:Connector sem:group c:LayoutGroup .
# A foreign component (web component, framework component, widget) is laid out like any other part.
ext:Island sem:group c:LayoutGroup .
c:Route sem:group c:LayoutGroup . c:Arrowheads sem:group c:LayoutGroup . c:LineStyle sem:group c:LayoutGroup . c:ConnectorCondition sem:group c:LayoutGroup .

# --- Type ---
c:Heading sem:group c:TypeGroup . c:Text sem:group c:TypeGroup . c:Link sem:group c:TypeGroup .
c:Kbd sem:group c:TypeGroup . c:Code sem:group c:TypeGroup . c:Blockquote sem:group c:TypeGroup .
c:GraphMark sem:group c:TypeGroup . c:MarkNode sem:group c:TypeGroup . c:Emblem sem:group c:TypeGroup .
c:Walkthrough sem:group c:TypeGroup . c:WalkthroughStep sem:group c:TypeGroup . c:Mention sem:group c:TypeGroup .
c:SourceSpan sem:group c:TypeGroup . c:StepInView sem:group c:TypeGroup .
# Source shown as text: a source text verbatim (the walkthrough's), and a live example's Turtle
# beside what it renders, with its sandbox's state and problems.
c:SourceView sem:group c:TypeGroup . c:SourceText sem:group c:TypeGroup .
c:LiveExample sem:group c:TypeGroup . c:SandboxState sem:group c:TypeGroup . c:SandboxProblem sem:group c:TypeGroup .

# --- Actions ---
c:Button sem:group c:ActionsGroup . c:IconButton sem:group c:ActionsGroup . c:ButtonGroup sem:group c:ActionsGroup .
c:Menu sem:group c:ActionsGroup . c:MenuItem sem:group c:ActionsGroup . c:Toggle sem:group c:ActionsGroup .
c:Toolbar sem:group c:ActionsGroup .
c:Pressable sem:group c:ActionsGroup . c:Setter sem:group c:ActionsGroup . c:Unsetter sem:group c:ActionsGroup .
clip:Copier sem:group c:ActionsGroup .

# --- Inputs ---
c:TextField sem:group c:InputsGroup . c:TextArea sem:group c:InputsGroup . c:Checkbox sem:group c:InputsGroup .
c:RadioGroup sem:group c:InputsGroup . c:ToggleSwitch sem:group c:InputsGroup . c:Slider sem:group c:InputsGroup .
c:Field sem:group c:InputsGroup . c:Choice sem:group c:InputsGroup . c:Segmented sem:group c:InputsGroup .
c:Chips sem:group c:InputsGroup . c:CodeInput sem:group c:InputsGroup . c:ThemeSwitcher sem:group c:InputsGroup .
c:SearchField sem:group c:InputsGroup .
c:Typeahead sem:group c:InputsGroup . c:Combobox sem:group c:InputsGroup . c:TagInput sem:group c:InputsGroup .
c:TypeaheadOption sem:group c:InputsGroup . c:CustomValueKind sem:group c:InputsGroup . c:OptionNaming sem:group c:InputsGroup .
c:TypeaheadKey sem:group c:InputsGroup . c:TypeaheadLeave sem:group c:InputsGroup .
c:FileDrop sem:group c:InputsGroup . c:FileItem sem:group c:InputsGroup .
c:Charset sem:group c:InputsGroup . c:Case sem:group c:InputsGroup . c:CellStyle sem:group c:InputsGroup .
c:SearchKey sem:group c:InputsGroup .
c:ShapeForm sem:group c:InputsGroup . c:ShapeField sem:group c:InputsGroup .
# Dates and times: the month grid is the part a date field's popup is made of, and stands alone.
c:MonthGrid sem:group c:InputsGroup . c:DateField sem:group c:InputsGroup . c:DateRangeField sem:group c:InputsGroup .
c:TimeField sem:group c:InputsGroup . c:MonthGridKey sem:group c:InputsGroup . c:TimeFieldKey sem:group c:InputsGroup .
# A code editor's text is its value, like any field's; the SPARQL editor is one in SPARQL. The
# words of the languages they know (c:CodeWord) and their key event are their parts.
c:CodeEditor sem:group c:InputsGroup . c:QueryEditor sem:group c:InputsGroup . c:EditorKey sem:group c:InputsGroup .
c:CodeWord sem:group c:InputsGroup . c:CodeKeyword sem:group c:InputsGroup . c:CodeFunction sem:group c:InputsGroup .
c:TurtleKeyword sem:group c:InputsGroup .
c:SparqlWord sem:group c:InputsGroup . c:SparqlKeyword sem:group c:InputsGroup . c:SparqlFunction sem:group c:InputsGroup .
c:Sheet sem:group c:DataGroup . c:SheetCell sem:group c:DataGroup . c:SheetFunction sem:group c:DataGroup . c:SheetKey sem:group c:DataGroup .

# --- Feedback ---
c:Alert sem:group c:FeedbackGroup . c:Badge sem:group c:FeedbackGroup . c:Tag sem:group c:FeedbackGroup .
c:Spinner sem:group c:FeedbackGroup . c:Skeleton sem:group c:FeedbackGroup . c:Progress sem:group c:FeedbackGroup .
c:Toast sem:group c:FeedbackGroup . c:ToastRegion sem:group c:FeedbackGroup . c:EmptyState sem:group c:FeedbackGroup .
c:LiveIndicator sem:group c:FeedbackGroup . c:CountBadge sem:group c:FeedbackGroup .


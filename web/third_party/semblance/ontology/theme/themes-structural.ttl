    sty:part ":is([data-sem-c=text-field] input, [data-sem-c=shape-field] :is(input:not([type=checkbox]), select, textarea), [data-sem-c=text-area] > textarea)[aria-invalid=true]:not(:where([data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]), [data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]) *))" ;
    sty:declares [ sty:property "border-bottom-color" ; sty:raw "var(--sem-danger)" ] .

    sty:part ":is([data-sem-c=window], [data-sem-c=palette]) .sem-window-control:is([data-sem-control=maximize], [data-sem-control=restore]):hover:not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "#28c840" ] .
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part ":is([data-sem-c=window], [data-sem-c=palette]) .sem-window-control:is([data-sem-control=dock], [data-sem-control=undock]):not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))" ;
    sty:declares [ sty:property "order" ; sty:raw "1" ] ,
                 [ sty:property "margin-inline-start" ; sty:raw "auto" ] .
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part ":is([data-sem-c=window], [data-sem-c=palette]) .sem-window-bar:is(:hover, :focus-within) .sem-window-control:not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))" ;
    sty:declares [ sty:property "color" ; sty:raw "rgb(0 0 0 / 0.6)" ] .
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part ":is([data-sem-c=window], [data-sem-c=palette]) .sem-window-control:focus-visible:not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))" ;
    sty:declares [ sty:property "box-shadow" ; sty:raw "var(--sem-ring)" ] .
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part "[data-sem-c=palette] .sem-window-control:not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))" ;
    sty:declares [ sty:property "width" ; sty:raw "10px" ] ,
                 [ sty:property "height" ; sty:raw "10px" ] ,
                 [ sty:property "font-size" ; sty:raw "7px" ] .

# The dock: on the desktop, the taskbar is a glass shelf of large icons with a dot under the frontmost.
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part "[data-sem-c=taskbar]:not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))" ;
    sty:declares [ sty:property "border-radius" ; sty:raw "18px" ] ,
                 [ sty:property "padding" ; sty:raw "5px" ] ,
                 [ sty:property "gap" ; sty:raw "4px" ] .
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part "[data-sem-c=taskbar] .sem-task:not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))" ;
    sty:declares [ sty:property "flex-direction" ; sty:raw "column" ] ,
                 [ sty:property "height" ; sty:raw "auto" ] ,
                 [ sty:property "padding" ; sty:raw "6px 10px 8px" ] ,
                 [ sty:property "gap" ; sty:raw "3px" ] ,
                 [ sty:property "border-radius" ; sty:raw "12px" ] ,
                 [ sty:property "font-size" ; sty:raw "10px" ] ,
                 [ sty:property "font-weight" ; sty:raw "500" ] ,
                 [ sty:property "color" ; sty:raw "var(--sem-text)" ] ,
                 [ sty:property "transition" ; sty:raw "transform var(--sem-duration-fast) var(--sem-spring), background var(--sem-duration-fast) var(--sem-ease)" ] .
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part "[data-sem-c=taskbar] .sem-task .sem-icon:not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))" ;
    sty:declares [ sty:property "font-size" ; sty:raw "22px" ] ,
                 [ sty:property "line-height" ; sty:raw "1" ] .
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part "[data-sem-c=taskbar] .sem-task:hover:not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))" ;
    sty:declares [ sty:property "transform" ; sty:raw "translateY(-3px) scale(1.06)" ] ,
                 [ sty:property "background" ; sty:raw "transparent" ] .
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part "[data-sem-c=taskbar] .sem-task[aria-current=\"true\"]:not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "radial-gradient(circle, var(--sem-text) 0 2px, transparent 2.5px) bottom 1px center / 6px 6px no-repeat" ] ,
                 [ sty:property "color" ; sty:raw "var(--sem-text)" ] .
# Docked, the dock stays a shelf: centred along its edge, a little off it, as long as its entries;
# the page keeps clear the band it floats in (--sem-taskbar-size, --sem-taskbar-span).
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part "[data-sem-c=desktop] > [data-sem-c=taskbar]:is([data-sem-edge=top], [data-sem-edge=bottom], [data-sem-edge=start], [data-sem-edge=end]):not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))" ;
    sty:declares [ sty:property "border-radius" ; sty:raw "18px" ] ,
                 [ sty:property "border-width" ; sty:raw "1px" ] ,
                 [ sty:property "box-shadow" ; sty:raw "var(--sem-shadow-3)" ] .
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part "[data-sem-c=desktop] > [data-sem-c=taskbar]:is([data-sem-edge=top], [data-sem-edge=bottom]):not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))" ;
    sty:declares [ sty:property "inline-size" ; sty:raw "fit-content" ] ,
                 [ sty:property "max-inline-size" ; sty:raw "calc(100% - 16px)" ] ,
                 [ sty:property "margin-inline" ; sty:raw "auto" ] ,
                 [ sty:property "block-size" ; sty:raw "auto" ] .
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part "[data-sem-c=desktop] > [data-sem-c=taskbar][data-sem-edge=bottom]:not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))" ;
    sty:declares [ sty:property "inset-block-end" ; sty:raw "6px" ] .
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part "[data-sem-c=desktop] > [data-sem-c=taskbar][data-sem-edge=top]:not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))" ;
    sty:declares [ sty:property "inset-block-start" ; sty:raw "6px" ] .
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part "[data-sem-c=desktop] > [data-sem-c=taskbar]:is([data-sem-edge=start], [data-sem-edge=end]):not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))" ;
    sty:declares [ sty:property "block-size" ; sty:raw "fit-content" ] ,
                 [ sty:property "max-block-size" ; sty:raw "calc(100dvh - 16px)" ] ,
                 [ sty:property "margin-block" ; sty:raw "auto" ] ,
                 [ sty:property "inline-size" ; sty:raw "auto" ] ,
                 [ sty:property "align-items" ; sty:raw "center" ] .
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part "[data-sem-c=desktop] > [data-sem-c=taskbar][data-sem-edge=start]:not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))" ;
    sty:declares [ sty:property "inset-inline-start" ; sty:raw "6px" ] .
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part "[data-sem-c=desktop] > [data-sem-c=taskbar][data-sem-edge=end]:not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))" ;
    sty:declares [ sty:property "inset-inline-end" ; sty:raw "6px" ] .
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part "[data-sem-c=desktop] > [data-sem-c=taskbar]:is([data-sem-edge=start], [data-sem-edge=end]) > .sem-task:not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))" ;
    sty:declares [ sty:property "max-width" ; sty:raw "72px" ] .

# Bars: the app bar and the status bar are glass toolbars with hairline edges.
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part "[data-sem-c=app-bar]:not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "var(--mac-glass)" ] ,
                 [ sty:property "backdrop-filter" ; sty:raw "var(--mac-blur)" ] ,
                 [ sty:property "border-bottom" ; sty:raw "0.5px solid var(--mac-hairline)" ] .
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part "[data-sem-c=status-bar]:not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "var(--mac-glass)" ] ,
                 [ sty:property "backdrop-filter" ; sty:raw "var(--mac-blur)" ] ,
                 [ sty:property "border-top" ; sty:raw "0.5px solid var(--mac-hairline)" ] .

# Fields: a white well with a hairline; check boxes and radios are small and blue; sliders thin with a round knob.
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part ":is([data-sem-c=text-field] input, [data-sem-c=shape-field] :is(input:not([type=checkbox]), select, textarea), [data-sem-c=text-area] > textarea):not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))" ;
    sty:declares [ sty:property "background-color" ; sty:raw "var(--sem-surface)" ] ,
                 [ sty:property "border" ; sty:raw "0.5px solid var(--sem-border-strong)" ] ,
                 [ sty:property "padding" ; sty:raw "5px 8px" ] ,
                 [ sty:property "box-shadow" ; sty:raw "inset 0 0.5px 1px light-dark(rgb(0 0 0 / 0.08), rgb(0 0 0 / 0.4))" ] .
# A select padded all round keeps room for its chevron.
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part "[data-sem-c=shape-field] select:not([multiple]):not([size]):not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))" ;
    sty:declares [ sty:property "padding-inline-end" ; sty:raw "var(--sem-chevron-space)" ] .
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part ":is([data-sem-c=text-field] input, [data-sem-c=shape-field] :is(input:not([type=checkbox]), select, textarea), [data-sem-c=text-area] > textarea):focus:not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))" ;
    sty:declares [ sty:property "border-color" ; sty:raw "var(--sem-accent-9)" ] ,
                 [ sty:property "box-shadow" ; sty:raw "var(--sem-ring)" ] .
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part "[data-sem-c=checkbox] > .sem-row > input:not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))" ;
    sty:declares [ sty:property "--check-size" ; sty:raw "15px" ] ,
                 [ sty:property "border-radius" ; sty:raw "4px" ] ,
                 [ sty:property "border-width" ; sty:raw "0.5px" ] ,
                 [ sty:property "box-shadow" ; sty:raw "var(--sem-shadow)" ] .
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part "[data-sem-c=radio-group] .sem-radio:not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "transparent" ] ,
                 [ sty:property "border" ; sty:raw "0" ] ,
                 [ sty:property "padding" ; sty:raw "3px 0" ] ,
                 [ sty:property "box-shadow" ; sty:raw "none" ] .
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part "[data-sem-c=radio-group] .sem-radio:has(> input:checked):not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "transparent" ] .
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part "[data-sem-c=radio-group] .sem-radio > input:not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))" ;
    sty:declares [ sty:property "--radio-size" ; sty:raw "15px" ] ,
                 [ sty:property "border-width" ; sty:raw "0.5px" ] ,
                 [ sty:property "box-shadow" ; sty:raw "var(--sem-shadow)" ] .
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part "[data-sem-c=radio-group] .sem-radio:has(> input:focus-visible) > input:not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))" ;
    sty:declares [ sty:property "box-shadow" ; sty:raw "var(--sem-ring)" ] .
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part "[data-sem-c=slider] > input:not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))::-webkit-slider-runnable-track" ;
    sty:declares [ sty:property "height" ; sty:raw "4px" ] .
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part "[data-sem-c=slider] > input:not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))::-moz-range-track" ;
    sty:declares [ sty:property "height" ; sty:raw "4px" ] .
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part "[data-sem-c=slider] > input:not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))::-webkit-slider-thumb" ;
    sty:declares [ sty:property "border" ; sty:raw "0" ] ,
                 [ sty:property "box-shadow" ; sty:raw "0 0 0 0.5px rgb(0 0 0 / 0.12), 0 1px 3px light-dark(rgb(0 0 0 / 0.3), rgb(0 0 0 / 0.6))" ] ,
                 [ sty:property "margin-top" ; sty:raw "calc((4px - var(--thumb)) / 2)" ] .
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part "[data-sem-c=slider] > input:not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))::-moz-range-thumb" ;
    sty:declares [ sty:property "border" ; sty:raw "0" ] ,
                 [ sty:property "box-shadow" ; sty:raw "0 0 0 0.5px rgb(0 0 0 / 0.12), 0 1px 3px light-dark(rgb(0 0 0 / 0.3), rgb(0 0 0 / 0.6))" ] .

# Cards, specimens and tables: hairline borders, no dotted stage, an accent selection.
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part ":is([data-sem-c=card], [data-sem-c=specimen], [data-sem-c=table], [data-sem-c=stat], [data-sem-c=accordion]):not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))" ;
    sty:declares [ sty:property "border-width" ; sty:raw "0.5px" ] ,
                 [ sty:property "border-color" ; sty:raw "var(--mac-hairline)" ] .
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part "[data-sem-c=specimen] > .sem-stage:not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "var(--sem-surface-sunken)" ] ,
                 [ sty:property "border" ; sty:raw "0.5px solid var(--mac-hairline)" ] .
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part "[data-sem-c=table] thead th:not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "var(--mac-glass-strong)" ] ,
                 [ sty:property "backdrop-filter" ; sty:raw "var(--mac-blur)" ] ,
                 [ sty:property "border-bottom" ; sty:raw "0.5px solid var(--mac-hairline)" ] ,
                 [ sty:property "color" ; sty:raw "var(--sem-muted)" ] ,
                 [ sty:property "font-weight" ; sty:raw "500" ] .
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part "[data-sem-c=table] tbody tr:hover:not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "var(--sem-accent-9)" ] ,
                 [ sty:property "color" ; sty:raw "#ffffff" ] .
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part "[data-sem-c=table] tbody tr:hover :is(td, th, code):not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))" ;
    sty:declares [ sty:property "color" ; sty:raw "inherit" ] .
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part "[data-sem-c=table] tbody :is(th, td):not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))" ;
    sty:declares [ sty:property "border-bottom" ; sty:raw "0" ] .
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part "[data-sem-c=tree] [aria-selected=\"true\"] > .sem-row:not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "var(--sem-accent-9)" ] ,
                 [ sty:property "border-radius" ; sty:raw "5px" ] .
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part "[data-sem-c=tree] [aria-selected=\"true\"] > .sem-row :is(.sem-label, .sem-count, .sem-twisty):not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))" ;
    sty:declares [ sty:property "color" ; sty:raw "#ffffff" ] .
[] a sty:StyleRule ; sty:when sty:Cupertino ;
    sty:part "[data-sem-c=metrics] .sem-metric:not(:where([data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]), [data-sem-theme=cupertino] [data-sem-theme]:not([data-sem-theme=cupertino]) *))" ;
    sty:declares [ sty:property "border" ; sty:raw "0" ] ,
                 [ sty:property "background" ; sty:raw "var(--mac-track)" ] ,
                 [ sty:property "border-radius" ; sty:raw "6px" ] .

# --- Tracker ---------------------------------------------------------------------------------
[] a sty:StyleRule ; sty:when sty:Tracker ;
    sty:declares [ sty:property "--bv-face" ; sty:raw "var(--sem-surface)" ] ,
                 [ sty:property "--bv-button" ; sty:raw "linear-gradient(180deg, light-dark(#f6f6f6, #4a4a50), light-dark(#d4d4d4, #36363b))" ] ,
                 [ sty:property "--bv-hi" ; sty:raw "light-dark(#ffffff, #6a6a72)" ] ,
                 [ sty:property "--bv-lite" ; sty:raw "light-dark(#f0f0f0, #4c4c52)" ] ,
                 [ sty:property "--bv-shade" ; sty:raw "light-dark(#9a9a9a, #232326)" ] ,
                 [ sty:property "--bv-dark" ; sty:raw "light-dark(#6c6c6c, #0c0c0e)" ] ,
                 [ sty:property "--bv-raised" ; sty:raw "inset 0 0 0 1px var(--bv-dark), inset 1px 1px 0 1px var(--bv-hi), inset -1px -1px 0 1px var(--bv-shade)" ] ,
                 [ sty:property "--bv-raised-inner" ; sty:raw "inset 0 0 0 2px var(--bv-dark), inset 1px 1px 0 2px var(--bv-hi), inset -1px -1px 0 2px var(--bv-shade)" ] ,
                 [ sty:property "--bv-sunken" ; sty:raw "inset 0 0 0 1px var(--bv-shade), inset 1px 1px 0 1px var(--bv-dark)" ] ,
                 [ sty:property "--bv-pressed" ; sty:raw "inset 0 0 0 1px var(--bv-dark), inset 1px 1px 0 1px var(--bv-shade), inset -1px -1px 0 1px var(--bv-lite)" ] ,

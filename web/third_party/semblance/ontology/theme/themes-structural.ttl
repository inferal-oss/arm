                 [ sty:property "align-items" ; sty:raw "center" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part ":is([data-sem-c=dialog], [data-sem-c=lightbox], [data-sem-c=drawer]) > .sem-panel > .sem-head h2:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "flex" ; sty:raw "1" ] ,
                 [ sty:property "color" ; sty:raw "var(--bv-title-fg)" ] ,
                 [ sty:property "font-size" ; sty:raw "13px" ] ,
                 [ sty:property "font-weight" ; sty:raw "700" ] ,
                 [ sty:property "letter-spacing" ; sty:raw "0" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part ":is([data-sem-c=dialog], [data-sem-c=lightbox], [data-sem-c=drawer], [data-sem-c=toast]) .sem-close:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "var(--bv-face)" ] ,
                 [ sty:property "color" ; sty:raw "var(--sem-text)" ] ,
                 [ sty:property "box-shadow" ; sty:raw "var(--bv-raised)" ] ,
                 [ sty:property "width" ; sty:raw "18px" ] ,
                 [ sty:property "height" ; sty:raw "16px" ] ,
                 [ sty:property "margin" ; sty:raw "0" ] ,
                 [ sty:property "font-size" ; sty:raw "10px" ] ,
                 [ sty:property "border-radius" ; sty:raw "0" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part ":is([data-sem-c=dialog], [data-sem-c=lightbox], [data-sem-c=drawer], [data-sem-c=toast]) .sem-close:active:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "box-shadow" ; sty:raw "var(--bv-pressed)" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part ":is([data-sem-c=dialog], [data-sem-c=lightbox], [data-sem-c=drawer]) > .sem-scrim:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "backdrop-filter" ; sty:raw "none" ] .

# Frames: a raised window border, the theme's caption bar, and square controls.
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part ":is([data-sem-c=window], [data-sem-c=palette]):not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "var(--bv-face)" ] ,
                 [ sty:property "border" ; sty:raw "0" ] ,
                 [ sty:property "box-shadow" ; sty:raw "var(--bv-raised), var(--sem-shadow-4)" ] ,
                 [ sty:property "padding" ; sty:raw "3px" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part ":is([data-sem-c=window], [data-sem-c=palette]) .sem-window-bar:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "var(--bv-title)" ] ,
                 [ sty:property "color" ; sty:raw "var(--bv-title-fg)" ] ,
                 [ sty:property "border-bottom" ; sty:raw "0" ] ,
                 [ sty:property "padding" ; sty:raw "2px 2px 2px 5px" ] ,
                 [ sty:property "gap" ; sty:raw "2px" ] ,
                 [ sty:property "min-height" ; sty:raw "20px" ] ,
                 [ sty:property "cursor" ; sty:raw "default" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part ":is([data-sem-c=window], [data-sem-c=palette]) .sem-window-bar strong:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "color" ; sty:raw "var(--bv-title-fg)" ] ,
                 [ sty:property "font-size" ; sty:raw "12px" ] ,
                 [ sty:property "font-weight" ; sty:raw "700" ] ,
                 [ sty:property "letter-spacing" ; sty:raw "0" ] ,
                 [ sty:property "text-transform" ; sty:raw "none" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part ":is([data-sem-c=window], [data-sem-c=palette]) .sem-window-control:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "var(--bv-face)" ] ,
                 [ sty:property "color" ; sty:raw "var(--sem-text)" ] ,
                 [ sty:property "box-shadow" ; sty:raw "var(--bv-raised)" ] ,
                 [ sty:property "width" ; sty:raw "17px" ] ,
                 [ sty:property "height" ; sty:raw "15px" ] ,
                 [ sty:property "font" ; sty:raw "700 10px/1 var(--sem-font)" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part ":is([data-sem-c=window], [data-sem-c=palette]) .sem-window-control:hover:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "var(--bv-face)" ] ,
                 [ sty:property "color" ; sty:raw "var(--sem-text)" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part ":is([data-sem-c=window], [data-sem-c=palette]) .sem-window-control:active:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "box-shadow" ; sty:raw "var(--bv-pressed)" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part ":is([data-sem-c=window], [data-sem-c=palette]) .sem-window-body:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "var(--bv-face)" ] .

# The taskbar: a raised strip of task buttons; the frame in front is the pushed-in one.
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part "[data-sem-c=taskbar]:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "var(--bv-face)" ] ,
                 [ sty:property "border" ; sty:raw "0" ] ,
                 [ sty:property "box-shadow" ; sty:raw "var(--bv-raised)" ] ,
                 [ sty:property "padding" ; sty:raw "3px" ] ,
                 [ sty:property "gap" ; sty:raw "3px" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part "[data-sem-c=taskbar] .sem-task:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "var(--bv-face)" ] ,
                 [ sty:property "color" ; sty:raw "var(--sem-text)" ] ,
                 [ sty:property "box-shadow" ; sty:raw "var(--bv-raised)" ] ,
                 [ sty:property "font-weight" ; sty:raw "400" ] ,
                 [ sty:property "min-width" ; sty:raw "110px" ] ,
                 [ sty:property "justify-content" ; sty:raw "flex-start" ] ,
                 [ sty:property "border-radius" ; sty:raw "0" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part "[data-sem-c=taskbar] .sem-task[aria-current=\"true\"]:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "var(--bv-dither)" ] ,
                 [ sty:property "box-shadow" ; sty:raw "var(--bv-pressed)" ] ,
                 [ sty:property "color" ; sty:raw "var(--sem-text)" ] ,
                 [ sty:property "font-weight" ; sty:raw "700" ] .

# The app bar is a toolbar and the status bar a strip of sunken panels.
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part "[data-sem-c=app-bar]:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "var(--bv-face)" ] ,
                 [ sty:property "backdrop-filter" ; sty:raw "none" ] ,
                 [ sty:property "border-bottom" ; sty:raw "0" ] ,
                 [ sty:property "box-shadow" ; sty:raw "inset 0 -1px 0 var(--bv-dark), inset 0 -2px 0 var(--bv-shade), inset 0 1px 0 var(--bv-hi)" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part "[data-sem-c=status-bar]:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "var(--bv-face)" ] ,
                 [ sty:property "backdrop-filter" ; sty:raw "none" ] ,
                 [ sty:property "border-top" ; sty:raw "0" ] ,
                 [ sty:property "box-shadow" ; sty:raw "inset 0 1px 0 var(--bv-hi), inset 0 2px 0 var(--bv-lite)" ] .

# Progress fills in blocks, in a sunken trough.
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part "[data-sem-c=progress] .sem-track:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "var(--sem-surface-sunken)" ] ,
                 [ sty:property "box-shadow" ; sty:raw "var(--bv-sunken)" ] ,
                 [ sty:property "padding" ; sty:raw "3px" ] ,
                 [ sty:property "height" ; sty:raw "18px" ] ,
                 [ sty:property "box-sizing" ; sty:raw "border-box" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part "[data-sem-c=progress] .sem-fill:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "repeating-linear-gradient(90deg, var(--bv-select-bg) 0 8px, transparent 8px 10px)" ] ,
                 [ sty:property "border-radius" ; sty:raw "0" ] .

# Badges and tags are flat labels with a one-pixel rule.
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part ":is([data-sem-c=badge], [data-sem-c=tag]):not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "border-width" ; sty:raw "1px" ] ,
                 [ sty:property "border-style" ; sty:raw "solid" ] .

# Caption buttons sit at the right: minimize and maximize together, close a step apart.
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part ":is([data-sem-c=window], [data-sem-c=palette]) .sem-window-control:is([data-sem-control=close]):not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "margin-inline-start" ; sty:raw "2px" ] .

# Small, crisp type on controls, as on a 640x480 screen.
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part ":is([data-sem-c=button], [data-sem-c=menu], :is([data-sem-c=segmented], [data-sem-c=theme-switcher]) button, [data-sem-c=tabs] [role=tab], :is([data-sem-c=nav-list] button, [data-sem-c=nav-link]), [data-sem-c=menu-item], [data-sem-c=chips] button, [data-sem-c=taskbar] .sem-task):not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "font-size" ; sty:raw "13px" ] ,
                 [ sty:property "letter-spacing" ; sty:raw "0" ] .

# The taskbar on the desktop runs along the bottom of the screen.
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part "[data-sem-c=desktop] > [data-sem-c=taskbar]:not([data-sem-edge]):not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "left" ; sty:raw "0" ] ,
                 [ sty:property "right" ; sty:raw "0" ] ,
                 [ sty:property "translate" ; sty:raw "none" ] ,
                 [ sty:property "max-width" ; sty:raw "none" ] ,
                 [ sty:property "inset-block-end" ; sty:raw "0" ] ,
                 [ sty:property "flex-wrap" ; sty:raw "nowrap" ] ,
                 [ sty:property "z-index" ; sty:raw "56" ] .
# Where the theme puts it (along the bottom) it owns that edge, as if docked there.
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:state ":has(> [data-sem-c=desktop] > [data-sem-c=taskbar]:not([data-sem-edge], [hidden]))" ;
    sty:declares [ sty:property "box-sizing" ; sty:raw "border-box" ] ,
                 [ sty:property "--sem-dock-bottom" ; sty:raw "var(--sem-taskbar-size)" ] ,
                 [ sty:property "padding-block-end" ; sty:raw "var(--sem-dock-bottom)" ] .

# The brand in the app bar wears the caption gradient.
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part "[data-sem-c=app-bar] .sem-brand:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "var(--bv-title)" ] ,
                 [ sty:property "color" ; sty:raw "var(--bv-title-fg)" ] ,
                 [ sty:property "padding" ; sty:raw "3px 10px 3px 4px" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part "[data-sem-c=app-bar] .sem-brand span:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "color" ; sty:raw "#e4e4f0" ] .

# --- Doodle ----------------------------------------------------------------------------------
[] a sty:StyleRule ; sty:when sty:Doodle ;
    sty:declares [ sty:property "--ink" ; sty:raw "var(--sem-border-strong)" ] ,
                 [ sty:property "--hl" ; sty:raw "light-dark(rgb(255 214 0 / 0.55), rgb(255 216 102 / 0.3))" ] ,
                 [ sty:property "--hl-strong" ; sty:raw "light-dark(rgb(255 214 0 / 0.85), rgb(255 216 102 / 0.5))" ] ,
                 [ sty:property "--wob-a" ; sty:raw "255px 15px 225px 15px / 15px 225px 15px 255px" ] ,
                 [ sty:property "--wob-b" ; sty:raw "15px 255px 15px 225px / 225px 15px 255px 15px" ] ,
                 [ sty:property "--wob-c" ; sty:raw "125px 10px 20px 185px / 25px 205px 205px 25px" ] ,
                 [ sty:property "--wob-o" ; sty:raw "52% 48% 55% 45% / 47% 55% 45% 53%" ] ,
                 [ sty:property "--s-focus" ; sty:raw "2px dashed var(--sem-accent)" ] ,
                 [ sty:property "scrollbar-color" ; sty:raw "var(--ink) transparent" ] .

# Everything with an edge is inked: two-pixel strokes on wobbly corners (elliptical radii that
# never agree), a pencil shadow offset down and right, and a tilt when the pointer is over it.
[] a sty:StyleRule ; sty:when sty:Doodle ;
    sty:part ":is([data-sem-c=button], [data-sem-c=run-query-button], [data-sem-c=icon-button], [data-sem-c=toggle], [data-sem-c=menu], [data-sem-c=popover] > .sem-trigger, [data-sem-c=chips] button, [data-sem-c=gallery] > .sem-controls > :is(.sem-prev, .sem-next), [data-sem-c=lightbox] > .sem-panel :is(.sem-zoom, .sem-original, .sem-stage > .sem-prev, .sem-stage > .sem-next), [data-sem-c=pagination] button, [data-sem-c=choice], [data-sem-c=flippable] .sem-flip):not([data-sem-emphasis=ghost]):not(:where([data-sem-theme=doodle] [data-sem-theme]:not([data-sem-theme=doodle]), [data-sem-theme=doodle] [data-sem-theme]:not([data-sem-theme=doodle]) *))" ;
    sty:declares [ sty:property "border-width" ; sty:raw "2px" ] ,

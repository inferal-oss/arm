        [ sty:property "--sem-gray-10" ; sty:raw "light-dark(#776e57, #84978c)" ] ,
        [ sty:property "--sem-gray-11" ; sty:raw "light-dark(#4f4838, #c0c8bf)" ] ,
        [ sty:property "--sem-gray-12" ; sty:raw "light-dark(#1b2340, #f1f0e8)" ] ,
        # accent ramp
        [ sty:property "--sem-accent-1" ; sty:raw "light-dark(#fafbff, #22261a)" ] ,
        [ sty:property "--sem-accent-2" ; sty:raw "light-dark(#f1f4ff, #2a2f1c)" ] ,
        [ sty:property "--sem-accent-3" ; sty:raw "light-dark(#e4eaff, #38391e)" ] ,
        [ sty:property "--sem-accent-4" ; sty:raw "light-dark(#d5ddff, #43431f)" ] ,
        [ sty:property "--sem-accent-5" ; sty:raw "light-dark(#c3cffc, #4f4d22)" ] ,
        [ sty:property "--sem-accent-6" ; sty:raw "light-dark(#acbdf7, #5f5c27)" ] ,
        [ sty:property "--sem-accent-7" ; sty:raw "light-dark(#8ea3f0, #787331)" ] ,
        [ sty:property "--sem-accent-8" ; sty:raw "light-dark(#6481e6, #9a943f)" ] ,
        [ sty:property "--sem-accent-9" ; sty:raw "light-dark(#1d4ed8, #ffd866)" ] ,
        [ sty:property "--sem-accent-10" ; sty:raw "light-dark(#1a43bb, #ffe28a)" ] ,
        [ sty:property "--sem-accent-11" ; sty:raw "light-dark(#1d4ed8, #ffe28a)" ] ,
        [ sty:property "--sem-accent-12" ; sty:raw "light-dark(#0c1f5c, #fff4cc)" ] ,
        # status
        [ sty:property "--sem-info-3" ; sty:raw "light-dark(#e4eaff, #1e2b3a)" ] ,
        [ sty:property "--sem-info-4" ; sty:raw "light-dark(#d5ddff, #223246)" ] ,
        [ sty:property "--sem-info-6" ; sty:raw "light-dark(#acbdf7, #2e4a66)" ] ,
        [ sty:property "--sem-info-9" ; sty:raw "light-dark(#1f5fbf, #8ab4f8)" ] ,
        [ sty:property "--sem-info-10" ; sty:raw "light-dark(#1a52a5, #a6c6fa)" ] ,
        [ sty:property "--sem-info-11" ; sty:raw "light-dark(#1a4fa0, #a6c6fa)" ] ,
        [ sty:property "--sem-success-3" ; sty:raw "light-dark(#e3f3e1, #1f3322)" ] ,
        [ sty:property "--sem-success-4" ; sty:raw "light-dark(#d3ecd0, #243c27)" ] ,
        [ sty:property "--sem-success-6" ; sty:raw "light-dark(#a8d8a2, #335a37)" ] ,
        [ sty:property "--sem-success-9" ; sty:raw "light-dark(#2e7d32, #8fd694)" ] ,
        [ sty:property "--sem-success-10" ; sty:raw "light-dark(#276b2b, #a8e2ac)" ] ,
        [ sty:property "--sem-success-11" ; sty:raw "light-dark(#24652a, #a8e2ac)" ] ,
        [ sty:property "--sem-warning-3" ; sty:raw "light-dark(#fff3c4, #3a3418)" ] ,
        [ sty:property "--sem-warning-4" ; sty:raw "light-dark(#ffeba1, #45401a)" ] ,
        [ sty:property "--sem-warning-6" ; sty:raw "light-dark(#f0d070, #6b6224)" ] ,
        [ sty:property "--sem-warning-9" ; sty:raw "light-dark(#f2b705, #ffd866)" ] ,

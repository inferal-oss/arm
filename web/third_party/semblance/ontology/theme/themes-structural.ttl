                 [ sty:property "box-shadow" ; sty:raw "none" ] .

# Text fields: a hairline box with a darker bottom stroke that turns into a two-pixel accent
# underline while focused; combo boxes look like buttons.
[] a sty:StyleRule ; sty:when sty:Fluent ;
    sty:part ":is([data-sem-c=text-field] input, [data-sem-c=shape-field] :is(input:not([type=checkbox]), select, textarea), [data-sem-c=text-area] > textarea):not(:where([data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]), [data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]) *))" ;
    sty:declares [ sty:property "background-color" ; sty:raw "var(--fl-fill)" ] ,
                 [ sty:property "border" ; sty:raw "1px solid var(--fl-stroke)" ] ,
                 [ sty:property "border-bottom-color" ; sty:raw "var(--fl-stroke-strong)" ] ,
                 [ sty:property "border-radius" ; sty:raw "4px" ] ,
                 [ sty:property "box-shadow" ; sty:raw "none" ] ,
                 [ sty:property "padding" ; sty:raw "6px 11px" ] .
# A select padded all round keeps room for its chevron.
[] a sty:StyleRule ; sty:when sty:Fluent ;
    sty:part "[data-sem-c=shape-field] select:not([multiple]):not([size]):not(:where([data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]), [data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]) *))" ;
    sty:declares [ sty:property "padding-inline-end" ; sty:raw "var(--sem-chevron-space)" ] .
[] a sty:StyleRule ; sty:when sty:Fluent ;
    sty:part ":is([data-sem-c=text-field] input, [data-sem-c=shape-field] :is(input:not([type=checkbox]), select, textarea), [data-sem-c=text-area] > textarea):not(:disabled):hover:not(:where([data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]), [data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]) *))" ;
    sty:declares [ sty:property "background-color" ; sty:raw "var(--fl-fill-hover)" ] ,
                 [ sty:property "border-color" ; sty:raw "var(--fl-stroke)" ] ,
                 [ sty:property "border-bottom-color" ; sty:raw "var(--fl-stroke-strong)" ] .
[] a sty:StyleRule ; sty:when sty:Fluent ;

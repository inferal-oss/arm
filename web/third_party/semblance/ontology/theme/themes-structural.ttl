                 [ sty:property "box-shadow" ; sty:raw "inset 1px 1px 0 var(--bv-hi), inset -1px 0 0 var(--bv-dark), inset -2px 0 0 var(--bv-shade), inset 2px 2px 0 var(--bv-lite)" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part "[data-sem-c=tabs] [role=tab][aria-selected=true]:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "margin-top" ; sty:raw "0" ] ,
                 [ sty:property "padding-bottom" ; sty:raw "5px" ] ,
                 [ sty:property "margin-bottom" ; sty:raw "-2px" ] ,
                 [ sty:property "position" ; sty:raw "relative" ] ,
                 [ sty:property "z-index" ; sty:raw "2" ] ,
                 [ sty:property "margin-inline" ; sty:raw "-2px" ] ,
                 [ sty:property "background" ; sty:raw "var(--bv-face)" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part "[data-sem-c=tabs] > [role=tabpanel]:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;

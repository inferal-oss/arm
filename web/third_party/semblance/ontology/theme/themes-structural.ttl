sty:Fluent a sty:Theme ; sem:slug "fluent" ; sem:order 10 ; sem:symbol "◫" ;
    rdfs:label "Fluent"@en , "Флюент"@uk , "Fluent"@de , "فلوينت"@ar ;
    rdfs:comment "Today's desktop (Windows 11-ish): a Mica-tinted canvas, Acrylic flyouts, menus and toasts, Segoe UI Variable, four-pixel controls and eight-pixel windows and flyouts, hairline strokes with a darker bottom edge, a two-pixel accent underline on the focused field, an accent pill on the selected tab, segment and navigation item, pill switches whose knob grows on hover, wide flat caption buttons with a red close, soft layered shadows and a centred taskbar with an accent dash under the active window. Light and dark."@en ;
    sty:declares
        # neutral ramp
        [ sty:property "--sem-gray-1" ; sty:raw "light-dark(#ffffff, #1c1c1c)" ] ,

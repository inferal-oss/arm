@prefix sem: <https://semblance.dev/ns/core#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Structural themes: five more values of sty:theme that change how things are built, not only
# their colours. Each is a sty:Theme like those in themes.ttl, restating the same token set
# (ramps, roles, type, radii, shadows, easing, marks, backdrop: see the header of themes.ttl),
# and adds sty:StyleRules narrowed by sty:when to that theme:
#
#   Cupertino  a desktop of glass and hairlines (macOS-ish): traffic lights on the left of a
#              unified title bar with the title centred, segmented controls and tabs as raised
#              keys in a recessed track, vibrant menus, a dock.
#   Tracker    grey bevelled panels under yellow tabs (BeOS-ish): a frame's title is a tab as wide
#              as its title on the frame's top-left edge, with a close box and a zoom box; slanted
#              tabs; a Deskbar at the top right.
#   Classic    silver faces and two-pixel bevels (Windows 95-ish): navy caption bars, square caption
#              buttons on the right, sunken white fields, pushed-in toggles, a taskbar along the
#              bottom; no corners, no easing.
#   Fluent     today's desktop (Windows 11-ish): Mica and Acrylic, hairline strokes with a darker
#              bottom edge, an accent underline on the focused field, an accent pill on whatever is
#              selected, wide flat caption buttons on the right with a red close, a centred taskbar.
#   Doodle     drawn by hand: inked strokes on wobbly corners, a marker for titles, highlighter for
#              choices, paper notes and tape, ruled paper by day and a blackboard by night.
#
# How the rules are written. A theme is set on an ancestor (the shell, or a c:Surface), so a rule
# for what is inside it has no sty:appliesTo; its sty:part begins with the component:
#
#   [] a sty:StyleRule ; sty:when sty:Classic ; sty:part "[data-sem-c=window] .sem-window-bar…" ; …
#
# compiles to [data-sem-theme="classic"] [data-sem-c=window] .sem-window-bar… in the variants layer,
# which wins over every component's own rule. Values come from the theme's tokens or from custom
# properties the theme sets on its own element (a rule with sty:when and no part: --bv-* for the
# bevel kit Classic and Tracker share, --mac-* for Cupertino, --ink / --hl / --wob-* for Doodle).
#
# Descendant rules would leak into a differently themed subtree below (a Paper card on a Classic
# desktop), so every part ends with a guard on its subject,
#   :not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]),
#               [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))
# "not inside, nor itself, another theme below this one". :where() keeps its specificity at zero.
#
# A few rules must win over intent rules (the default button's look), and the intents layer comes
# after the variants: those name the class and intent, and scope themselves with a state,
# :where([data-sem-theme=classic] *) plus the guard.
#
# Window controls are found by the control they are (data-sem-control: close, minimize, maximize,
# restore, dock, undock), so a theme can reorder and recolour them.
#
# Contrast and motion keep winning: high contrast restates the role tokens on top of each theme
# (below, and in themes.ttl for nested subtrees) and makes the focus outline heavy; every
# transition and animation here reads the duration tokens, which the motion preference zeroes.

# --- the themes ------------------------------------------------------------------------

sty:Cupertino a sty:Theme ; sem:slug "cupertino" ; sem:order 6 ; sem:symbol "⌘" ;
    rdfs:label "Cupertino"@en , "Купертіно"@uk , "Cupertino"@de , "كوبرتينو"@ar ;
    rdfs:comment "A desktop of glass and hairlines (macOS-ish): the system font, translucent vibrant menus and sidebars, traffic lights at the left of a unified title bar with a centred title, segmented controls and tabs as raised keys in a recessed track, a blue accent, soft wide shadows, ten-pixel windows and a dock. Light and dark."@en ;
    sty:declares
        # neutral ramp
        [ sty:property "--sem-gray-1" ; sty:raw "light-dark(#fcfcfc, #161618)" ] ,
        [ sty:property "--sem-gray-2" ; sty:raw "light-dark(#f6f6f6, #1c1c1e)" ] ,
        [ sty:property "--sem-gray-3" ; sty:raw "light-dark(#efefef, #232325)" ] ,
        [ sty:property "--sem-gray-4" ; sty:raw "light-dark(#e8e8e8, #2c2c2e)" ] ,
        [ sty:property "--sem-gray-5" ; sty:raw "light-dark(#e1e1e1, #333336)" ] ,
        [ sty:property "--sem-gray-6" ; sty:raw "light-dark(#d8d8d8, #3a3a3c)" ] ,
        [ sty:property "--sem-gray-7" ; sty:raw "light-dark(#cbcbcb, #48484a)" ] ,
        [ sty:property "--sem-gray-8" ; sty:raw "light-dark(#b3b3b3, #636366)" ] ,
        [ sty:property "--sem-gray-9" ; sty:raw "light-dark(#8e8e93, #737378)" ] ,
        [ sty:property "--sem-gray-10" ; sty:raw "light-dark(#838388, #7c7c80)" ] ,
        [ sty:property "--sem-gray-11" ; sty:raw "light-dark(#636366, #aeaeb2)" ] ,
        [ sty:property "--sem-gray-12" ; sty:raw "light-dark(#1d1d1f, #f5f5f7)" ] ,
        # accent ramp
        [ sty:property "--sem-accent-1" ; sty:raw "light-dark(#fbfdff, #0b1320)" ] ,
        [ sty:property "--sem-accent-2" ; sty:raw "light-dark(#f2f8ff, #0f1a2b)" ] ,
        [ sty:property "--sem-accent-3" ; sty:raw "light-dark(#e6f1ff, #10243f)" ] ,
        [ sty:property "--sem-accent-4" ; sty:raw "light-dark(#d6e8ff, #122d52)" ] ,
        [ sty:property "--sem-accent-5" ; sty:raw "light-dark(#c4ddff, #153763)" ] ,
        [ sty:property "--sem-accent-6" ; sty:raw "light-dark(#add0ff, #1a4277)" ] ,
        [ sty:property "--sem-accent-7" ; sty:raw "light-dark(#8fbcff, #1f5294)" ] ,
        [ sty:property "--sem-accent-8" ; sty:raw "light-dark(#64a2fb, #2766b8)" ] ,
        [ sty:property "--sem-accent-9" ; sty:raw "light-dark(#006ee6, #0a6fdc)" ] ,

    sty:declares [ sty:property "background" ; sty:raw "var(--bv-select-bg)" ] ,
                 [ sty:property "color" ; sty:raw "var(--bv-select-fg)" ] ,
                 [ sty:property "box-shadow" ; sty:raw "none" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part "[data-sem-c=menu-item]:not(:disabled):is(:hover, :focus-visible) .sem-icon:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "color" ; sty:raw "inherit" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part "[data-sem-c=menu-item]:disabled:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "opacity" ; sty:raw "1" ] ,
                 [ sty:property "color" ; sty:raw "var(--sem-faint)" ] ,

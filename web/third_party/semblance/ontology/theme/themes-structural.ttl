        [ sty:property "--sem-text" ; sty:raw "light-dark(#1d1d1f, #f5f5f7)" ] ,
        [ sty:property "--sem-muted" ; sty:raw "light-dark(#636366, #a1a1a6)" ] ,
        [ sty:property "--sem-faint" ; sty:raw "light-dark(#a1a1a6, #6e6e73)" ] ,
        [ sty:property "--sem-border" ; sty:raw "light-dark(#e3e3e3, #38383a)" ] ,
        [ sty:property "--sem-border-strong" ; sty:raw "light-dark(#c8c8c8, #4a4a4c)" ] ,
        [ sty:property "--sem-accent" ; sty:raw "light-dark(#0058b8, #4ea4ff)" ] ,
        [ sty:property "--sem-accent-strong" ; sty:raw "light-dark(#004a9c, #7cbcff)" ] ,
        [ sty:property "--sem-accent-soft" ; sty:raw "color-mix(in srgb, var(--sem-accent) 14%, transparent)" ] ,
        [ sty:property "--sem-on-accent" ; sty:raw "light-dark(#ffffff, #0b0b0d)" ] ,
        [ sty:property "--sem-accent-contrast" ; sty:raw "#ffffff" ] ,
        [ sty:property "--sem-on-status" ; sty:raw "#ffffff" ] ,

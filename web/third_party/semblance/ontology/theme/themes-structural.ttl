# The Deskbar stands upright: its grip is a row of dots on top.
[] a sty:StyleRule ; sty:when sty:Tracker ;
    sty:part "[data-sem-c=desktop] > [data-sem-c=taskbar]:not([data-sem-edge]) > .sem-grip:not(:where([data-sem-theme=tracker] [data-sem-theme]:not([data-sem-theme=tracker]), [data-sem-theme=tracker] [data-sem-theme]:not([data-sem-theme=tracker]) *))" ;
    sty:declares [ sty:property "width" ; sty:raw "auto" ] ,
                 [ sty:property "min-height" ; sty:raw "0" ] ,
                 [ sty:property "height" ; sty:raw "14px" ] ,
                 [ sty:property "padding" ; sty:raw "2px 4px" ] .

# --- Classic ---------------------------------------------------------------------------------
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:declares [ sty:property "--bv-face" ; sty:raw "var(--sem-surface)" ] ,
                 [ sty:property "--bv-button" ; sty:raw "var(--sem-surface)" ] ,
                 [ sty:property "--bv-hi" ; sty:raw "light-dark(#ffffff, #7a7a86)" ] ,
                 [ sty:property "--bv-lite" ; sty:raw "light-dark(#dfdfdf, #56565f)" ] ,
                 [ sty:property "--bv-shade" ; sty:raw "light-dark(#808080, #24242a)" ] ,
                 [ sty:property "--bv-dark" ; sty:raw "light-dark(#0a0a0a, #000000)" ] ,
                 [ sty:property "--bv-raised" ; sty:raw "inset -1px -1px 0 var(--bv-dark), inset 1px 1px 0 var(--bv-hi), inset -2px -2px 0 var(--bv-shade), inset 2px 2px 0 var(--bv-lite)" ] ,
                 [ sty:property "--bv-raised-inner" ; sty:raw "inset -2px -2px 0 var(--bv-dark), inset 2px 2px 0 var(--bv-hi), inset -3px -3px 0 var(--bv-shade), inset 3px 3px 0 var(--bv-lite)" ] ,
                 [ sty:property "--bv-sunken" ; sty:raw "inset -1px -1px 0 var(--bv-hi), inset 1px 1px 0 var(--bv-shade), inset -2px -2px 0 var(--bv-lite), inset 2px 2px 0 var(--bv-dark)" ] ,
                 [ sty:property "--bv-pressed" ; sty:raw "inset -1px -1px 0 var(--bv-hi), inset 1px 1px 0 var(--bv-dark), inset -2px -2px 0 var(--bv-lite), inset 2px 2px 0 var(--bv-shade)" ] ,
                 [ sty:property "--bv-pressed-inner" ; sty:raw "inset -2px -2px 0 var(--bv-hi), inset 2px 2px 0 var(--bv-dark), inset -3px -3px 0 var(--bv-lite), inset 3px 3px 0 var(--bv-shade)" ] ,
                 [ sty:property "--bv-thin-raised" ; sty:raw "inset -1px -1px 0 var(--bv-shade), inset 1px 1px 0 var(--bv-hi)" ] ,
                 [ sty:property "--bv-thin-sunken" ; sty:raw "inset -1px -1px 0 var(--bv-hi), inset 1px 1px 0 var(--bv-shade)" ] ,
                 [ sty:property "--bv-etched" ; sty:raw "inset 1px 1px 0 var(--bv-shade), inset -1px -1px 0 var(--bv-hi), inset 2px 2px 0 var(--bv-hi), inset -2px -2px 0 var(--bv-shade)" ] ,
                 [ sty:property "--bv-dither" ; sty:raw "repeating-conic-gradient(var(--bv-hi) 0 25%, var(--bv-face) 0 50%) 0 0 / 2px 2px" ] ,
                 [ sty:property "--bv-title" ; sty:raw "linear-gradient(90deg, light-dark(#000080, #1c1c64), light-dark(#1060b0, #2c5a9c))" ] ,
                 [ sty:property "--bv-title-fg" ; sty:raw "#ffffff" ] ,
                 [ sty:property "--bv-select-bg" ; sty:raw "light-dark(#000080, #2f4fa0)" ] ,
                 [ sty:property "--bv-select-fg" ; sty:raw "#ffffff" ] ,
                 [ sty:property "--bv-default-bg" ; sty:raw "var(--sem-surface)" ] ,
                 [ sty:property "--bv-default-fg" ; sty:raw "var(--sem-text)" ] ,
                 [ sty:property "--s-focus" ; sty:raw "1px dotted currentColor" ] ,
                 [ sty:property "--s-focus-offset" ; sty:raw "-4px" ] ,
                 [ sty:property "font-size" ; sty:raw "14px" ] .

# Square corners everywhere (a few round things are put back below), and the theme's own
# scrollbars: a dithered trough and a raised thumb.
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part "*:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "border-radius" ; sty:raw "0" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part "*:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))::-webkit-scrollbar" ;
    sty:declares [ sty:property "width" ; sty:raw "16px" ] ,
                 [ sty:property "height" ; sty:raw "16px" ] ,
                 [ sty:property "background" ; sty:raw "var(--bv-dither)" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part "*:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))::-webkit-scrollbar-thumb" ;
    sty:declares [ sty:property "background" ; sty:raw "var(--bv-face)" ] ,
                 [ sty:property "box-shadow" ; sty:raw "var(--bv-raised)" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part "*:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))::-webkit-scrollbar-corner" ;
    sty:declares [ sty:property "background" ; sty:raw "var(--bv-face)" ] .

# Focus is a dotted rectangle inside the control (a ring outside it on fields and boxes);
# --s-focus is restated by high contrast.
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part ":is(button, summary, a[href], [role=tab], [tabindex]:not([tabindex=\"-1\"])):focus-visible:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "outline" ; sty:raw "var(--s-focus)" ] ,
                 [ sty:property "outline-offset" ; sty:raw "var(--s-focus-offset)" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part ":is(input, select, textarea, [data-sem-c=table], [data-sem-c=tree] .sem-label):focus-visible:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "outline" ; sty:raw "var(--s-focus)" ] ,
                 [ sty:property "outline-offset" ; sty:raw "1px" ] .

# Push buttons: a raised face; pressed, open or on, the bevel turns inside out.
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part ":is([data-sem-c=button], [data-sem-c=run-query-button], [data-sem-c=icon-button], [data-sem-c=toggle], [data-sem-c=menu], [data-sem-c=chips] button, [data-sem-c=gallery] > .sem-controls > :is(.sem-prev, .sem-next), [data-sem-c=lightbox] > .sem-panel :is(.sem-zoom, .sem-original, .sem-stage > .sem-prev, .sem-stage > .sem-next), [data-sem-c=pagination] button, [data-sem-c=popover] > .sem-trigger, [data-sem-c=flippable] .sem-flip, [data-sem-c=specimen] > .sem-docs > .sem-docs-toggle, [data-sem-c=status-bar] > .sem-fold):not([data-sem-emphasis=ghost]):not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "border" ; sty:raw "0" ] ,
                 [ sty:property "box-shadow" ; sty:raw "var(--bv-raised)" ] ,
                 [ sty:property "border-radius" ; sty:raw "0" ] ,
                 [ sty:property "font-family" ; sty:raw "var(--sem-font)" ] ,
                 [ sty:property "text-shadow" ; sty:raw "none" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part ":is([data-sem-c=button], [data-sem-c=run-query-button], [data-sem-c=icon-button], [data-sem-c=toggle], [data-sem-c=menu], [data-sem-c=chips] button, [data-sem-c=gallery] > .sem-controls > :is(.sem-prev, .sem-next), [data-sem-c=lightbox] > .sem-panel :is(.sem-zoom, .sem-original, .sem-stage > .sem-prev, .sem-stage > .sem-next), [data-sem-c=pagination] button, [data-sem-c=popover] > .sem-trigger, [data-sem-c=flippable] .sem-flip, [data-sem-c=specimen] > .sem-docs > .sem-docs-toggle, [data-sem-c=status-bar] > .sem-fold):not([data-sem-emphasis=ghost]):not([data-sem-emphasis], [data-sem-tone]):not([data-sem-intent], [aria-current=page]):not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "var(--bv-button)" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part "[data-sem-c=gallery] > .sem-controls > :is(.sem-prev, .sem-next), [data-sem-c=lightbox] > .sem-panel :is(.sem-zoom, .sem-original, .sem-stage > .sem-prev, .sem-stage > .sem-next), [data-sem-c=pagination] button[aria-current=page]:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "box-shadow" ; sty:raw "var(--bv-pressed)" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part ":is([data-sem-c=button], [data-sem-c=run-query-button], [data-sem-c=icon-button], [data-sem-c=toggle], [data-sem-c=menu], [data-sem-c=chips] button, [data-sem-c=gallery] > .sem-controls > :is(.sem-prev, .sem-next), [data-sem-c=lightbox] > .sem-panel :is(.sem-zoom, .sem-original, .sem-stage > .sem-prev, .sem-stage > .sem-next), [data-sem-c=pagination] button, [data-sem-c=popover] > .sem-trigger, [data-sem-c=flippable] .sem-flip, [data-sem-c=specimen] > .sem-docs > .sem-docs-toggle, [data-sem-c=status-bar] > .sem-fold):not([data-sem-emphasis=ghost]):is(:active, [aria-pressed=true], [aria-expanded=true], [data-open]):not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "box-shadow" ; sty:raw "var(--bv-pressed)" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part ":is([data-sem-c=button], [data-sem-c=run-query-button], [data-sem-c=icon-button], [data-sem-c=toggle], [data-sem-c=menu], [data-sem-c=chips] button, [data-sem-c=gallery] > .sem-controls > :is(.sem-prev, .sem-next), [data-sem-c=lightbox] > .sem-panel :is(.sem-zoom, .sem-original, .sem-stage > .sem-prev, .sem-stage > .sem-next), [data-sem-c=pagination] button, [data-sem-c=popover] > .sem-trigger, [data-sem-c=flippable] .sem-flip, [data-sem-c=specimen] > .sem-docs > .sem-docs-toggle, [data-sem-c=status-bar] > .sem-fold):not([data-sem-emphasis=ghost]):not([data-sem-emphasis], [data-sem-tone]):not([data-sem-intent]):is([aria-pressed=true], [data-open]):not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "var(--bv-dither)" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part ":is([data-sem-c=button], [data-sem-c=run-query-button], [data-sem-c=icon-button], [data-sem-c=toggle], [data-sem-c=menu], [data-sem-c=chips] button, [data-sem-c=gallery] > .sem-controls > :is(.sem-prev, .sem-next), [data-sem-c=lightbox] > .sem-panel :is(.sem-zoom, .sem-original, .sem-stage > .sem-prev, .sem-stage > .sem-next), [data-sem-c=pagination] button, [data-sem-c=popover] > .sem-trigger, [data-sem-c=flippable] .sem-flip, [data-sem-c=specimen] > .sem-docs > .sem-docs-toggle, [data-sem-c=status-bar] > .sem-fold):not([data-sem-emphasis=ghost]):disabled:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "color" ; sty:raw "var(--sem-faint)" ] ,
                 [ sty:property "opacity" ; sty:raw "1" ] ,
                 [ sty:property "text-shadow" ; sty:raw "1px 1px 0 var(--bv-hi)" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part ":is([data-sem-c=button], [data-sem-c=run-query-button], [data-sem-c=icon-button], [data-sem-c=toggle], [data-sem-c=menu], [data-sem-c=chips] button, [data-sem-c=gallery] > .sem-controls > :is(.sem-prev, .sem-next), [data-sem-c=lightbox] > .sem-panel :is(.sem-zoom, .sem-original, .sem-stage > .sem-prev, .sem-stage > .sem-next), [data-sem-c=pagination] button, [data-sem-c=popover] > .sem-trigger, [data-sem-c=flippable] .sem-flip, [data-sem-c=specimen] > .sem-docs > .sem-docs-toggle, [data-sem-c=status-bar] > .sem-fold)[data-sem-emphasis=ghost]:not(:disabled):hover:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "transparent" ] ,
                 [ sty:property "box-shadow" ; sty:raw "var(--bv-thin-raised)" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part ":is([data-sem-c=button], [data-sem-c=run-query-button], [data-sem-c=icon-button], [data-sem-c=toggle], [data-sem-c=menu], [data-sem-c=chips] button, [data-sem-c=gallery] > .sem-controls > :is(.sem-prev, .sem-next), [data-sem-c=lightbox] > .sem-panel :is(.sem-zoom, .sem-original, .sem-stage > .sem-prev, .sem-stage > .sem-next), [data-sem-c=pagination] button, [data-sem-c=popover] > .sem-trigger, [data-sem-c=flippable] .sem-flip, [data-sem-c=specimen] > .sem-docs > .sem-docs-toggle, [data-sem-c=status-bar] > .sem-fold)[data-sem-emphasis=ghost]:not(:disabled):active:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "box-shadow" ; sty:raw "var(--bv-thin-sunken)" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part "[data-sem-c=menu] > button:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "box-shadow" ; sty:raw "none" ] ,
                 [ sty:property "background" ; sty:raw "transparent" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part "[data-sem-c=button-group]:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "box-shadow" ; sty:raw "none" ] ,
                 [ sty:property "gap" ; sty:raw "0" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part "[data-sem-c=button-group] > [data-sem-c]:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "margin-inline-start" ; sty:raw "0" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part "[data-sem-c=tag] > :is(.sem-tag-toggle, .sem-remove):not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "border-radius" ; sty:raw "0" ] .

# The default action wears a dark frame around its bevel (an intent rule: intents win over variants).
[] a sty:StyleRule ; sty:appliesTo c:Button ; sty:intent sty:Primary ;
    sty:state ":where([data-sem-theme=classic] *):not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "var(--bv-default-bg)" ] ,
                 [ sty:property "color" ; sty:raw "var(--bv-default-fg)" ] ,
                 [ sty:property "border" ; sty:raw "0" ] ,
                 [ sty:property "box-shadow" ; sty:raw "inset 0 0 0 1px var(--bv-dark), var(--bv-raised-inner)" ] ,
                 [ sty:property "text-shadow" ; sty:raw "none" ] .
[] a sty:StyleRule ; sty:appliesTo c:Button ; sty:intent sty:Primary ;
    sty:state ":where([data-sem-theme=classic] *):not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *)):hover" ;
    sty:declares [ sty:property "background" ; sty:raw "var(--bv-default-bg)" ] ,
                 [ sty:property "border-color" ; sty:raw "transparent" ] .
[] a sty:StyleRule ; sty:appliesTo c:Button ; sty:intent sty:Primary ;
    sty:state ":where([data-sem-theme=classic] *):not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *)):active" ;
    sty:declares [ sty:property "box-shadow" ; sty:raw "inset 0 0 0 1px var(--bv-dark), var(--bv-pressed-inner)" ] .
[] a sty:StyleRule ; sty:appliesTo c:Button ; sty:intent sty:Secondary ;
    sty:state ":where([data-sem-theme=classic] *):not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "box-shadow" ; sty:raw "none" ] ,
                 [ sty:property "background" ; sty:raw "transparent" ] .

# Fields are wells: white (or ink, by night), sunken two pixels.
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part ":is([data-sem-c=text-field] input, [data-sem-c=shape-field] :is(input:not([type=checkbox]), select, textarea), [data-sem-c=text-area] > textarea, [data-sem-c=choice] select, [data-sem-c=slider] > .sem-head > .sem-value, [data-sem-c=query-editor] .sem-scroll, [data-sem-c=code-editor] .sem-scroll):not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "background-color" ; sty:raw "var(--sem-surface-sunken)" ] ,
                 [ sty:property "border" ; sty:raw "0" ] ,
                 [ sty:property "box-shadow" ; sty:raw "var(--bv-sunken)" ] ,
                 [ sty:property "border-radius" ; sty:raw "0" ] ,
                 [ sty:property "color" ; sty:raw "var(--sem-text)" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part "[data-sem-c=choice]:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "transparent" ] ,
                 [ sty:property "border" ; sty:raw "0" ] ,
                 [ sty:property "box-shadow" ; sty:raw "none" ] ,
                 [ sty:property "padding-inline-start" ; sty:raw "0" ] ,
                 [ sty:property "padding-block" ; sty:raw "0" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part ":is([data-sem-c=text-field] input, [data-sem-c=shape-field] :is(input:not([type=checkbox]), textarea)):not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "padding" ; sty:raw "4px 6px" ] .

# Check boxes: a sunken well and a check drawn in the text colour; radios stay round.
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part "[data-sem-c=checkbox] > .sem-row > input:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "var(--sem-surface-sunken)" ] ,
                 [ sty:property "border" ; sty:raw "0" ] ,
                 [ sty:property "box-shadow" ; sty:raw "var(--bv-sunken)" ] ,
                 [ sty:property "--check-size" ; sty:raw "15px" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part "[data-sem-c=checkbox] > .sem-row > input:checked:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "linear-gradient(45deg, transparent 0 38%, var(--sem-text) 38% 64%, transparent 64%) 18% 64% / 38% 38% no-repeat, linear-gradient(-45deg, transparent 0 40%, var(--sem-text) 40% 62%, transparent 62%) 74% 42% / 54% 62% no-repeat, var(--sem-surface-sunken)" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part "[data-sem-c=list-item] > input[type=checkbox]:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "accent-color" ; sty:raw "var(--bv-select-bg)" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part "[data-sem-c=radio-group] .sem-radio:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "transparent" ] ,
                 [ sty:property "border" ; sty:raw "0" ] ,
                 [ sty:property "box-shadow" ; sty:raw "none" ] ,
                 [ sty:property "padding" ; sty:raw "3px 2px" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part "[data-sem-c=radio-group] .sem-radio:has(> input:checked):not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;

    sty:declares [ sty:property "border-inline-end-width" ; sty:raw "1px" ] .
[] a sty:StyleRule ; sty:when sty:Fluent ;
    sty:part "[data-sem-c=desktop] > [data-sem-c=taskbar][data-sem-edge=end]:not(:where([data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]), [data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]) *))" ;
    sty:declares [ sty:property "border-inline-start-width" ; sty:raw "1px" ] .
[] a sty:StyleRule ; sty:when sty:Fluent ;
    sty:part "[data-sem-c=desktop] > [data-sem-c=taskbar]:is([data-sem-edge=start], [data-sem-edge=end]):not(:where([data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]), [data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]) *))" ;
    sty:declares [ sty:property "align-items" ; sty:raw "center" ] ,
                 [ sty:property "justify-content" ; sty:raw "flex-start" ] .
[] a sty:StyleRule ; sty:when sty:Fluent ;
    sty:part "[data-sem-c=desktop] > [data-sem-c=taskbar]:is([data-sem-edge=start], [data-sem-edge=end]) > .sem-task:not(:where([data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]), [data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]) *))" ;
    sty:declares [ sty:property "flex" ; sty:raw "none" ] .

# Bars on Mica, edged with a hairline; cards and specimens are layers with a stroke.
[] a sty:StyleRule ; sty:when sty:Fluent ;
    sty:part "[data-sem-c=app-bar]:not(:where([data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]), [data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "color-mix(in srgb, var(--fl-mica) 82%, transparent)" ] ,
                 [ sty:property "backdrop-filter" ; sty:raw "var(--fl-blur)" ] ,
                 [ sty:property "border-bottom" ; sty:raw "1px solid var(--fl-stroke)" ] .
[] a sty:StyleRule ; sty:when sty:Fluent ;
    sty:part "[data-sem-c=status-bar]:not(:where([data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]), [data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "color-mix(in srgb, var(--fl-mica) 86%, transparent)" ] ,
                 [ sty:property "backdrop-filter" ; sty:raw "var(--fl-blur)" ] ,
                 [ sty:property "border-top" ; sty:raw "1px solid var(--fl-stroke)" ] .
[] a sty:StyleRule ; sty:when sty:Fluent ;
    sty:part ":is([data-sem-c=card], [data-sem-c=specimen], [data-sem-c=stat], [data-sem-c=accordion], [data-sem-c=table]):not(:where([data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]), [data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]) *))" ;
    sty:declares [ sty:property "border-color" ; sty:raw "var(--fl-stroke)" ] .
[] a sty:StyleRule ; sty:when sty:Fluent ;
    sty:part "[data-sem-c=specimen] > .sem-stage:not(:where([data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]), [data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "var(--fl-mica)" ] ,
                 [ sty:property "border" ; sty:raw "1px solid var(--fl-stroke)" ] ,
                 [ sty:property "border-radius" ; sty:raw "8px" ] .
[] a sty:StyleRule ; sty:when sty:Fluent ;
    sty:part "[data-sem-c=card] > header h2:not(:where([data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]), [data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]) *))" ;
    sty:declares [ sty:property "font-size" ; sty:raw "14px" ] ,
                 [ sty:property "font-weight" ; sty:raw "600" ] .
[] a sty:StyleRule ; sty:when sty:Fluent ;
    sty:part "[data-sem-c=table] thead th:not(:where([data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]), [data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "var(--sem-surface)" ] ,
                 [ sty:property "color" ; sty:raw "var(--sem-muted)" ] ,
                 [ sty:property "font-weight" ; sty:raw "600" ] ,
                 [ sty:property "border-bottom" ; sty:raw "1px solid var(--fl-stroke)" ] .
[] a sty:StyleRule ; sty:when sty:Fluent ;
    sty:part "[data-sem-c=table] tbody tr:nth-child(even):not(:where([data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]), [data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "transparent" ] .
[] a sty:StyleRule ; sty:when sty:Fluent ;
    sty:part "[data-sem-c=table] tbody tr:hover:not(:where([data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]), [data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "var(--fl-subtle-hover)" ] .
[] a sty:StyleRule ; sty:when sty:Fluent ;
    sty:part "[data-sem-c=table] tbody :is(th, td):not(:where([data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]), [data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]) *))" ;
    sty:declares [ sty:property "border-bottom-color" ; sty:raw "var(--fl-stroke)" ] .
[] a sty:StyleRule ; sty:when sty:Fluent ;
    sty:part "[data-sem-c=metrics] .sem-metric:not(:where([data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]), [data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]) *))" ;
    sty:declares [ sty:property "border-color" ; sty:raw "var(--fl-stroke)" ] ,
                 [ sty:property "border-radius" ; sty:raw "4px" ] .
[] a sty:StyleRule ; sty:when sty:Fluent ;
    sty:part ":is([data-sem-c=kbd] > kbd, [data-sem-c=kbd]:not(:has(kbd))):not(:where([data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]), [data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "var(--fl-fill)" ] ,
                 [ sty:property "border-color" ; sty:raw "var(--fl-stroke)" ] ,
                 [ sty:property "border-bottom-color" ; sty:raw "var(--fl-stroke-bottom)" ] ,
                 [ sty:property "border-radius" ; sty:raw "4px" ] .

# Progress is a thin rail with a three-pixel accent bar.
[] a sty:StyleRule ; sty:when sty:Fluent ;
    sty:part "[data-sem-c=progress] .sem-track:not(:where([data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]), [data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]) *))" ;
    sty:declares [ sty:property "height" ; sty:raw "3px" ] ,
                 [ sty:property "background" ; sty:raw "linear-gradient(var(--fl-stroke-strong), var(--fl-stroke-strong)) center / 100% 1px no-repeat" ] ,
                 [ sty:property "border-radius" ; sty:raw "2px" ] ,
                 [ sty:property "overflow" ; sty:raw "visible" ] .
[] a sty:StyleRule ; sty:when sty:Fluent ;
    sty:part "[data-sem-c=progress] .sem-fill:not(:where([data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]), [data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "var(--tone-solid, var(--sem-accent-9))" ] ,
                 [ sty:property "border-radius" ; sty:raw "2px" ] .

# --- composing with the viewer's settings ----------------------------------------------------
# High contrast restated on the same element as each structural theme (themes.ttl restates it for
# a themed subtree under a high-contrast ancestor), and the structural focus outline made heavier.

[] a sty:StyleRule ; sty:when sty:HighContrast , sty:Cupertino ;
    sty:declares _:hcText , _:hcMuted , _:hcFaint , _:hcBorder , _:hcBorderStrong , _:hcAccent , _:hcAccentStrong , _:hcRing , _:hcFocus , _:hcFocusOffset .
[] a sty:StyleRule ; sty:when sty:HighContrast , sty:Tracker ;
    sty:declares _:hcText , _:hcMuted , _:hcFaint , _:hcBorder , _:hcBorderStrong , _:hcAccent , _:hcAccentStrong , _:hcRing , _:hcFocus , _:hcFocusOffset .
[] a sty:StyleRule ; sty:when sty:HighContrast , sty:Classic ;
    sty:declares _:hcText , _:hcMuted , _:hcFaint , _:hcBorder , _:hcBorderStrong , _:hcAccent , _:hcAccentStrong , _:hcRing , _:hcFocus , _:hcFocusOffset .
[] a sty:StyleRule ; sty:when sty:HighContrast , sty:Doodle ;
    sty:declares _:hcText , _:hcMuted , _:hcFaint , _:hcBorder , _:hcBorderStrong , _:hcAccent , _:hcAccentStrong , _:hcRing , _:hcFocus , _:hcFocusOffset .
[] a sty:StyleRule ; sty:when sty:HighContrast , sty:Fluent ;
    sty:declares _:hcText , _:hcMuted , _:hcFaint , _:hcBorder , _:hcBorderStrong , _:hcAccent , _:hcAccentStrong , _:hcRing , _:hcFocus , _:hcFocusOffset .
[] a sty:StyleRule ; sty:when sty:HighContrast ; sty:part ":is([data-sem-theme=cupertino], [data-sem-theme=tracker], [data-sem-theme=classic], [data-sem-theme=doodle], [data-sem-theme=fluent])" ;
    sty:declares _:hcFocus , _:hcFocusOffset .

_:hcText sty:property "--sem-text" ; sty:raw "color-mix(in oklab, var(--sem-gray-12) 35%, light-dark(#000000, #ffffff))" .
_:hcMuted sty:property "--sem-muted" ; sty:raw "var(--sem-gray-12)" .
_:hcFaint sty:property "--sem-faint" ; sty:raw "var(--sem-gray-11)" .
_:hcBorder sty:property "--sem-border" ; sty:raw "var(--sem-gray-10)" .
_:hcBorderStrong sty:property "--sem-border-strong" ; sty:raw "var(--sem-gray-12)" .
_:hcAccent sty:property "--sem-accent" ; sty:raw "color-mix(in oklab, var(--sem-accent-11) 60%, var(--sem-accent-12))" .
_:hcAccentStrong sty:property "--sem-accent-strong" ; sty:raw "var(--sem-accent-12)" .
_:hcRing sty:property "--sem-ring" ; sty:raw "0 0 0 3px light-dark(#000000, #ffffff)" .
_:hcFocus sty:property "--s-focus" ; sty:raw "3px solid light-dark(#000000, #ffffff)" .
_:hcFocusOffset sty:property "--s-focus-offset" ; sty:raw "2px" .

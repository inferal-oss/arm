                 [ sty:property "border-color" ; sty:raw "transparent" ] .
[] a sty:StyleRule ; sty:appliesTo c:Button ; sty:intent sty:Primary ;
    sty:state ":where([data-sem-theme=fluent] *):not(:where([data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]), [data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]) *)):active" ;

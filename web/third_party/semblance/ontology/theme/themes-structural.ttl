# Menus drop a raised panel; the item under the pointer takes the selection colours.
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part "[data-sem-c=menu] > .sem-menu-popup:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;

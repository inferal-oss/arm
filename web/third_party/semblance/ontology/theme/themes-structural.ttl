# Dialogs, lightboxes and drawers are windows: a raised frame and a caption bar for a title, with a square
# close button; no dimming behind them.
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part ":is([data-sem-c=dialog], [data-sem-c=lightbox], [data-sem-c=drawer], [data-sem-c=popover]) > .sem-panel:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "var(--bv-face)" ] ,
                 [ sty:property "border" ; sty:raw "0" ] ,
                 [ sty:property "box-shadow" ; sty:raw "var(--bv-raised), var(--sem-shadow-4)" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part ":is([data-sem-c=dialog], [data-sem-c=lightbox], [data-sem-c=drawer]) > .sem-panel:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "padding" ; sty:raw "3px 3px 12px" ] ,
                 [ sty:property "gap" ; sty:raw "10px" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part ":is([data-sem-c=dialog], [data-sem-c=lightbox], [data-sem-c=drawer]) > .sem-panel > :not(.sem-head):not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "margin-inline" ; sty:raw "10px" ] .
[] a sty:StyleRule ; sty:when sty:Classic ;
    sty:part ":is([data-sem-c=dialog], [data-sem-c=lightbox], [data-sem-c=drawer]) > .sem-panel > .sem-head:not(:where([data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]), [data-sem-theme=classic] [data-sem-theme]:not([data-sem-theme=classic]) *))" ;
    sty:declares [ sty:property "background" ; sty:raw "var(--bv-title)" ] ,

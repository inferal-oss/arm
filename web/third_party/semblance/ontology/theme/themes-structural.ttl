        [ sty:property "--sem-accent-12" ; sty:raw "light-dark(#00244d, #d6eaff)" ] ,
        # status
        [ sty:property "--sem-info-3" ; sty:raw "light-dark(#e6f1ff, #0e2238)" ] ,
        [ sty:property "--sem-info-4" ; sty:raw "light-dark(#d6e8ff, #132c4a)" ] ,
        [ sty:property "--sem-info-6" ; sty:raw "light-dark(#a9cdfb, #1d4a7a)" ] ,
        [ sty:property "--sem-info-9" ; sty:raw "light-dark(#0064d2, #0a6fdc)" ] ,

# --- Fluent ----------------------------------------------------------------------------------
[] a sty:StyleRule ; sty:when sty:Fluent ;
    sty:declares [ sty:property "--fl-mica" ; sty:raw "light-dark(#eef0f5, #202227)" ] ,
                 [ sty:property "--fl-acrylic" ; sty:raw "color-mix(in srgb, var(--sem-surface-overlay) 80%, transparent)" ] ,
                 [ sty:property "--fl-blur" ; sty:raw "blur(30px) saturate(1.3)" ] ,
                 [ sty:property "--fl-stroke" ; sty:raw "light-dark(rgb(0 0 0 / 0.0578), rgb(255 255 255 / 0.0698))" ] ,
                 [ sty:property "--fl-stroke-flyout" ; sty:raw "light-dark(rgb(0 0 0 / 0.0578), rgb(0 0 0 / 0.2))" ] ,
                 [ sty:property "--fl-stroke-bottom" ; sty:raw "light-dark(rgb(0 0 0 / 0.1622), rgb(255 255 255 / 0.093))" ] ,
                 [ sty:property "--fl-stroke-strong" ; sty:raw "light-dark(rgb(0 0 0 / 0.4458), rgb(255 255 255 / 0.5442))" ] ,
                 [ sty:property "--fl-fill" ; sty:raw "light-dark(rgb(255 255 255 / 0.7), rgb(255 255 255 / 0.0605))" ] ,
                 [ sty:property "--fl-fill-hover" ; sty:raw "light-dark(rgb(249 249 249 / 0.5), rgb(255 255 255 / 0.0837))" ] ,
                 [ sty:property "--fl-fill-pressed" ; sty:raw "light-dark(rgb(249 249 249 / 0.3), rgb(255 255 255 / 0.0326))" ] ,
                 [ sty:property "--fl-fill-input" ; sty:raw "light-dark(#ffffff, #1f1f1f)" ] ,
                 [ sty:property "--fl-fill-off" ; sty:raw "light-dark(rgb(0 0 0 / 0.0241), rgb(0 0 0 / 0.1))" ] ,
                 [ sty:property "--fl-subtle-hover" ; sty:raw "light-dark(rgb(0 0 0 / 0.0373), rgb(255 255 255 / 0.0605))" ] ,
                 [ sty:property "--fl-subtle-pressed" ; sty:raw "light-dark(rgb(0 0 0 / 0.0241), rgb(255 255 255 / 0.0419))" ] ,
                 [ sty:property "--fl-accent-edge" ; sty:raw "inset 0 1px 0 rgb(255 255 255 / 0.08), inset 0 -1px 0 light-dark(rgb(0 0 0 / 0.4), rgb(0 0 0 / 0.14))" ] ,
                 [ sty:property "--fl-knob" ; sty:raw "light-dark(rgb(0 0 0 / 0.62), rgb(255 255 255 / 0.79))" ] ,
                 [ sty:property "--s-focus" ; sty:raw "2px solid light-dark(#000000, #ffffff)" ] ,
                 [ sty:property "--s-focus-offset" ; sty:raw "1px" ] ,
                 [ sty:property "scrollbar-color" ; sty:raw "light-dark(rgb(0 0 0 / 0.45), rgb(255 255 255 / 0.45)) transparent" ] .
[] a sty:StyleRule ; sty:when sty:Fluent ;
    sty:part "*:not(:where([data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]), [data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]) *))" ;
    sty:declares [ sty:property "scrollbar-width" ; sty:raw "thin" ] .

# Focus is a two-pixel rectangle (black by day, white by night) a pixel outside the control;
# text fields show focus with their accent underline instead.
[] a sty:StyleRule ; sty:when sty:Fluent ;
    sty:part ":is(button, summary, a[href], select, input[type=checkbox], input[type=radio], input[type=range], [tabindex]:not([tabindex=\"-1\"])):focus-visible:not(:where([data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]), [data-sem-theme=fluent] [data-sem-theme]:not([data-sem-theme=fluent]) *))" ;
    sty:declares [ sty:property "outline" ; sty:raw "var(--s-focus)" ] ,
                 [ sty:property "outline-offset" ; sty:raw "var(--s-focus-offset)" ] .

# Buttons: a translucent fill, a hairline stroke whose bottom edge is a shade darker, four-pixel

# --- what an option does, and its keys (an option with c:help or key:hint: a command palette's) -----
# Wherever an option is shown: its help after its label, muted; its keys at the end, in the glyphs of
# the viewer's platform (data-sem-platform=apple on the root: ⌘ ⌥ ⇧; else Ctrl, Alt, Shift).
[] a sty:StyleRule ; sty:appliesTo c:TypeaheadOption ; sty:part "> .sem-ta-help" ;
    sty:declares [ sty:property "color" ; sty:token tok:muted ] ,
                 [ sty:property "font-size" ; sty:token tok:font-size-small ] .
[] a sty:StyleRule ; sty:appliesTo c:TypeaheadOption ; sty:part "> .sem-ta-keys" ;
    sty:declares [ sty:property "display" ; sty:raw "inline-flex" ] ,
                 [ sty:property "flex" ; sty:raw "none" ] ,
                 [ sty:property "gap" ; sty:raw "4px" ] ,
                 [ sty:property "margin-inline-start" ; sty:raw "auto" ] .
[] a sty:StyleRule ; sty:appliesTo c:TypeaheadOption ; sty:part "> .sem-ta-keys > kbd" ;
    sty:declares [ sty:property "padding" ; sty:raw "2px 6px" ] ,
                 [ sty:property "border-radius" ; sty:raw "5px" ] ,
                 [ sty:property "border" ; sty:raw "1px solid var(--sem-border-strong)" ] ,
                 [ sty:property "border-bottom-width" ; sty:raw "2px" ] ,
                 [ sty:property "background" ; sty:token tok:surface ] ,
                 [ sty:property "color" ; sty:token tok:muted ] ,
                 [ sty:property "font" ; sty:raw "600 11px/1.2 var(--sem-font-mono)" ] ,
                 [ sty:property "direction" ; sty:raw "ltr" ] ,
                 [ sty:property "unicode-bidi" ; sty:raw "isolate" ] .
[] a sty:StyleRule ; sty:appliesTo c:TypeaheadOption ; sty:part "> .sem-ta-keys > .sem-apple" ;
    sty:declares [ sty:property "display" ; sty:raw "none" ] .
[] a sty:StyleRule ; sty:part ":root[data-sem-platform=apple] [data-sem-c=typeahead-option] > .sem-ta-keys > .sem-apple" ;
    sty:declares [ sty:property "display" ; sty:raw "inline" ] .
[] a sty:StyleRule ; sty:part ":root[data-sem-platform=apple] [data-sem-c=typeahead-option] > .sem-ta-keys > .sem-other" ;
    sty:declares [ sty:property "display" ; sty:raw "none" ] .

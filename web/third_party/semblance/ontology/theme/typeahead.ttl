                 [ sty:property "box-shadow" ; sty:raw "4px 6px 0 light-dark(rgb(27 35 64 / 0.18), rgb(0 0 0 / 0.4))" ] ,
                 [ sty:property "rotate" ; sty:raw "0.8deg" ] ,
                 [ sty:property "color" ; sty:raw "light-dark(#1b2340, #fff8d6)" ] .

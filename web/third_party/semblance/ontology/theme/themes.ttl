sty:Sunset a sty:Theme ; sem:slug "sunset" ; sem:order 5 ; sem:symbol "◓" ;
    rdfs:label "Sunset"@en , "Захід сонця"@uk , "Abendrot"@de , "غروب"@ar ;
    rdfs:comment "Playful and warm: a tangerine-to-magenta gradient, rounded type, pill-shaped controls, soft coloured shadows and springy motion. Plum by night."@en ;
    sty:declares
        # neutral ramp

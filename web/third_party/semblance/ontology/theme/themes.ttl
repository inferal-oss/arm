        [ sty:property "--sem-warning-11" ; sty:raw "light-dark(#915c04, #f7bf7d)" ] ,
        [ sty:property "--sem-danger-3" ; sty:raw "light-dark(#ffecea, #331212)" ] ,
        [ sty:property "--sem-danger-4" ; sty:raw "light-dark(#fee2df, #401516)" ] ,
        [ sty:property "--sem-danger-6" ; sty:raw "light-dark(#fecbc6, #5d1f20)" ] ,

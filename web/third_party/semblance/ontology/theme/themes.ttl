        [ sty:property "--sem-accent-6" ; sty:raw "light-dark(#feccc3, #57261b)" ] ,
        [ sty:property "--sem-accent-7" ; sty:raw "light-dark(#febbaf, #6d3325)" ] ,
        [ sty:property "--sem-accent-8" ; sty:raw "light-dark(#fe9c8c, #8e4332)" ] ,
        [ sty:property "--sem-accent-9" ; sty:raw "light-dark(#ad2f22, #b85039)" ] ,
        [ sty:property "--sem-accent-10" ; sty:raw "light-dark(#9c1c10, #cc624a)" ] ,
        [ sty:property "--sem-accent-11" ; sty:raw "light-dark(#a23e31, #feb6a5)" ] ,
        [ sty:property "--sem-accent-12" ; sty:raw "light-dark(#47110b, #ffe9e4)" ] ,
        # status
        [ sty:property "--sem-info-3" ; sty:raw "light-dark(#e7f3fe, #072033)" ] ,
        [ sty:property "--sem-info-4" ; sty:raw "light-dark(#d9edfe, #052740)" ] ,
        [ sty:property "--sem-info-6" ; sty:raw "light-dark(#badefe, #043a5d)" ] ,
        [ sty:property "--sem-info-9" ; sty:raw "light-dark(#0074b8, #037ac0)" ] ,
        [ sty:property "--sem-info-10" ; sty:raw "light-dark(#0465a0, #168dd9)" ] ,
        [ sty:property "--sem-info-11" ; sty:raw "light-dark(#0268a5, #9cd1ff)" ] ,
        [ sty:property "--sem-success-3" ; sty:raw "light-dark(#e4f7eb, #0c2417)" ] ,
        [ sty:property "--sem-success-4" ; sty:raw "light-dark(#d5f2e0, #0d2c1c)" ] ,
        [ sty:property "--sem-success-6" ; sty:raw "light-dark(#b6e7c9, #12412a)" ] ,

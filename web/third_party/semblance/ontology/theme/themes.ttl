# --- rules that read the theme-level tokens --------------------------------------------
# Generic, not per theme: inside any themed subtree, these parts read the tokens the
# nearest theme set (custom properties inherit, so the closest theme wins). Prefixing
# [data-sem-theme] makes them more specific than the components' own rules.

[] a sty:StyleRule ;
    sty:part "[data-sem-theme] :is(h1, h2, h3, h4, h5, h6, [data-sem-c=\"heading\"], [data-sem-text-style=\"display\"], [data-sem-text-style=\"title\"])" ;
    sty:declares [ sty:property "font-family" ; sty:token tok:font-display ] ,
                 [ sty:property "text-transform" ; sty:token tok:display-case ] .

[] a sty:StyleRule ; sty:part "[data-sem-theme] [data-sem-c=\"heading\"]" ;
    sty:declares [ sty:property "font-weight" ; sty:token tok:display-weight ] ,
                 [ sty:property "letter-spacing" ; sty:token tok:display-tracking ] .

[] a sty:StyleRule ; sty:part "[data-sem-theme] [data-sem-c=\"heading\"]::after" ;
    sty:declares [ sty:property "background" ; sty:token tok:mark ] ,
                 [ sty:property "width" ; sty:token tok:mark-width ] ,
                 [ sty:property "height" ; sty:token tok:mark-height ] ,
                 [ sty:property "border-radius" ; sty:token tok:mark-radius ] .

[] a sty:StyleRule ; sty:part "[data-sem-theme] [data-sem-c=\"progress\"] .sem-fill" ;
    sty:declares [ sty:property "background" ; sty:token tok:gradient ] ,
                 [ sty:property "border-radius" ; sty:token tok:radius-sm ] .
[] a sty:StyleRule ; sty:part "[data-sem-theme] [data-sem-c=\"progress\"] .sem-track" ;
    sty:declares [ sty:property "border-radius" ; sty:token tok:radius-sm ] .

[] a sty:StyleRule ; sty:part "[data-sem-theme] [data-sem-c=\"graph-mark\"]" ;
    sty:declares [ sty:property "filter" ; sty:raw "drop-shadow(0 4px 10px color-mix(in oklab, var(--sem-gradient-from) 35%, transparent))" ] .
[] a sty:StyleRule ; sty:part "[data-sem-theme] [data-sem-c=\"graph-mark\"] .sem-stop-a" ;
    sty:declares [ sty:property "stop-color" ; sty:token tok:gradient-from ] .
[] a sty:StyleRule ; sty:part "[data-sem-theme] [data-sem-c=\"graph-mark\"] .sem-stop-b" ;
    sty:declares [ sty:property "stop-color" ; sty:token tok:gradient-to ] .

# Text on solids: an accent-9 fill may be light (Terminal's phosphor), so what sits on it
# is the theme's accent-contrast, not white; likewise on the status solids.
[] a sty:StyleRule ; sty:part "[data-sem-theme] [data-sem-tone=\"accent\"]" ;
    sty:declares [ sty:property "--tone-on-solid" ; sty:token tok:accent-contrast ] .
[] a sty:StyleRule ;
    sty:part "[data-sem-theme] :is([data-sem-tone=\"info\"], [data-sem-tone=\"success\"], [data-sem-tone=\"danger\"], [data-sem-intent=\"danger\"])" ;
    sty:declares [ sty:property "--tone-on-solid" ; sty:token tok:on-status ] .
[] a sty:StyleRule ;
    sty:part "[data-sem-theme] :is([data-sem-c=\"pagination\"] button[aria-current=page], [data-sem-c=\"stepper\"] [data-state=complete] .sem-marker)" ;
    sty:declares [ sty:property "color" ; sty:token tok:accent-contrast ] .
[] a sty:StyleRule ; sty:part "[data-sem-theme] [data-sem-c=\"checkbox\"] > .sem-row > input:checked" ;
    sty:declares [ sty:property "background-image" ; sty:token tok:check ] .

# A themed c:Surface is a window onto the theme: it shows the theme's backdrop.
[] a sty:StyleRule ; sty:part "[data-sem-theme][data-sem-c=\"surface\"]" ;
    sty:declares [ sty:property "background" ; sty:token tok:backdrop ] .

# --- composing with the viewer's settings ------------------------------------------------
# High contrast is set on the shell, a theme may be set below it and re-declare the role
# colors there. So high contrast is restated for every themed element under it (and on
# the same element as a theme), in terms of the theme's own ramps: its hue survives,
# its text and borders get stronger. The declarations are shared by the rules.

[] a sty:StyleRule ; sty:when sty:HighContrast ; sty:part "[data-sem-theme]" ;
    sty:declares _:hcText , _:hcMuted , _:hcFaint , _:hcBorder , _:hcBorderStrong , _:hcAccent , _:hcAccentStrong , _:hcRing .
[] a sty:StyleRule ; sty:when sty:HighContrast , sty:Semblance ;
    sty:declares _:hcText , _:hcMuted , _:hcFaint , _:hcBorder , _:hcBorderStrong , _:hcAccent , _:hcAccentStrong , _:hcRing .
[] a sty:StyleRule ; sty:when sty:HighContrast , sty:Paper ;
    sty:declares _:hcText , _:hcMuted , _:hcFaint , _:hcBorder , _:hcBorderStrong , _:hcAccent , _:hcAccentStrong , _:hcRing .
[] a sty:StyleRule ; sty:when sty:HighContrast , sty:Terminal ;
    sty:declares _:hcText , _:hcMuted , _:hcFaint , _:hcBorder , _:hcBorderStrong , _:hcAccent , _:hcAccentStrong , _:hcRing .
[] a sty:StyleRule ; sty:when sty:HighContrast , sty:Blueprint ;
    sty:declares _:hcText , _:hcMuted , _:hcFaint , _:hcBorder , _:hcBorderStrong , _:hcAccent , _:hcAccentStrong , _:hcRing .
[] a sty:StyleRule ; sty:when sty:HighContrast , sty:Sunset ;
    sty:declares _:hcText , _:hcMuted , _:hcFaint , _:hcBorder , _:hcBorderStrong , _:hcAccent , _:hcAccentStrong , _:hcRing .

_:hcText sty:property "--sem-text" ; sty:raw "color-mix(in oklab, var(--sem-gray-12) 35%, light-dark(#000000, #ffffff))" .
_:hcMuted sty:property "--sem-muted" ; sty:raw "var(--sem-gray-12)" .
_:hcFaint sty:property "--sem-faint" ; sty:raw "var(--sem-gray-11)" .
_:hcBorder sty:property "--sem-border" ; sty:raw "var(--sem-gray-10)" .
_:hcBorderStrong sty:property "--sem-border-strong" ; sty:raw "var(--sem-gray-12)" .
_:hcAccent sty:property "--sem-accent" ; sty:raw "color-mix(in oklab, var(--sem-accent-11) 60%, var(--sem-accent-12))" .
_:hcAccentStrong sty:property "--sem-accent-strong" ; sty:raw "var(--sem-accent-12)" .
_:hcRing sty:property "--sem-ring" ; sty:raw "0 0 0 3px light-dark(#000000, #ffffff)" .

# Reduced motion drops the springs and easings a theme brings (durations are inherited).
[] a sty:StyleRule ; sty:when mot:Reduced ; sty:part "[data-sem-theme]" ;
    sty:declares [ sty:property "--sem-ease" ; sty:raw "linear" ] ,
                 [ sty:property "--sem-spring" ; sty:raw "linear" ] ,
                 [ sty:property "--sem-motion" ; sty:raw "var(--sem-duration) linear" ] .

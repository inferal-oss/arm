        [ sty:property "--sem-gray-10" ; sty:raw "light-dark(#807d75, #847f7b)" ] ,
        [ sty:property "--sem-gray-11" ; sty:raw "light-dark(#66635c, #c4bcb4)" ] ,
        [ sty:property "--sem-gray-12" ; sty:raw "light-dark(#211f19, #f5ede5)" ] ,
        # accent ramp
        [ sty:property "--sem-accent-1" ; sty:raw "light-dark(#fefcfc, #160b09)" ] ,
        [ sty:property "--sem-accent-2" ; sty:raw "light-dark(#fef6f5, #20100c)" ] ,
        [ sty:property "--sem-accent-3" ; sty:raw "light-dark(#feedea, #30160f)" ] ,

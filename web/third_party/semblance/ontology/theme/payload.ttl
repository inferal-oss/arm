@prefix sem: <https://semblance.dev/ns/core#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix tok: <https://semblance.dev/ns/token#> .

# Default theme for the payload components: JSON tree, hex view and body viewer. JSON values are
# colored with the code tokens the rule sources use (strings, names, keywords), so every theme that
# re-values those recolors them.

# --- JSON tree ---
[] a sty:StyleRule ; sty:appliesTo c:JsonTree ;
    sty:declares [ sty:property "flex" ; sty:raw "1 1 100%" ] ,
                 [ sty:property "min-width" ; sty:raw "0" ] ,
                 [ sty:property "max-height" ; sty:raw "28rem" ] ,
                 [ sty:property "overflow" ; sty:raw "auto" ] ,
                 [ sty:property "margin" ; sty:raw "0" ] ,
                 [ sty:property "padding" ; sty:token tok:space-2 ] ,
                 [ sty:property "list-style" ; sty:raw "none" ] ,
                 [ sty:property "background" ; sty:token tok:code-bg ] ,
                 [ sty:property "border" ; sty:raw "1px solid var(--sem-border)" ] ,
                 [ sty:property "border-radius" ; sty:token tok:radius-md ] ,
                 [ sty:property "font-family" ; sty:token tok:font-mono ] ,
                 [ sty:property "font-size" ; sty:token tok:text-xs ] ,
                 [ sty:property "color" ; sty:token tok:text ] .
[] a sty:StyleRule ; sty:appliesTo c:JsonTree ; sty:part "[role=group]" ;
    sty:declares [ sty:property "margin" ; sty:raw "0" ] ,
                 [ sty:property "padding" ; sty:raw "0" ] ,
                 [ sty:property "list-style" ; sty:raw "none" ] .
[] a sty:StyleRule ; sty:appliesTo c:JsonTree ; sty:part ".sem-row" ;
    sty:declares [ sty:property "display" ; sty:raw "flex" ] ,
                 [ sty:property "align-items" ; sty:raw "center" ] ,
                 [ sty:property "gap" ; sty:raw "2px" ] ,
                 [ sty:property "min-height" ; sty:raw "22px" ] ,
                 [ sty:property "padding-inline" ; sty:raw "calc(var(--tree-level, 0) * 16px) var(--sem-space-2)" ] ,
                 [ sty:property "border-radius" ; sty:token tok:radius-sm ] .
[] a sty:StyleRule ; sty:appliesTo c:JsonTree ; sty:part ".sem-row:hover" ;
    sty:declares [ sty:property "background" ; sty:token tok:gray-3 ] .
[] a sty:StyleRule ; sty:appliesTo c:JsonTree ; sty:part ".sem-twisty" ;
    sty:declares [ sty:property "display" ; sty:raw "grid" ] ,
                 [ sty:property "place-items" ; sty:raw "center" ] ,
                 [ sty:property "flex" ; sty:raw "none" ] ,
                 [ sty:property "width" ; sty:raw "18px" ] ,
                 [ sty:property "height" ; sty:raw "18px" ] ,
                 [ sty:property "padding" ; sty:raw "0" ] ,
                 [ sty:property "border" ; sty:raw "0" ] ,
                 [ sty:property "border-radius" ; sty:token tok:radius-sm ] ,
                 [ sty:property "background" ; sty:raw "transparent" ] ,
                 [ sty:property "color" ; sty:token tok:muted ] ,
                 [ sty:property "font-size" ; sty:raw "10px" ] ,
                 [ sty:property "cursor" ; sty:raw "pointer" ] .
[] a sty:StyleRule ; sty:appliesTo c:JsonTree ; sty:part ".sem-twisty:hover" ;
    sty:declares [ sty:property "background" ; sty:token tok:gray-5 ] ,
                 [ sty:property "color" ; sty:token tok:text ] .
[] a sty:StyleRule ; sty:appliesTo c:JsonTree ; sty:part ".sem-twisty > span" ;
    sty:declares [ sty:property "transition" ; sty:raw "transform var(--sem-duration-fast) var(--sem-ease)" ] .
[] a sty:StyleRule ; sty:appliesTo c:JsonTree ; sty:part "[aria-expanded=true] > .sem-row > .sem-twisty > span" ;
    sty:declares [ sty:property "transform" ; sty:raw "rotate(90deg)" ] .
[] a sty:StyleRule ; sty:appliesTo c:JsonTree ; sty:part ".sem-leaf" ;
    sty:declares [ sty:property "flex" ; sty:raw "none" ] ,
                 [ sty:property "width" ; sty:raw "18px" ] .
[] a sty:StyleRule ; sty:appliesTo c:JsonTree ; sty:part ".sem-label" ;
    sty:declares [ sty:property "padding" ; sty:raw "1px 4px" ] ,
                 [ sty:property "border-radius" ; sty:token tok:radius-sm ] ,
                 [ sty:property "color" ; sty:token tok:code-name ] ,
                 [ sty:property "white-space" ; sty:raw "nowrap" ] .
[] a sty:StyleRule ; sty:appliesTo c:JsonTree ; sty:part ".sem-label::after" ;
    sty:declares [ sty:property "content" ; sty:raw "\":\"" ] ,
                 [ sty:property "color" ; sty:token tok:muted ] .
[] a sty:StyleRule ; sty:appliesTo c:JsonTree ; sty:part "[aria-expanded] > .sem-row > .sem-label" ;
    sty:declares [ sty:property "cursor" ; sty:raw "pointer" ] .
[] a sty:StyleRule ; sty:appliesTo c:JsonTree ; sty:part ":is(.sem-twisty, .sem-label):focus-visible" ;
    sty:declares [ sty:property "outline" ; sty:raw "none" ] ,
                 [ sty:property "box-shadow" ; sty:token tok:ring ] .
[] a sty:StyleRule ; sty:appliesTo c:JsonTree ; sty:part ".sem-value" ;
    sty:declares [ sty:property "min-width" ; sty:raw "0" ] ,
                 [ sty:property "overflow" ; sty:raw "hidden" ] ,
                 [ sty:property "text-overflow" ; sty:raw "ellipsis" ] ,
                 [ sty:property "white-space" ; sty:raw "nowrap" ] .
[] a sty:StyleRule ; sty:appliesTo c:JsonTree ; sty:part ".sem-summary" ;
    sty:declares [ sty:property "color" ; sty:token tok:muted ] .
[] a sty:StyleRule ; sty:appliesTo c:JsonTree ; sty:part ".sem-json-string" ;
    sty:declares [ sty:property "color" ; sty:token tok:code-string ] .
[] a sty:StyleRule ; sty:appliesTo c:JsonTree ; sty:part ".sem-json-number" ;
    sty:declares [ sty:property "color" ; sty:token tok:code-iri ] .
[] a sty:StyleRule ; sty:appliesTo c:JsonTree ; sty:part ".sem-json-boolean" ;
    sty:declares [ sty:property "color" ; sty:token tok:code-keyword ] .
[] a sty:StyleRule ; sty:appliesTo c:JsonTree ; sty:part ".sem-json-null" ;
    sty:declares [ sty:property "color" ; sty:token tok:code-comment ] ,
                 [ sty:property "font-style" ; sty:raw "italic" ] .
# Invalid JSON: a note over the text.
[] a sty:StyleRule ; sty:appliesTo c:JsonTree ; sty:part ".sem-note" ;
    sty:declares [ sty:property "margin" ; sty:raw "0 0 var(--sem-space-2)" ] ,
                 [ sty:property "color" ; sty:token tok:warning-11 ] ,
                 [ sty:property "font-family" ; sty:token tok:font ] .
[] a sty:StyleRule ; sty:appliesTo c:JsonTree ; sty:part ".sem-raw" ;
    sty:declares [ sty:property "margin" ; sty:raw "0" ] ,
                 [ sty:property "white-space" ; sty:raw "pre-wrap" ] ,
                 [ sty:property "overflow-wrap" ; sty:raw "anywhere" ] .

# --- hex view ---
[] a sty:StyleRule ; sty:appliesTo c:HexView ;
    sty:declares [ sty:property "flex" ; sty:raw "1 1 100%" ] ,
                 [ sty:property "min-width" ; sty:raw "0" ] ,
                 [ sty:property "max-height" ; sty:raw "24rem" ] ,
                 [ sty:property "overflow" ; sty:raw "auto" ] ,
                 [ sty:property "padding" ; sty:tokens ( tok:space-2 tok:space-3 ) ] ,
                 [ sty:property "background" ; sty:token tok:code-bg ] ,
                 [ sty:property "border" ; sty:raw "1px solid var(--sem-border)" ] ,
                 [ sty:property "border-radius" ; sty:token tok:radius-md ] ,
                 [ sty:property "font-family" ; sty:token tok:font-mono ] ,
                 [ sty:property "font-size" ; sty:token tok:text-xs ] ,
                 [ sty:property "color" ; sty:token tok:text ] .
[] a sty:StyleRule ; sty:appliesTo c:HexView ; sty:state ":focus-visible" ;
    sty:declares [ sty:property "outline" ; sty:raw "none" ] ,
                 [ sty:property "box-shadow" ; sty:token tok:ring ] .
[] a sty:StyleRule ; sty:appliesTo c:HexView ; sty:part "table" ;
    sty:declares [ sty:property "border-collapse" ; sty:raw "collapse" ] ,
                 [ sty:property "font-variant-numeric" ; sty:raw "tabular-nums" ] .
[] a sty:StyleRule ; sty:appliesTo c:HexView ; sty:part ":is(th, td)" ;
    sty:declares [ sty:property "padding" ; sty:raw "1px 0" ] ,
                 [ sty:property "padding-inline-end" ; sty:token tok:space-4 ] ,
                 [ sty:property "text-align" ; sty:raw "start" ] ,
                 [ sty:property "font-weight" ; sty:raw "400" ] ,
                 [ sty:property "white-space" ; sty:raw "pre" ] .
[] a sty:StyleRule ; sty:appliesTo c:HexView ; sty:part "thead th" ;
    sty:declares [ sty:property "color" ; sty:token tok:muted ] ,
                 [ sty:property "font-family" ; sty:token tok:font ] ,
                 [ sty:property "font-weight" ; sty:raw "600" ] ,
                 [ sty:property "border-bottom" ; sty:raw "1px solid var(--sem-border)" ] .
[] a sty:StyleRule ; sty:appliesTo c:HexView ; sty:part ".sem-offset" ;
    sty:declares [ sty:property "color" ; sty:token tok:faint ] .
[] a sty:StyleRule ; sty:appliesTo c:HexView ; sty:part ".sem-ascii" ;
    sty:declares [ sty:property "color" ; sty:token tok:code-string ] .
[] a sty:StyleRule ; sty:appliesTo c:HexView ; sty:part ".sem-more" ;
    sty:declares [ sty:property "margin" ; sty:raw "var(--sem-space-2) 0 0" ] ,
                 [ sty:property "color" ; sty:token tok:muted ] ,
                 [ sty:property "font-family" ; sty:token tok:font ] .

# --- body viewer ---
[] a sty:StyleRule ; sty:appliesTo c:BodyViewer ;
    sty:declares [ sty:property "display" ; sty:raw "flex" ] ,
                 [ sty:property "flex-direction" ; sty:raw "column" ] ,
                 [ sty:property "gap" ; sty:token tok:space-2 ] ,
                 [ sty:property "flex" ; sty:raw "1 1 100%" ] ,
                 [ sty:property "min-width" ; sty:raw "0" ] ,
                 [ sty:property "font-family" ; sty:token tok:font ] .
[] a sty:StyleRule ; sty:appliesTo c:BodyViewer ; sty:part ".sem-head" ;
    sty:declares [ sty:property "display" ; sty:raw "flex" ] ,
                 [ sty:property "align-items" ; sty:raw "center" ] ,
                 [ sty:property "flex-wrap" ; sty:raw "wrap" ] ,
                 [ sty:property "gap" ; sty:token tok:space-3 ] .
[] a sty:StyleRule ; sty:appliesTo c:BodyViewer ; sty:part ".sem-views" ;
    sty:declares [ sty:property "display" ; sty:raw "inline-flex" ] ,
                 [ sty:property "gap" ; sty:raw "2px" ] ,
                 [ sty:property "padding" ; sty:raw "2px" ] ,
                 [ sty:property "border-radius" ; sty:token tok:radius-full ] ,
                 [ sty:property "background" ; sty:token tok:surface ] ,
                 [ sty:property "border" ; sty:raw "1px solid var(--sem-border)" ] .
[] a sty:StyleRule ; sty:appliesTo c:BodyViewer ; sty:part ".sem-views > button" ;
    sty:declares [ sty:property "border" ; sty:raw "0" ] ,
                 [ sty:property "background" ; sty:raw "transparent" ] ,
                 [ sty:property "padding" ; sty:raw "3px 10px" ] ,
                 [ sty:property "border-radius" ; sty:token tok:radius-full ] ,
                 [ sty:property "font" ; sty:raw "inherit" ] ,
                 [ sty:property "font-size" ; sty:token tok:text-xs ] ,
                 [ sty:property "font-weight" ; sty:raw "600" ] ,
                 [ sty:property "color" ; sty:token tok:muted ] ,
                 [ sty:property "cursor" ; sty:raw "pointer" ] ,
                 [ sty:property "transition" ; sty:raw "color var(--sem-duration-fast) var(--sem-ease), background var(--sem-duration-fast) var(--sem-ease)" ] .
[] a sty:StyleRule ; sty:appliesTo c:BodyViewer ; sty:part ".sem-views > button:hover" ;
    sty:declares [ sty:property "color" ; sty:token tok:text ] .
[] a sty:StyleRule ; sty:appliesTo c:BodyViewer ; sty:part ".sem-views > button:focus-visible" ;
    sty:declares [ sty:property "outline" ; sty:raw "none" ] ,
                 [ sty:property "box-shadow" ; sty:token tok:ring ] .
[] a sty:StyleRule ; sty:appliesTo c:BodyViewer ; sty:part ".sem-views > button[aria-pressed=true]" ;
    sty:declares [ sty:property "color" ; sty:token tok:accent-strong ] ,
                 [ sty:property "background" ; sty:token tok:accent-soft ] .
[] a sty:StyleRule ; sty:appliesTo c:BodyViewer ; sty:part ".sem-meta" ;
    sty:declares [ sty:property "color" ; sty:token tok:muted ] ,
                 [ sty:property "font-family" ; sty:token tok:font-mono ] ,
                 [ sty:property "font-size" ; sty:token tok:text-xs ] .
[] a sty:StyleRule ; sty:appliesTo c:BodyViewer ; sty:part "> pre" ;
    sty:declares [ sty:property "max-height" ; sty:raw "24rem" ] ,
                 [ sty:property "overflow" ; sty:raw "auto" ] ,
                 [ sty:property "white-space" ; sty:raw "pre-wrap" ] ,
                 [ sty:property "overflow-wrap" ; sty:raw "anywhere" ] .
[] a sty:StyleRule ; sty:appliesTo c:BodyViewer ; sty:state ".sem-empty" ;
    sty:declares [ sty:property "margin" ; sty:raw "0" ] ,
                 [ sty:property "color" ; sty:token tok:muted ] .

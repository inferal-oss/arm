@prefix ui: <https://getarm.org/ui#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix sem: <https://semblance.dev/ns/core#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix pos: <https://semblance.dev/ns/position#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix nav: <https://semblance.dev/ns/navigation#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Stock Semblance components, layout vocabulary and Terminal theme. No app CSS.
ui:state ui:page ui:Home .
ui:page a owl:ObjectProperty ; rdfs:range ui:Page .
ui:Page a owl:Class .
ui:Home a ui:Page ; rdfs:label "Overview" ; sem:slug "overview" ; sem:order 1 ; ui:heading ui:title .
ui:Start a ui:Page ; rdfs:label "Get started" ; sem:slug "start" ; sem:order 2 ; ui:heading ui:startTitle .
ui:Capabilities a ui:Page ; rdfs:label "Capabilities" ; sem:slug "capabilities" ; sem:order 3 ; ui:heading ui:capabilitiesTitle .
ui:Docs a ui:Page ; rdfs:label "Docs & source" ; sem:slug "docs" ; sem:order 4 ; ui:heading ui:docsTitle .
ui:location a nav:Location ; nav:root ui:shell ; nav:dimensions ( ui:atPage ) .
ui:atPage a nav:Dimension ; nav:subject ui:state ; nav:property ui:page ;
    nav:carriedBy nav:Fragment ; nav:history nav:MakesHistory .

ui:shell a c:Stack ; sty:theme sty:Terminal ; sty:colorScheme sty:Dark ;
    pos:direction pos:Column ; pos:gap tok:space-7 ; pos:inset tok:space-5 ;
    c:children ( ui:bar ui:pages ui:divider ui:footer ) .
ui:bar a c:AppBar ; c:label "arm" ; c:to ui:home ;
    c:actions ( ui:nav ) ; c:moreActions ( ui:scheme ) ; c:moreLabel "Display" .
ui:nav a c:Segmented ; c:label "Site navigation" ; c:controls ui:state ; c:property ui:page ; c:compactAs c:Picker .
ui:scheme a c:ThemeSwitcher ; c:label "Color scheme" ; c:controls ui:shell ; c:property sty:colorScheme .
ui:pages a c:Switch ; c:controls ui:state ; c:property ui:page ;
    c:cases ( ui:homeCase ui:startCase ui:capabilitiesCase ui:docsCase ) .
ui:homeCase c:when ui:Home ; c:content ui:home .
ui:startCase c:when ui:Start ; c:content ui:start .
ui:capabilitiesCase c:when ui:Capabilities ; c:content ui:capabilities .
ui:docsCase c:when ui:Docs ; c:content ui:docs .
ui:divider a c:Divider .
ui:footer a c:Stack ; pos:measure pos:PageMeasure ; pos:direction pos:Column ; pos:gap tok:space-3 ;
    c:children ( ui:footerLine ui:footerLinks ) .
ui:footerLine a c:Text ; sty:textStyle sty:Caption ; c:label "ARM · Agent Resource Manager · Open source under MIT OR Apache-2.0" .
ui:footerLinks a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-5 ; c:children ( ui:footerSource ui:footerSemblance ui:footerLicenses ) .
ui:footerSource a c:Link ; c:label "Source" ; c:href "https://github.com/inferal-oss/arm" .
ui:footerSemblance a c:Link ; c:label "Built with Semblance" ; c:href "https://semblance.dev" .
ui:footerLicenses a c:Link ; c:label "Website dependency licenses" ; c:href "./THIRD-PARTY-NOTICES.txt" .

# Overview.
ui:home a c:Stack ; pos:measure pos:PageMeasure ; pos:direction pos:Column ; pos:gap tok:space-7 ;
    c:children ( ui:hero ui:exampleCard ui:principles ui:interfaces ui:homeNext ) .
ui:hero a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:eyebrow ui:title ui:summary ui:platforms ui:heroLinks ) .
ui:eyebrow a c:Text ; sty:textStyle sty:Overline ; c:label "Agent Resource Manager" .
ui:title a c:Heading ; c:level 1 ; sty:textStyle sty:Display ; c:label "Give every agent room to work." .
ui:summary a c:Text ; sty:textStyle sty:Subtitle ; pos:measure pos:ReadingMeasure ;
    c:label "Coordinate finite CPU, memory, storage and ports through time-limited leases. Every request has an owner, a reason and an expiry. Every operator can see what is using the machine." .
ui:platforms a c:Text ; sty:textStyle sty:Mono ; c:label "macOS + Linux  /  Go + SQLite  /  Local CLI, web & terminal" .
ui:heroLinks a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-5 ; c:children ( ui:startLink ui:sourceLink ) .
ui:startLink a c:Link ; c:label "Build and run ARM →" ; c:to ui:start .
ui:sourceLink a c:Link ; c:label "Explore the source" ; c:href "https://github.com/inferal-oss/arm" .
ui:exampleCard a c:Card ; c:label "A bounded job, with a reason" ; c:badge "CLI example" ; c:content ui:exampleBody .
ui:exampleBody a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ; c:children ( ui:exampleCode ui:exampleNote ) .
ui:exampleCode a c:Code ; c:block true ; c:language "sh" ; c:label """bin/arm run --cpu 2 --memory 1GiB --ttl 2m --wait \\
  --reason "Run the project tests" -- go test ./...""" .
ui:exampleNote a c:Text ; c:label "Ask for capacity, queue when it is busy, and supervise a command within its lease. Resource budgets are cooperative reservations; they are not kernel CPU or memory quotas." .
ui:principles a c:Stack ; pos:layout pos:Grid ; pos:gap tok:space-4 ;
    c:children ( ui:ownerCard ui:admissionCard ui:recoveryCard ) .
ui:ownerCard a c:Card ; c:label "Know who and why" ; c:content ui:ownerText .
ui:ownerText a c:Text ; c:label "Keep durable ownership, project and agent attribution, reasons, deadlines and lifecycle events in a local SQLite ledger." .
ui:admissionCard a c:Card ; c:label "Share capacity deliberately" ; c:content ui:admissionText .
ui:admissionText a c:Text ; c:label "Request CPU, memory, disk, held listener ports or counted custom pools. Inspect availability and queue blockers before starting more work." .
ui:recoveryCard a c:Card ; c:label "Keep uncertainty visible" ; c:content ui:recoveryText .
ui:recoveryText a c:Text ; c:label "Expiry does not prove that a process stopped or disk space returned. Unresolved cleanup remains visible and charged until settled." .
ui:interfaces a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:interfacesTitle ui:interfacesText ui:interfacesCode ) .
ui:interfacesTitle a c:Heading ; c:level 2 ; c:label "One ledger. Several ways to use it." .
ui:interfacesText a c:Text ; c:label "Use the CLI from agent workflows, open the embedded web dashboard, or inspect the same activity in an interactive terminal dashboard. Review leases, resource consumers, host observations, messages and activity." .
ui:interfacesCode a c:Code ; c:block true ; c:language "sh" ; c:label """bin/arm resources
bin/arm dashboard
bin/arm dashboard terminal""" .
ui:homeNext a c:Link ; c:label "See what is supported today →" ; c:to ui:capabilities .

# Getting started: every snippet follows the checked-in ARM README; no install script or imaginary releases.
ui:start a c:Stack ; pos:measure pos:PageMeasure ; pos:direction pos:Column ; pos:gap tok:space-6 ;
    c:children ( ui:startTitle ui:startIntro ui:buildCard ui:runCard ui:inspectCard ui:leaseCard ui:installCard ui:startReadme ) .
ui:startTitle a c:Heading ; c:level 1 ; c:label "Start with a local lease." .
ui:startIntro a c:Text ; c:label "Build from source with Go 1.27.3 or newer and make. ARM uses CGo-free SQLite. The executable embeds its dashboard assets; Node.js is only needed to develop this public website." .
ui:buildCard a c:Card ; c:label "01 / Build" ; c:content ui:buildBody .
ui:buildBody a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ; c:children ( ui:buildCode ui:buildNote ) .
ui:buildCode a c:Code ; c:block true ; c:language "sh" ; c:label """git clone https://github.com/inferal-oss/arm.git
cd arm
make build
bin/arm version""" .
ui:buildNote a c:Text ; c:label "This produces the native bin/arm executable. Build your own binary from the repository; this site does not offer prebuilt release downloads." .
ui:runCard a c:Card ; c:label "02 / Start a backend and run a job" ; c:content ui:runBody .
ui:runBody a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ; c:children ( ui:runNote ui:runCode ) .
ui:runNote a c:Text ; c:label "Choose an isolated state directory and capacity appropriate to your machine. The explicit CPU, memory and disk values below are example budgets. Keep ARM options before --; everything after it belongs to the child command." .
ui:runCode a c:Code ; c:block true ; c:language "sh" ; c:label """bin/arm --home /tmp/arm-demo daemon start \\
  --cpu 4 --memory 8GiB --disk 20GiB
bin/arm --home /tmp/arm-demo run --cpu 1 --ttl 2m --wait \\
  --reason "Check the toolchain" -- go version""" .
ui:inspectCard a c:Card ; c:label "03 / Observe and stop" ; c:content ui:inspectBody .
ui:inspectBody a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ; c:children ( ui:inspectCode ui:inspectNote ) .
ui:inspectCode a c:Code ; c:block true ; c:language "sh" ; c:label """bin/arm --home /tmp/arm-demo resources --json
bin/arm --home /tmp/arm-demo dashboard
bin/arm --home /tmp/arm-demo events --follow
# Stop following events with Ctrl+C, then:
bin/arm --home /tmp/arm-demo daemon stop""" .
ui:inspectNote a c:Text ; c:label "The dashboard opens a short-lived, one-use local link. Host observations and cooperative reservations are separate measurements. A stop or cleanup request can remain unresolved; inspect the reported outcome." .
ui:leaseCard a c:Card ; c:label "Work with an explicit lease" ; c:content ui:leaseBody .
ui:leaseBody a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ; c:children ( ui:leaseCode ui:leaseNote ) .
ui:leaseCode a c:Code ; c:block true ; c:language "sh" ; c:label """bin/arm acquire --cpu 2 --memory 1GiB --ttl 10m \\
  --reason "Analysis workers" --json
# Use the lease ID returned by acquire:
bin/arm inspect LEASE_ID
bin/arm renew LEASE_ID --ttl 20m
bin/arm release LEASE_ID""" .
ui:leaseNote a c:Text ; c:label "Run these commands against your usual backend, or add the same --home directory to each. Use arm help COMMAND for the complete command contract." .
ui:installCard a c:Card ; c:label "Optional / Install for your user" ; c:content ui:installBody .
ui:installBody a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ; c:children ( ui:installCode ui:installNote ) .
ui:installCode a c:Code ; c:block true ; c:language "sh" ; c:label """make install BUNDLE_JOBS=1
# Ensure ~/.local/bin is on PATH, then:
arm version
arm install --dry-run""" .
ui:installNote a c:Text ; c:label "make install builds a carrier with macOS/Linux payloads for arm64 and amd64, then installs it under ~/.local/bin. It does not start the backend or change agent configuration. The separate arm install command reviews agent integration changes." .
ui:startReadme a c:Link ; c:label "Continue with the full README →" ; c:href "https://github.com/inferal-oss/arm#readme" .

# Capability claims intentionally distinguish current local support from ongoing delivery.
ui:capabilities a c:Stack ; pos:measure pos:PageMeasure ; pos:direction pos:Column ; pos:gap tok:space-6 ;
    c:children ( ui:capabilitiesTitle ui:capabilitiesIntro ui:capabilityCards ui:boundariesTitle ui:boundaries ui:limitsLink ) .
ui:capabilitiesTitle a c:Heading ; c:level 1 ; c:label "Useful today. Explicit about its limits." .
ui:capabilitiesIntro a c:Text ; c:label "ARM is under active development. The local backend and interfaces provide a working foundation; the full specification extends beyond the delivered implementation." .
ui:capabilityCards a c:Stack ; pos:layout pos:Grid ; pos:gap tok:space-4 ;
    c:children ( ui:leasesFeature ui:portsFeature ui:storageFeature ui:poolsFeature ui:visibilityFeature ui:meshFeature ) .
ui:leasesFeature a c:Card ; c:label "Leases & admission" ; c:content ui:leasesFeatureText .
ui:leasesFeatureText a c:Text ; c:label "Durable requests, queued admission, TTLs, renewals, release, supervised commands and owner attribution. Unknown or stale resource estimates can block new grants." .
ui:portsFeature a c:Card ; c:label "Listener ports" ; c:content ui:portsFeatureText .
ui:portsFeatureText a c:Text ; c:label "Reserve exact TCP/UDP bindings, kernel-selected ports or a bounded range. Socket-aware commands receive inherited descriptors; cooperative mode supports other programs with an explicit bind-race limitation." .
ui:storageFeature a c:Card ; c:label "Managed storage" ; c:content ui:storageFeatureText .
ui:storageFeatureText a c:Text ; c:label "Create time-bounded owned storage, inspect logical allocation, export selected artifacts and request reviewed cleanup. Shared APFS capacity and uncertain reclamation remain conservatively accounted." .
ui:poolsFeature a c:Card ; c:label "Custom pools" ; c:content ui:poolsFeatureText .
ui:poolsFeatureText a c:Text ; c:label "Count browser slots, deployment permits or other cooperative resources. Adjust capacity with reasons, operation keys and revision checks. Local parent/child subpools partition capacity." .
ui:visibilityFeature a c:Card ; c:label "Observation & messages" ; c:content ui:visibilityFeatureText .
ui:visibilityFeatureText a c:Text ; c:label "Inspect native host CPU, memory, filesystem, disk I/O and network observations. View leases and activity, exchange agent/operator messages, and review supported controls in web and terminal interfaces." .
ui:meshFeature a c:Card ; c:label "Opt-in direct peers" ; c:content ui:meshFeatureText .
ui:meshFeatureText a c:Text ; c:label "Explicitly authorized direct peers support host selection, scoped remote leases/execution and host-directed messages. Nearby daemon reports are advisory; they do not reserve capacity across authorities." .
ui:boundariesTitle a c:Heading ; c:level 2 ; c:label "Before you rely on it" .
ui:boundaries a c:Accordion ; c:items ( ui:cooperativeLimit ui:roadmapLimit ui:filesystemLimit ui:securityLimit ) .
ui:cooperativeLimit a c:AccordionItem ; c:label "Cooperative budgets are not OS isolation" ; c:expanded true ; c:content ui:cooperativeLimitText .
ui:cooperativeLimitText a c:Text ; c:label "CPU and memory claims coordinate cooperating agents; they are not kernel quotas or allocation guarantees. Native samples have platform-specific scope and can miss escaped or exited processes. Automatic pause and GPU telemetry are not delivered." .
ui:roadmapLimit a c:AccordionItem ; c:label "The roadmap includes unfinished runtime workflows" ; c:content ui:roadmapLimitText .
ui:roadmapLimitText a c:Text ; c:label "Public bidirectional sync, generally usable TCP forwarding, complete Kubernetes enrollment, VNC access, managed provider lifecycles, full interface parity and distributed scheduling have remaining delivery gates. Internal components or passing scoped tests do not establish a supported public workflow." .
ui:filesystemLimit a c:AccordionItem ; c:label "A removed directory does not prove reclaimed capacity" ; c:content ui:filesystemLimitText .
ui:filesystemLimitText a c:Text ; c:label "Clones, snapshots, shared extents, open files and APFS containers complicate physical allocation. Logical size and reported allocation are separate from exclusive or reclaimable bytes. Inspection never grants deletion authority." .
ui:securityLimit a c:AccordionItem ; c:label "Remote authority is explicit and scoped" ; c:content ui:securityLimitText .
ui:securityLimitText a c:Text ; c:label "A supplied agent name is attribution, not authorization. The opt-in direct-peer mesh uses explicit grants and independent authorities. It does not provide distributed capacity consensus or isolation from arbitrary programs with the same user privileges." .
ui:limitsLink a c:Link ; c:label "Read the current implementation boundaries →" ; c:href "https://github.com/inferal-oss/arm/blob/main/docs/IMPLEMENTATION.md" .

# Source, documentation and honest download guidance.
ui:docs a c:Stack ; pos:measure pos:PageMeasure ; pos:direction pos:Column ; pos:gap tok:space-6 ;
    c:children ( ui:docsTitle ui:docsIntro ui:docsLinks ui:contributeTitle ui:contributeText ui:contributeLinks ui:siteTitle ui:siteText ) .
ui:docsTitle a c:Heading ; c:level 1 ; c:label "Read the contracts. Follow the work." .
ui:docsIntro a c:Text ; c:label "The repository is the source of truth for setup, supported behavior, validation evidence and remaining delivery gates. Build from source with the getting-started guide; no binary releases are advertised here." .
ui:docsLinks a c:Stack ; pos:layout pos:Grid ; pos:gap tok:space-4 ; c:children ( ui:readmeCard ui:implementationCard ui:specCard ui:validationCard ui:planCard ui:securityCard ) .
ui:readmeCard a c:Card ; c:label "Setup & usage" ; c:note "Build, run, leases, storage, ports and integrations" ; c:content ui:readmeLink .
ui:readmeLink a c:Link ; c:label "README" ; c:href "https://github.com/inferal-oss/arm#readme" .
ui:implementationCard a c:Card ; c:label "Implemented behavior" ; c:note "Current support and material limitations" ; c:content ui:implementationLink .
ui:implementationLink a c:Link ; c:label "Implementation notes" ; c:href "https://github.com/inferal-oss/arm/blob/main/docs/IMPLEMENTATION.md" .
ui:specCard a c:Card ; c:label "Project direction" ; c:note "Full requirements, including planned capabilities" ; c:content ui:specLink .
ui:specLink a c:Link ; c:label "Specification" ; c:href "https://github.com/inferal-oss/arm/blob/main/SPEC.md" .
ui:validationCard a c:Card ; c:label "Evidence" ; c:note "Checks, real workflow evidence and unresolved gates" ; c:content ui:validationLink .
ui:validationLink a c:Link ; c:label "Validation record" ; c:href "https://github.com/inferal-oss/arm/blob/main/docs/VALIDATION.md" .
ui:planCard a c:Card ; c:label "Delivery" ; c:note "Ownership, integration status and next gates" ; c:content ui:planLink .
ui:planLink a c:Link ; c:label "Delivery plan" ; c:href "https://github.com/inferal-oss/arm/blob/main/docs/PLAN.md" .
ui:securityCard a c:Card ; c:label "Mesh authority" ; c:note "Authentication and directional authorization model" ; c:content ui:securityLink .
ui:securityLink a c:Link ; c:label "Mesh security" ; c:href "https://github.com/inferal-oss/arm/blob/main/docs/MESH-SECURITY.md" .
ui:contributeTitle a c:Heading ; c:level 2 ; c:label "Build in the open." .
ui:contributeText a c:Text ; c:label "ARM is licensed under MIT OR Apache-2.0. Read AGENTS.md for the review and validation workflow before contributing. Bug reports should include a reproducible example and avoid credentials, private paths or account data." .
ui:contributeLinks a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-5 ; c:children ( ui:issuesLink ui:contributingLink ui:mitLink ui:apacheLink ) .
ui:issuesLink a c:Link ; c:label "Issues" ; c:href "https://github.com/inferal-oss/arm/issues" .
ui:contributingLink a c:Link ; c:label "Contributor workflow" ; c:href "https://github.com/inferal-oss/arm/blob/main/AGENTS.md" .
ui:mitLink a c:Link ; c:label "MIT license" ; c:href "https://github.com/inferal-oss/arm/blob/main/LICENSE-MIT" .
ui:apacheLink a c:Link ; c:label "Apache-2.0 license" ; c:href "https://github.com/inferal-oss/arm/blob/main/LICENSE-APACHE" .
ui:siteTitle a c:Heading ; c:level 2 ; c:label "A graph, all the way to the interface." .
ui:siteText a c:Text ; c:label "This public website runs on the actual Semblance graph/component/event framework with its stock Terminal theme. Navigation, content and interactive disclosures are RDF graph data projected through Semblance rules. The website source lives beside ARM on the same main branch." .
